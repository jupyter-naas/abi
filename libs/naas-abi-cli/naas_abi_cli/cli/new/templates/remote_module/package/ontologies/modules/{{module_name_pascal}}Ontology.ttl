@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:    <http://purl.org/dc/terms/> .
@prefix dc11:  <http://purl.org/dc/elements/1.1/> .
@prefix abi:   <http://ontology.naas.ai/abi/> .
@prefix {{module_name_snake}}: <http://ontology.naas.ai/{{module_name_snake}}/> .

# Sent to the engine's schema graph once this module is READY, as
# module/{{module_id}}/modules/{{module_name_pascal}}Ontology.ttl. Use absolute IRIs only.
{{module_name_snake}}:{{module_name_pascal}}Ontology a owl:Ontology ;
  # One owl:imports statement per IRI. The engine does not resolve them: the
  # ABI ontologies are already in its schema graph.
  owl:imports <http://ontology.naas.ai/abi/Ontology> ;
  owl:imports <http://ontology.naas.ai/abi/PersonOntology> ;

  dc:title "{{module_name_pascal}} Ontology"@en ;
  dc:description "Ontology for the {{module_name}} domain. Replace this with a description of what the module reasons over, and of any distinction the model deliberately keeps apart."@en ;
  dc:license <https://creativecommons.org/licenses/by/4.0/> ;
  rdfs:comment "Ontology for the {{module_name}} domain."@en ;
  dc11:contributor "TODO: your name" ;
  dc11:date "2026-01-01"^^xsd:date .

#################################################################
#    Object Properties
#################################################################

# Pair every relation with its inverse, and subclass an abi: relation so the
# BFO semantics carry over: abi:isCarrierOf / abi:genericallyDependsOn,
# abi:bearerOf / abi:inheresIn, abi:concretizes / abi:isConcretizedBy,
# abi:hasParticipant / abi:participatesIn, abi:occursIn, abi:locatedIn.
{{module_name_snake}}:hasRecord a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:isCarrierOf ;
    owl:inverseOf {{module_name_snake}}:isRecordOf ;
    rdfs:label "has record"@en ;
    skos:definition "Relates a person to a record that generically depends on them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range {{module_name_snake}}:{{module_name_pascal}}Record .

{{module_name_snake}}:isRecordOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf {{module_name_snake}}:hasRecord ;
    rdfs:label "is record of"@en ;
    skos:definition "Relates a record to the person on which it generically depends."@en ;
    rdfs:domain {{module_name_snake}}:{{module_name_pascal}}Record ;
    rdfs:range abi:Person .

#################################################################
#    Data Properties
#################################################################

{{module_name_snake}}:record_id a owl:DatatypeProperty ;
    rdfs:label "record id"@en ;
    skos:definition "Identifier of the record in the source system."@en ;
    rdfs:domain {{module_name_snake}}:{{module_name_pascal}}Record ;
    rdfs:range xsd:string .

#################################################################
#    Classes
#################################################################

# Subclass an abi: class so every class traces to a BFO root:
#   WHAT         abi:Process                        WHEN         abi:TemporalRegion
#   WHO          abi:MaterialEntity / abi:Person    WHERE        abi:Site
#   HOW WE KNOW  abi:GenericallyDependentContinuant HOW IT IS    abi:Quality
#   WHY          abi:Role / abi:Disposition

# HOW WE KNOW: a record about something
{{module_name_snake}}:{{module_name_pascal}}Record a owl:Class ;
    rdfs:subClassOf abi:GenericallyDependentContinuant ,
      [ a owl:Restriction ; owl:onProperty {{module_name_snake}}:isRecordOf ; owl:someValuesFrom abi:Person ] ;
    rdfs:label "{{module_name_pascal}} Record"@en ;
    skos:definition "An information content entity that documents something about a person in the {{module_name}} domain."@en ;
    skos:example "TODO: a concrete instance a reader would recognise."@en .
