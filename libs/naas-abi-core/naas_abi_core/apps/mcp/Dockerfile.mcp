# Production Dockerfile for ABI MCP Server
FROM python:3.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies first, from requirements.txt: the versions of
# naas-abi-core's uv.lock, with their hashes.
COPY libs/naas-abi-core/naas_abi_core/apps/mcp/requirements.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

# Copy application code. Settings come from the environment at run time: no
# .env file goes into the image.
COPY libs/naas-abi-core/naas_abi_core/apps/mcp/mcp_server.py ./
COPY README.md ./

# Set environment for production MCP deployment
ENV MCP_TRANSPORT=sse
ENV ABI_API_BASE=http://api:9879

USER nobody

# Expose the MCP HTTP server port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

# Run the MCP server
CMD ["python", "mcp_server.py"]
