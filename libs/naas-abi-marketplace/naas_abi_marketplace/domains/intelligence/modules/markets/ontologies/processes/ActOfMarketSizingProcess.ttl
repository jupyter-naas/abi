@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:    <http://purl.org/dc/terms/> .
@prefix dc11:  <http://purl.org/dc/elements/1.1/> .
@prefix bfo:   <http://purl.obolibrary.org/obo/> .
@prefix cco:   <https://www.commoncoreontologies.org/> .
@prefix abi:   <http://ontology.naas.ai/abi/> .

abi:ActOfMarketSizingProcess a owl:Ontology ;
  # Slice: the act and what it alone uses. Shared vocabulary (MarketAnalystRole,
  # MarketSource, hasMarketSource) lives in the module MarketsOntology, which
  # this slice does NOT import (the module consolidates this file).
  #
  # Seven-bucket mapping for one sizing of a market:
  #   WHO          Organization (the analyst or publisher)
  #   WHEN         TemporalRegion - the reference period the size is stated for
  #   WHERE        GeospatialRegion - the geography sized (Global, Europe...)
  #   WHAT         ActOfMarketSizing (the process itself)
  #   WHY          MarketAnalystRole (SDC)
  #   HOW IT IS    not stated: a size is measured, so it is a HOW WE KNOW
  #   HOW WE KNOW  MarketSizeMeasurement (value, currency, year, growth), MarketSource
  #
  # Two sources rarely agree on a market's size, because they draw its
  # boundary differently. Each sizing is its own act with its own source;
  # nothing averages or overwrites them.
  owl:imports <http://ontology.naas.ai/abi/Ontology> ;
  owl:imports <http://ontology.naas.ai/abi/OrganizationOntology> ;
  owl:imports <http://ontology.naas.ai/abi/MarketOntology> ;
  owl:imports <http://ontology.naas.ai/abi/GeospatialRegionOntology> ;
  owl:imports <https://www.commoncoreontologies.org/EventOntology> ;
  owl:imports <https://www.commoncoreontologies.org/InformationEntityOntology> ;
  rdfs:seeAlso <http://ontology.naas.ai/abi/MarketsOntology> ;
  abi:pythonPackage "naas_abi_marketplace.domains.intelligence.modules.markets" ;
  abi:ontologyResource "ontologies/processes/ActOfMarketSizingProcess.ttl" ;
  abi:pythonResource "ontologies/processes/ActOfMarketSizingProcess.py" ;
  dc:title "Act of Market Sizing Process Ontology"@en ;
  dc:description "Process slice for the act of market sizing: a CCO Planned Act in which an analyst measures a market's value in a geography for a reference period, and its growth, documented by a market source."@en ;
  dc:license <https://creativecommons.org/licenses/by/4.0/> ;
  rdfs:comment "Process slice for Act of Market Sizing. Reuses the shared markets vocabulary."@en ;
  dc11:contributor "Florent Ravenel" ;
  dc11:date "2026-10-06"^^xsd:date .

#################################################################
#    Classes - WHAT
#################################################################

abi:ActOfMarketSizing a owl:Class ;
  rdfs:subClassOf cco:ont00000228 , # Planned Act
    [ a owl:Restriction ; owl:onProperty abi:hasParticipant ; owl:someValuesFrom abi:Organization ] ,
    [ a owl:Restriction ; owl:onProperty abi:occursIn ; owl:someValuesFrom abi:GeospatialRegion ] ,
    [ a owl:Restriction ; owl:onProperty abi:occupiesTemporalRegion ; owl:someValuesFrom abi:TemporalRegion ] ,
    [ a owl:Restriction ; owl:onProperty abi:realizes ; owl:someValuesFrom abi:MarketAnalystRole ] ,
    [ a owl:Restriction ; owl:onProperty abi:hasMarketSizeMeasurement ; owl:someValuesFrom abi:MarketSizeMeasurement ] ,
    [ a owl:Restriction ; owl:onProperty abi:hasMarketSource ; owl:someValuesFrom abi:MarketSource ] ;
  rdfs:label "Act of Market Sizing"@en ;
  skos:definition "A Planned Act in which an analyst measures the value of the sales made in a market, in a geography, over a reference period, and how fast it grows."@en ;
  skos:example "Gartner forecasting worldwide public cloud end-user spending for 2025."@en .

#################################################################
#    Classes - HOW WE KNOW
#################################################################

abi:MarketSizeMeasurement a owl:Class ;
  rdfs:subClassOf cco:ont00001022 , # Ratio Measurement Information Content Entity
    [ a owl:Restriction ; owl:onProperty abi:measuresMarket ; owl:someValuesFrom abi:Market ] ,
    [ a owl:Restriction ; owl:onProperty abi:isMarketSizeMeasurementOf ; owl:someValuesFrom abi:ActOfMarketSizing ] ;
  rdfs:label "Market Size Measurement"@en ;
  skos:definition "A ratio measurement of the value of the sales made in a market over a reference year, with its compound annual growth rate when the source states one."@en ;
  skos:example "Worldwide public cloud end-user spending: USD 723.4 billion in 2025 (Gartner)."@en .

#################################################################
#    Object properties - process-only
#################################################################

abi:hasMarketSizeMeasurement a owl:ObjectProperty ;
  owl:inverseOf abi:isMarketSizeMeasurementOf ;
  rdfs:label "has market size measurement"@en ;
  skos:definition "Relates an act of market sizing to the measurement it produces."@en ;
  rdfs:domain abi:ActOfMarketSizing ;
  rdfs:range  abi:MarketSizeMeasurement .

abi:isMarketSizeMeasurementOf a owl:ObjectProperty ;
  owl:inverseOf abi:hasMarketSizeMeasurement ;
  rdfs:label "is market size measurement of"@en ;
  skos:definition "Relates a market size measurement to the act of sizing that produced it."@en ;
  rdfs:domain abi:MarketSizeMeasurement ;
  rdfs:range  abi:ActOfMarketSizing .

abi:measuresMarket a owl:ObjectProperty ;
  rdfs:subPropertyOf cco:ont00001808 ; # is about
  owl:inverseOf abi:isMarketMeasuredBy ;
  rdfs:label "measures market"@en ;
  skos:definition "Relates a market size measurement to the market it measures."@en ;
  rdfs:domain abi:MarketSizeMeasurement ;
  rdfs:range  abi:Market .

abi:isMarketMeasuredBy a owl:ObjectProperty ;
  owl:inverseOf abi:measuresMarket ;
  rdfs:label "is market measured by"@en ;
  skos:definition "Relates a market to a measurement of its size."@en ;
  rdfs:domain abi:Market ;
  rdfs:range  abi:MarketSizeMeasurement .

#################################################################
#    Data properties - process-only
#################################################################

abi:market_size_value a owl:DatatypeProperty ;
  rdfs:label "market size value"@en ;
  skos:definition "The value of the market's sales over the reference year, in units of the stated currency (not thousands or billions)."@en ;
  rdfs:domain abi:MarketSizeMeasurement ;
  rdfs:range  xsd:decimal .

abi:market_size_currency a owl:DatatypeProperty ;
  rdfs:label "market size currency"@en ;
  skos:definition "ISO 4217 code of the currency the size is stated in."@en ;
  rdfs:domain abi:MarketSizeMeasurement ;
  rdfs:range  xsd:string .

abi:market_size_year a owl:DatatypeProperty ;
  rdfs:label "market size year"@en ;
  skos:definition "The reference year the size is stated for; a year after the source's publication makes the size a forecast."@en ;
  rdfs:domain abi:MarketSizeMeasurement ;
  rdfs:range  xsd:integer .

abi:market_growth_rate_percent a owl:DatatypeProperty ;
  rdfs:label "market growth rate percent"@en ;
  skos:definition "The compound annual growth rate the source states, in percent."@en ;
  rdfs:domain abi:MarketSizeMeasurement ;
  rdfs:range  xsd:decimal .

abi:market_growth_period a owl:DatatypeProperty ;
  rdfs:label "market growth period"@en ;
  skos:definition "The years the growth rate is stated over, as the source writes them."@en ;
  skos:example "2024-2030"@en ;
  rdfs:domain abi:MarketSizeMeasurement ;
  rdfs:range  xsd:string .
