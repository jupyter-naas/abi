@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:    <http://purl.org/dc/terms/> .
@prefix dc11:  <http://purl.org/dc/elements/1.1/> .
@prefix bfo:   <http://purl.obolibrary.org/obo/> .
@prefix cco:   <https://www.commoncoreontologies.org/> .
@prefix abi:   <http://ontology.naas.ai/abi/> .

abi:ActOfSubsidiaryEstablishmentProcess a owl:Ontology ;
  # Slice: the act and the document that records it. Shared vocabulary
  # (StrategicAlliance, participant and record properties,
  # OrganizationalAgreementRole) lives in the module OrganizationOntology,
  # which this slice does NOT import (the module consolidates this file).
  #
  # Seven-bucket mapping for one subsidiary establishment:
  #   WHO          Organization (the parent establishing the subsidiary)
  #   WHAT         ActOfSubsidiaryEstablishment (the process itself)
  #   WHEN         TemporalRegion, from the agreement's effective date to its end
  #   WHERE        GeospatialRegion (Site - the country, region or city the act occurs in)
  #   WHY          OrganizationalAgreementRole (SDC) - the role each party bears under the agreement
  #   HOW IT IS    not stated: no quality is specific to this act
  #   HOW WE KNOW  SubsidiaryEstablishment (the restructuring record, a descriptive ICE)
  owl:imports <http://ontology.naas.ai/abi/Ontology> ;
  owl:imports <http://ontology.naas.ai/abi/OrganizationOntology> ;
  owl:imports <http://ontology.naas.ai/abi/GeospatialRegionOntology> ;
  owl:imports <https://www.commoncoreontologies.org/EventOntology> ;
  owl:imports <https://www.commoncoreontologies.org/AgentOntology> ;
  owl:imports <https://www.commoncoreontologies.org/InformationEntityOntology> ;
  rdfs:seeAlso <http://ontology.naas.ai/abi/OrganizationsOntology> ;
  abi:pythonPackage "naas_abi_marketplace.domains.intelligence.modules.organizations" ;
  abi:ontologyResource "ontologies/processes/ActOfSubsidiaryEstablishmentProcess.ttl" ;
  abi:pythonResource "ontologies/processes/ActOfSubsidiaryEstablishmentProcess.py" ;
  dc:title "Act of Subsidiary Establishment Process Ontology"@en ;
  dc:description "Process slice for the act of subsidiary establishment: a CCO Planned Act with organizations as participants, occurring in a geospatial region over a temporal region, realizing the agreement roles the parties bear, and documented by its subsidiary establishment record."@en ;
  dc:license <https://creativecommons.org/licenses/by/4.0/> ;
  rdfs:comment "Process slice for Act of Subsidiary Establishment. Reuses the shared organization vocabulary."@en ;
  dc11:contributor "Florent Ravenel", "Alice Dupont", "Emma Petit", "Grace Lambert" ;
  dc11:date "2026-10-05"^^xsd:date .

#################################################################
#    Classes - WHAT
#################################################################

abi:ActOfSubsidiaryEstablishment a owl:Class ;
  rdfs:subClassOf cco:ont00000228 , # Planned Act
    [ a owl:Restriction ; owl:onProperty abi:hasParticipant ; owl:someValuesFrom abi:Organization ] ,
    [ a owl:Restriction ; owl:onProperty abi:occursIn ; owl:someValuesFrom abi:GeospatialRegion ] ,
    [ a owl:Restriction ; owl:onProperty abi:occupiesTemporalRegion ; owl:someValuesFrom abi:TemporalRegion ] ,
    [ a owl:Restriction ; owl:onProperty abi:realizes ; owl:someValuesFrom abi:OrganizationalAgreementRole ] ,
    [ a owl:Restriction ; owl:onProperty abi:hasRestructuringRecord ; owl:someValuesFrom abi:SubsidiaryEstablishment ] ;
  rdfs:label "Act of Subsidiary Establishment"@en ;
  skos:definition "An Act of Association in which an organization creates and establishes a new legal entity, known as a subsidiary, over which it retains significant control and ownership."@en ;
  skos:example "Global Corp establishes a new subsidiary, Tech Innovations Inc., to focus on research and development in the technology sector."@en ;
  abi:is_curated_in_foundry "enterprise_management_foundry" .

#################################################################
#    Classes - HOW WE KNOW
#################################################################

abi:SubsidiaryEstablishment a owl:Class ;
  rdfs:subClassOf cco:ont00000853 ; # Descriptive Information Content Entity
  rdfs:label "Subsidiary Establishment"@en ;
  skos:definition "Details a planned act in which an organization creates a new legal entity over which it retains significant control and ownership."@en ;
  skos:example "The certificate of incorporation and shareholder agreement establishing Tech Innovations Inc. as a subsidiary of Global Corp."@en ;
  rdfs:comment "A subsidiary establishment is documented through incorporation and ownership records, which makes it suitable to be represented as a Descriptive Information Content Entity." ;
  abi:is_curated_in_foundry "enterprise_management_foundry" .

#################################################################
#    Classes - HOW IT IS
#################################################################
