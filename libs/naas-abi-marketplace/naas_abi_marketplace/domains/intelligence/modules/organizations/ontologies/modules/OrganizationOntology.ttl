@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dc11: <http://purl.org/dc/elements/1.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix abi: <http://ontology.naas.ai/abi/> .

<http://ontology.naas.ai/abi/OrganizationsOntology> a owl:Ontology ;
    # One owl:imports statement per IRI, never a comma-separated object list:
    # onto2py's codegen pre-scan only matches an IRI directly after the
    # `owl:imports` keyword, so a continuation IRI is silently dropped and the
    # classes behind it degrade to bare URIRef ranges.
    owl:imports <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl> ;
    owl:imports <http://ontology.naas.ai/abi/Ontology> ;
    owl:imports <http://ontology.naas.ai/abi/OrganizationOntology> ;
    owl:imports <https://www.commoncoreontologies.org/AgentOntology> ;
    owl:imports <https://www.commoncoreontologies.org/InformationEntityOntology> ;
    owl:imports <https://www.commoncoreontologies.org/EventOntology> ;
    # FacilityOntology defines cco:ont00001102 (Commercial Facility), the parent
    # of the headquarters classes below.
    owl:imports <https://www.commoncoreontologies.org/FacilityOntology> ;
    abi:pythonPackage "naas_abi_marketplace.domains.intelligence.modules.organizations" ;
    abi:ontologyResource "ontologies/modules/OrganizationOntology.ttl" ;
    abi:pythonResource "ontologies/modules/OrganizationOntology.py" ;
    dc:title "Organizations Ontology"@en ;
    dc:description "Vocabulary for the organization domain: the CCO organization taxonomy (incorporated, geopolitical, government, commercial, educational, civil), the information content entities that identify an organization (website, ticker, brand, industry), its capabilities and its headquarters facilities. Processes that organizations undergo are process slices in ontologies/processes/, one per act and mapped to the BFO 7 buckets: six alliances (cooperation that preserves independence) and three restructurings (acts that change which organizations exist). They are consolidated into this module; the vocabulary they share (agreement and participant properties, StrategicAlliance, OrganizationalAgreementRole) is declared here."@en ;
    dc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Ontology for organizations."@en ;
    dc11:contributor "Alice Dupont", "Emma Petit", "Grace Lambert" ;
    dc11:date "2026-04-02"^^xsd:date .

#################################################################
#    Classes — WHO (organizations)
#################################################################

# Material Entities: Organization
cco:ont00001180 rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00000300 ;
    rdfs:comment "Members of organizations are either Organizations themselves or individual Persons. Members can bear specific Organization Member Roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the Organization by the organization members."@en ;
    rdfs:label "Organization"@en ;
    skos:definition "A Group of Agents which can be the bearer of roles, has members, and has a set of organization rules."@en ;
    cco:ont00001754 "http://purl.obolibrary.org/obo/OBI_0000245" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00000010 rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00001180 ;
    rdfs:label "Incorporated Organization"@en ;
    skos:altLabel "Corporation"@en ;
    skos:definition "An Organization formed by an Act of Incorporation that consists of an association of individuals, created by law or under authority of law, having a continuous existence independent of the existences of its members and owners, and having powers and liabilities distinct from those of its members and owners."@en ;
    cco:ont00001754 "http://www.dictionary.com/browse/corporation" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00000176 rdf:type owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( cco:ont00001180
                                            [ rdf:type owl:Restriction ;
                                                owl:onProperty bfo:BFO_0000196 ;
                                                owl:someValuesFrom cco:ont00000898
                                            ]
                                            ) ;
                        rdf:type owl:Class
                        ] ;
    rdfs:subClassOf cco:ont00001180 ;
    dc:bibliographicCitation "Lee, David S., and Brad Glosserman. “How Companies Can Navigate Today’s Geopolitical Risks.” Harvard Business Review, 28 Nov. 2022. hbr.org, https://hbr.org/2022/11/how-companies-can-navigate-todays-geopolitical-risks." ,
                                "University, Utah State. Geopolitical Power | Aggies GO. https://chass.usu.edu/international-studies/aggies-go/power. Accessed 6 Apr. 2023." ;
    dc:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime ;
    dc:creator "https://cubrc.org"^^xsd:anyURI ;
    rdfs:label "Geopolitical Organization"@en ;
    skos:definition "An Organization that bears a Geopolitical Power Role."@en ;
    skos:prefLabel "Geopolitical Organization"@en ;
    cco:ont00001754 "https://chass.usu.edu/international-studies/aggies-go/power" ,
                    "https://hbr.org/2022/11/how-companies-can-navigate-todays-geopolitical-risks" ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00000408 rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00001180 ,
                    [ rdf:type owl:Restriction ;
                    owl:onProperty bfo:BFO_0000176 ;
                    owl:someValuesFrom cco:ont00001335
                    ] ;
    rdfs:label "Government Organization"@en ;
    skos:definition "An Organization that is part of a Government and is responsible for the oversight or administration of specific governmental functions."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00000443 rdf:type owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( cco:ont00001180
                                            [ rdf:type owl:Restriction ;
                                                owl:onProperty bfo:BFO_0000196 ;
                                                owl:someValuesFrom cco:ont00000485
                                            ]
                                            ) ;
                        rdf:type owl:Class
                        ] ;
    rdfs:subClassOf cco:ont00001180 ;
    rdfs:label "Commercial Organization"@en ;
    skos:definition "An Organization that is the bearer of a Commercial Role and whose primary objective is to make a profit from the provision of goods or services."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00000564 rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00001180 ;
    rdfs:label "Educational Organization"@en ;
    skos:definition "An Organization whose primary purpose is to provide training or otherwise facilitate learning or the acquisition of knowledge, Skills, values, beliefs, or habits."@en ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00001302 rdf:type owl:Class ;
    owl:equivalentClass [ owl:intersectionOf ( cco:ont00001180
                                            [ rdf:type owl:Restriction ;
                                                owl:onProperty bfo:BFO_0000196 ;
                                                owl:someValuesFrom cco:ont00000173
                                            ]
                                            ) ;
                        rdf:type owl:Class
                        ] ;
    rdfs:subClassOf cco:ont00001180 ;
    rdfs:label "Civil Organization"@en ;
    skos:definition "An Organization that is not commercial or military and is the bearer of a Civilian Role."@en ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

cco:ont00001335 rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00001180 ,
                    [ rdf:type owl:Restriction ;
                    owl:onProperty cco:ont00001859 ;
                    owl:someValuesFrom cco:ont00001203
                    ] ;
    dc:creator "https://cubrc.org"^^xsd:anyURI ;
    rdfs:label "Government"@en ;
    skos:definition "An Organization that is the highest legitimate authority delimited by some Delimiting Domain and that exercises executive, legislative, or judicial authority in that Domain."@en ;
    skos:editorialNote "Highest legitimate authority should not be confused with highest legitimate authority of a particular kind. For example, while the judicial branch of the United States government has the highest judicial authority in a Delimiting Domain, it is not the highest legitimate authority delimited by that domain. The combination of executive, judicial, and legislative branches is higher because it wields more legitimate authority than any branch on its own."@en ,
                    "Importantly, the definition states \"highest legitimate authority delimited by some Delimiting Domain\" and not \"highest legitimate authority in some Delimiting Domain.\" The government of Wales is the highest legitimate authority delimited by some Delimiting Domain but it is not the highest legitimate authority in that domain, which would be the government of the United Kingdom."@en ;
    cco:ont00001754 "https://en.wikipedia.org/w/index.php?title=Government&oldid=1063736308"^^xsd:anyURI ;
    cco:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI .

#################################################################
#    Classes — HOW WE KNOW (identity and description)
#################################################################

abi:Website a owl:Class ;
    rdfs:subClassOf cco:ont00001069 ; # Representational Information Content Entity
    rdfs:label "Website" ;
    skos:definition "A website containing a biography, portfolio of work, and contact information, representing an organization's presence and identity on the web." ;
    skos:example "Microsoft's website, featuring their biography, a gallery of art pieces they've created, and a contact form for inquiries." ;
    abi:is_curated_in_foundry "enterprise_management_foundry", "personal_ai_foundry" .

abi:Ticker a owl:Class ;
    rdfs:subClassOf cco:ont00000958 ;
    rdfs:label "Ticker" ;
    skos:definition "Represents a unique symbol assigned to a publicly traded company for identification purposes on stock exchanges." ;
    skos:example "AAPL, GOOGL, AMZN, etc." ;
    abi:is_curated_in_foundry "enterprise_management_foundry" .

abi:Industry a owl:Class ;
    rdfs:subClassOf cco:ont00001239 ;
    rdfs:label "Industry" ;
    skos:definition "A Group of Organizations that share common characteristics, activities, or business objectives" ;
    skos:example "Technology, Finance, Healthcare, etc." ;
    abi:is_curated_in_foundry "enterprise_management_foundry" .

abi:Brand a owl:Class ;
    rdfs:subClassOf cco:ont00000853 ; # Descriptive Information Content Entity
    rdfs:label "Brand"@en ;
    skos:definition "Conveys the identity, distinguishing characteristics, and reputation of a product or service offered by an organization, often associated with a name, term, design, symbol, or other feature."@en ;
    skos:example "The brand \"Apple\" for consumer electronics"@en ,
                 "The brand \"Nike\" for athletic apparel"@en ;
    rdfs:comment "Brands are informational constructs that encapsulate the reputation and identity of products or services, making them suitable to be represented as Descriptive Information Content Entities." ;
    abi:is_curated_in_foundry "enterprise_management_foundry" .

abi:Logo a owl:Class ;
    rdfs:subClassOf cco:ont00002004 , # Image
      abi:GenericallyDependentContinuant ,
      [ a owl:Restriction ; owl:onProperty abi:isLogoOf ; owl:someValuesFrom abi:Organization ] ;
    rdfs:label "Logo"@en ;
    skos:definition "An image that an organization publishes to identify itself. Subclass of CCO Image."@en ;
    skos:example "The Accor logo shown beside the organization in a search result."@en ;
    rdfs:comment "The organization counterpart of abi:Portrait. The individual carries where the image is kept (abi:logo_storage_path) and where it is served (abi:logo_url), never the bytes: image data belongs in object storage, at <datastore>/<organization>/logos/<organization>.<ext>."@en .

#################################################################
#    Classes — WHY (capabilities)
#################################################################

abi:TechnologicalCapabilities a owl:Class ;
    rdfs:subClassOf cco:ont00000568 , # Organization Capability
                    bfo:BFO_0000016 , # disposition
      [ a owl:Restriction ; owl:onProperty bfo:BFO_0000197 ; owl:someValuesFrom cco:ont00001180 ] ; # inheres in (organization)
    rdfs:label "Technological Capabilities"@en ;
    skos:definition "The technological abilities, systems, and expertise possessed by an organization."@en ;
    skos:example "AI, Cloud Computing, Data Analytics, etc." ;
    rdfs:comment "Technological Capabilities are the technological abilities, systems, and expertise possessed by an organization." ;
    abi:is_curated_in_foundry "enterprise_management_foundry" .

abi:HumanCapabilities a owl:Class ;
    rdfs:subClassOf cco:ont00000568 , # Organization Capability
                    bfo:BFO_0000016 , # disposition
      [ a owl:Restriction ; owl:onProperty bfo:BFO_0000197 ; owl:someValuesFrom cco:ont00001180 ] ; # inheres in (organization)
    rdfs:label "Human Capabilities"@en ;
    skos:definition "The human skills, knowledge, and expertise possessed by an organization's workforce."@en ;
    skos:example "Software Development, Consulting Services, Marketing Campaigns, etc." ;
    rdfs:comment "Human Capabilities are the skills, knowledge, and expertise possessed by an organization's workforce." ;
    abi:is_curated_in_foundry "enterprise_management_foundry" .

#################################################################
#    Classes — WHERE (facilities)
#################################################################

abi:GlobalHeadquarters a owl:Class ;
    rdfs:subClassOf cco:ont00001102 ; # Commercial Facility
    rdfs:label "Global Headquarters"@en ;
    skos:definition "A Facility that serves as the central office for an organization on a global scale, providing strategic direction and administrative functions across all regions where the organization operates."@en ;
    skos:example "The global headquarters of a multinational corporation located in New York City."@en ;
    rdfs:comment "A Facility that serves as the central office for an organization on a global scale, providing strategic direction and administrative functions across all regions where the organization operates." ;
    abi:is_curated_in_foundry "enterprise_management_foundry" .

abi:RegionalHeadquarters a owl:Class ;
    rdfs:subClassOf cco:ont00001102 ; # Commercial Facility
    rdfs:label "Regional Headquarters"@en ;
    skos:definition "A Facility that serves as the central office for an organization within a specific region, overseeing operations and providing strategic direction and administrative functions for that region."@en ;
    skos:example "The regional headquarters of a company overseeing operations in Europe, based in Berlin."@en ;
    rdfs:comment "A Facility that serves as the central office for an organization within a specific region, overseeing operations and providing strategic direction and administrative functions for that region." ;
    abi:is_curated_in_foundry "enterprise_management_foundry" .

#################################################################
#    Object Properties
#################################################################

# WHO ↔ HOW WE KNOW - the organization carries its logo
abi:hasLogo a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:isCarrierOf ;
    owl:inverseOf abi:isLogoOf ;
    rdfs:label "has logo"@en ;
    skos:definition "Relates an organization to a logo image that identifies it."@en ;
    rdfs:domain abi:Organization ;
    rdfs:range abi:Logo .

abi:isLogoOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf abi:hasLogo ;
    rdfs:label "is logo of"@en ;
    skos:definition "Relates a logo image to the organization it identifies."@en ;
    rdfs:domain abi:Logo ;
    rdfs:range abi:Organization .

abi:hasLegalName a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000101 ; # is carrier of
    owl:inverseOf abi:isLegalNameOf ;
    rdfs:domain cco:ont00001180 ;
    rdfs:range cco:ont00001331 ;
    rdfs:label "has legal name"@en ;
    skos:definition "Relates an Organization to its legal name, which is a formally registered designation of the organization."@en .

abi:isLegalNameOf a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000084 ; # generically depends on
    owl:inverseOf abi:hasLegalName ;
    rdfs:domain cco:ont00001331 ;
    rdfs:range cco:ont00001180 ;
    rdfs:label "is legal name of"@en ;
    skos:definition "Relates a legal name to the organization it belongs to."@en .

abi:hasWebsite a owl:ObjectProperty ;
    owl:inverseOf abi:isWebsiteOf ;
    rdfs:domain cco:ont00001180 ;
    rdfs:range abi:Website ;
    rdfs:label "has website"@en ;
    skos:definition "Relates an organization to its website."@en ;
    skos:example "Microsoft's website, featuring their biography, a gallery of art pieces they've created, and a contact form for inquiries."@en .

abi:isWebsiteOf a owl:ObjectProperty ;
    owl:inverseOf abi:hasWebsite ;
    rdfs:domain abi:Website ;
    rdfs:range cco:ont00001180 ;
    rdfs:label "is website of"@en ;
    skos:definition "Relates a website to the organization it represents."@en ;
    skos:example "Microsoft's website, featuring their biography, a gallery of art pieces they've created, and a contact form for inquiries."@en .

abi:hasTickerSymbol a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000101 ; # is carrier of
    owl:inverseOf abi:isTickerSymbolOf ;
    rdfs:domain cco:ont00001180 ;
    rdfs:range abi:Ticker ;
    rdfs:label "has ticker"@en ;
    skos:definition "Relates an Organization to its ticker, which is a unique symbol assigned to a publicly traded company for identification purposes on stock exchanges."@en .

abi:isTickerSymbolOf a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000084 ; # generically depends on
    owl:inverseOf abi:hasTickerSymbol ;
    rdfs:domain abi:Ticker ;
    rdfs:range cco:ont00001180 ;
    rdfs:label "is ticker symbol of"@en ;
    skos:definition "Relates a ticker symbol to the organization it belongs to."@en .

abi:hasIndustry a owl:ObjectProperty ;
    owl:inverseOf abi:isIndustryOf ;
    rdfs:domain cco:ont00001180 ;
    rdfs:range abi:Industry ;
    rdfs:label "has industry"@en ;
    skos:definition "Relates an organization to the industry group it belongs to."@en .

abi:isIndustryOf a owl:ObjectProperty ;
    owl:inverseOf abi:hasIndustry ;
    rdfs:domain abi:Industry ;
    rdfs:range cco:ont00001180 ;
    rdfs:label "is industry of"@en ;
    skos:definition "Relates an industry group to an organization that belongs to it."@en .

abi:hasHeadquarters a owl:ObjectProperty ;
    owl:inverseOf abi:isHeadquartersOf ;
    rdfs:domain cco:ont00001180 ;
    rdfs:range cco:ont00001102 ;
    rdfs:label "has headquarters"@en ;
    skos:definition "Relates an organization to a facility that serves as its headquarters, global or regional."@en .

abi:isHeadquartersOf a owl:ObjectProperty ;
    owl:inverseOf abi:hasHeadquarters ;
    rdfs:domain cco:ont00001102 ;
    rdfs:range cco:ont00001180 ;
    rdfs:label "is headquarters of"@en ;
    skos:definition "Relates a headquarters facility to the organization it serves."@en .

#################################################################
#    Data Properties
#################################################################

abi:logo_url a owl:DatatypeProperty ;
    rdfs:label "logo url"@en ;
    skos:definition "Address at which the logo image is served."@en ;
    rdfs:domain abi:Logo ;
    rdfs:range xsd:anyURI .

abi:logo_storage_path a owl:DatatypeProperty ;
    rdfs:label "logo storage path"@en ;
    skos:definition "Object-storage path of the logo image (under the datastore), from which the logo url is served."@en ;
    rdfs:domain abi:Logo ;
    rdfs:range xsd:string .

abi:organization_id a owl:DatatypeProperty ;
    rdfs:domain cco:ont00001180 ;
    rdfs:range xsd:string ;
    rdfs:label "organization id"@en ;
    skos:definition "The unique identifier for an organization."@en .

abi:ticker_symbol a owl:DatatypeProperty ;
    rdfs:domain abi:Ticker ;
    rdfs:range xsd:string ;
    rdfs:label "ticker symbol"@en ;
    skos:definition "The symbol string itself, e.g. 'AAPL'."@en .

abi:website_url a owl:DatatypeProperty ;
    rdfs:domain abi:Website ;
    rdfs:range xsd:string ;
    rdfs:label "website url"@en ;
    skos:definition "The URL at which the organization's website is served."@en .

#################################################################
#    Object Properties - shared by the process slices
#################################################################

abi:hasAllianceAgreement a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000058 ; # is concretized by
    owl:inverseOf abi:isAllianceAgreementOf ;
    rdfs:domain cco:ont00000228 ;
    rdfs:range abi:StrategicAlliance ;
    rdfs:label "has alliance agreement"@en ;
    skos:definition "Relates an act of alliance to the agreement document that records its terms."@en .

abi:isAllianceAgreementOf a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000059 ; # concretizes
    owl:inverseOf abi:hasAllianceAgreement ;
    rdfs:domain abi:StrategicAlliance ;
    rdfs:range cco:ont00000228 ;
    rdfs:label "is alliance agreement of"@en ;
    skos:definition "Relates an alliance agreement document to the act of alliance it records."@en .

abi:hasAllianceParticipant a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000057 ; # has participant
    owl:inverseOf abi:participatesInAlliance ;
    rdfs:domain cco:ont00000228 ;
    rdfs:range cco:ont00001180 ;
    rdfs:label "has alliance participant"@en ;
    skos:definition "Relates an act of alliance to an organization taking part in it. An alliance has two or more participants, none of which loses its separate identity."@en .

abi:participatesInAlliance a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000056 ; # participates in
    owl:inverseOf abi:hasAllianceParticipant ;
    rdfs:domain cco:ont00001180 ;
    rdfs:range cco:ont00000228 ;
    rdfs:label "participates in alliance"@en ;
    skos:definition "Relates an organization to an act of alliance it takes part in."@en .

abi:hasRestructuringRecord a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000058 ; # is concretized by
    owl:inverseOf abi:isRestructuringRecordOf ;
    rdfs:domain cco:ont00000228 ;
    rdfs:range cco:ont00000853 ;
    rdfs:label "has restructuring record"@en ;
    skos:definition "Relates an act of organizational restructuring to the document that records its terms."@en .

abi:isRestructuringRecordOf a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000059 ; # concretizes
    owl:inverseOf abi:hasRestructuringRecord ;
    rdfs:domain cco:ont00000853 ;
    rdfs:range cco:ont00000228 ;
    rdfs:label "is restructuring record of"@en ;
    skos:definition "Relates a restructuring document to the act it records."@en .

abi:hasMergingOrganization a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000057 ; # has participant
    owl:inverseOf abi:mergesIn ;
    rdfs:domain abi:ActOfOrganizationalMerger ;
    rdfs:range cco:ont00001180 ;
    rdfs:label "has merging organization"@en ;
    skos:definition "Relates an act of merger to one of the organizations uniting in it. Symmetric in role: no participant is privileged, which is exactly what distinguishes a merger from an acquisition."@en .

abi:mergesIn a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000056 ; # participates in
    owl:inverseOf abi:hasMergingOrganization ;
    rdfs:domain cco:ont00001180 ;
    rdfs:range abi:ActOfOrganizationalMerger ;
    rdfs:label "merges in"@en ;
    skos:definition "Relates an organization to an act of merger it unites in."@en .

abi:hasAcquiringOrganization a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000057 ; # has participant
    owl:inverseOf abi:acquiresIn ;
    rdfs:domain abi:ActOfOrganizationalAcquisition ;
    rdfs:range cco:ont00001180 ;
    rdfs:label "has acquiring organization"@en ;
    skos:definition "Relates an act of acquisition to the organization gaining control. Kept distinct from abi:hasAcquiredOrganization so that 'who bought whom' is answerable."@en .

abi:acquiresIn a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000056 ; # participates in
    owl:inverseOf abi:hasAcquiringOrganization ;
    rdfs:domain cco:ont00001180 ;
    rdfs:range abi:ActOfOrganizationalAcquisition ;
    rdfs:label "acquires in"@en ;
    skos:definition "Relates an organization to an act of acquisition in which it is the acquirer."@en .

abi:hasAcquiredOrganization a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000057 ; # has participant
    owl:inverseOf abi:isAcquiredIn ;
    rdfs:domain abi:ActOfOrganizationalAcquisition ;
    rdfs:range cco:ont00001180 ;
    rdfs:label "has acquired organization"@en ;
    skos:definition "Relates an act of acquisition to the organization whose assets, operations and management pass under the acquirer's control."@en .

abi:isAcquiredIn a owl:ObjectProperty ;
    rdfs:subPropertyOf bfo:BFO_0000056 ; # participates in
    owl:inverseOf abi:hasAcquiredOrganization ;
    rdfs:domain cco:ont00001180 ;
    rdfs:range abi:ActOfOrganizationalAcquisition ;
    rdfs:label "is acquired in"@en ;
    skos:definition "Relates an organization to an act of acquisition in which it is the target."@en .

abi:hasSubsidiaryOrganization a owl:ObjectProperty ;
    owl:inverseOf abi:hasParentOrganization ;
    rdfs:domain cco:ont00001180 ;
    rdfs:range cco:ont00001180 ;
    rdfs:label "has subsidiary organization"@en ;
    skos:definition "Relates an organization to another organization it controls and owns a significant share of."@en .

abi:hasParentOrganization a owl:ObjectProperty ;
    owl:inverseOf abi:hasSubsidiaryOrganization ;
    rdfs:domain cco:ont00001180 ;
    rdfs:range cco:ont00001180 ;
    rdfs:label "has parent organization"@en ;
    skos:definition "Relates an organization to the organization that controls it."@en .

#################################################################
#    Classes - HOW WE KNOW (agreements, shared by the alliance slices)
#################################################################

abi:StrategicAlliance a owl:Class ;
    rdfs:subClassOf cco:ont00000853 ; # Descriptive Information Content Entity
    rdfs:label "Strategic Alliance"@en ;
    skos:definition "Describes an agreement between two or more organizations to pursue a set of agreed-upon objectives while remaining independent entities."@en ;
    skos:example "A memorandum of understanding (MOU) between a technology company and a software provider"@en ,
                 "A strategic collaboration agreement in the automotive sector"@en ;
    rdfs:comment "Strategic alliances are typically formalized through documents and agreements, making them apt to be represented as Descriptive Information Content Entities." ;
    abi:is_curated_in_foundry "enterprise_management_foundry" .

#################################################################
#    Classes - WHY (the role each party bears under an agreement)
#################################################################

abi:OrganizationalAgreementRole a owl:Class ;
    rdfs:subClassOf abi:Role ,
      [ a owl:Restriction ; owl:onProperty abi:inheresIn ; owl:someValuesFrom abi:Organization ] ;
    rdfs:label "Organizational Agreement Role"@en ;
    skos:definition "A Role borne by an organization in virtue of an agreement it is party to (alliance, licence, distribution, merger, acquisition or subsidiary establishment), and realized by the act that carries the agreement out."@en ;
    skos:example "The role of licensee borne by a manufacturer under a technology licensing agreement; the role of acquirer borne by Company X in its acquisition of Company Y."@en ;
    rdfs:comment "One generic role for every organization process: the agreement record (HOW WE KNOW) states which side each party is on."@en .

