@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:    <http://purl.org/dc/terms/> .
@prefix dc11:  <http://purl.org/dc/elements/1.1/> .
@prefix bfo:   <http://purl.obolibrary.org/obo/> .
@prefix cco:   <https://www.commoncoreontologies.org/> .
@prefix abi:   <http://ontology.naas.ai/abi/> .

abi:ActOfOrganizationalMergerProcess a owl:Ontology ;
  # Slice: the act and the document that records it. Shared vocabulary
  # (StrategicAlliance, participant and record properties,
  # OrganizationalAgreementRole) lives in the module OrganizationOntology,
  # which this slice does NOT import (the module consolidates this file).
  #
  # Seven-bucket mapping for one organizational merger:
  #   WHO          Organization (the merging parties, symmetric)
  #   WHAT         ActOfOrganizationalMerger (the process itself)
  #   WHEN         TemporalRegion, from the agreement's effective date to its end
  #   WHERE        GeospatialRegion (Site - the country, region or city the act occurs in)
  #   WHY          OrganizationalAgreementRole (SDC) - the role each party bears under the agreement
  #   HOW IT IS    not stated: no quality is specific to this act
  #   HOW WE KNOW  OrganizationMerger (the restructuring record, a descriptive ICE)
  owl:imports <http://ontology.naas.ai/abi/Ontology> ;
  owl:imports <http://ontology.naas.ai/abi/OrganizationOntology> ;
  owl:imports <http://ontology.naas.ai/abi/GeospatialRegionOntology> ;
  owl:imports <https://www.commoncoreontologies.org/EventOntology> ;
  owl:imports <https://www.commoncoreontologies.org/AgentOntology> ;
  owl:imports <https://www.commoncoreontologies.org/InformationEntityOntology> ;
  rdfs:seeAlso <http://ontology.naas.ai/abi/OrganizationsOntology> ;
  abi:pythonPackage "naas_abi_marketplace.domains.intelligence.modules.organizations" ;
  abi:ontologyResource "ontologies/processes/ActOfOrganizationalMergerProcess.ttl" ;
  abi:pythonResource "ontologies/processes/ActOfOrganizationalMergerProcess.py" ;
  dc:title "Act of Organizational Merger Process Ontology"@en ;
  dc:description "Process slice for the act of organizational merger: a CCO Planned Act with organizations as participants, occurring in a geospatial region over a temporal region, realizing the agreement roles the parties bear, and documented by its organization merger record."@en ;
  dc:license <https://creativecommons.org/licenses/by/4.0/> ;
  rdfs:comment "Process slice for Act of Organizational Merger. Reuses the shared organization vocabulary."@en ;
  dc11:contributor "Florent Ravenel", "Alice Dupont", "Emma Petit", "Grace Lambert" ;
  dc11:date "2026-10-05"^^xsd:date .

#################################################################
#    Classes - WHAT
#################################################################

abi:ActOfOrganizationalMerger a owl:Class ;
  rdfs:subClassOf cco:ont00000228 , # Planned Act
    [ a owl:Restriction ; owl:onProperty abi:hasMergingOrganization ; owl:someValuesFrom abi:Organization ] ,
    [ a owl:Restriction ; owl:onProperty abi:occursIn ; owl:someValuesFrom abi:GeospatialRegion ] ,
    [ a owl:Restriction ; owl:onProperty abi:occupiesTemporalRegion ; owl:someValuesFrom abi:TemporalRegion ] ,
    [ a owl:Restriction ; owl:onProperty abi:realizes ; owl:someValuesFrom abi:OrganizationalAgreementRole ] ,
    [ a owl:Restriction ; owl:onProperty abi:hasRestructuringRecord ; owl:someValuesFrom abi:OrganizationMerger ] ;
  rdfs:label "Act of Organizational Merger"@en ;
  skos:definition "An Act of Association in which two or more independent organizations unite to form a single entity, typically to enhance operational efficiency, market reach, or competitive advantage."@en ;
  skos:example "The merger of Company A and Company B to form a new entity, AB Corporation, for the purpose of expanding their market presence and combining resources."@en ;
  abi:is_curated_in_foundry "enterprise_management_foundry" .

#################################################################
#    Classes - HOW WE KNOW
#################################################################

abi:OrganizationMerger a owl:Class ;
  rdfs:subClassOf cco:ont00000853 ; # Descriptive Information Content Entity
  rdfs:label "Organization Merger"@en ;
  skos:definition "Details a planned act in which two or more organizations unite to form a single entity, typically to enhance operational efficiency, market reach, or competitive advantage."@en ;
  skos:example "The merger of Company A and Company B to form a new entity, AB Corporation, for the purpose of expanding their market presence and combining resources."@en ;
  rdfs:comment "A merger is often documented through agreements and plans, which makes it suitable to be represented as a Descriptive Information Content Entity." ;
  abi:is_curated_in_foundry "enterprise_management_foundry" .

#################################################################
#    Classes - HOW IT IS
#################################################################
