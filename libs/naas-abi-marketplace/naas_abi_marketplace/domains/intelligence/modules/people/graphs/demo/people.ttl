        <http://ontology.naas.ai/people/ActOfWorking/claire-bernard-cloud-partners-cloud-engineer>,
        <http://ontology.naas.ai/people/ActOfWorking/claire-bernard-demo-cto> ;
    people:skill_name "Kubernetes" ;
    dcterms:created "2026-10-02T08:35:14.418899"^^xsd:dateTime ;
    dcterms:creator "DemoPersonGraphWorkflow" .

people:developsLanguageCapability a owl:ObjectProperty ;
