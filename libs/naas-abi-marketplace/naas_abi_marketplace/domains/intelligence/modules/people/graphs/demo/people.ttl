people:ActOfWorking a owl:Class ;
    rdfs:label "Act of Working"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty people:forOrganization ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:onProperty abi:occursIn ;
            owl:someValuesFrom cco:ont00000468 ],
        [ a owl:Restriction ;
            owl:onProperty abi:occupiesTemporalRegion ;
            owl:someValuesFrom abi:TemporalRegion ],
        [ a owl:Restriction ;
            owl:onProperty abi:realizes ;
            owl:someValuesFrom people:OccupationRole ],
        [ a owl:Restriction ;
            owl:onProperty people:developsSkill ;
            owl:someValuesFrom people:Skill ],
        [ a owl:Restriction ;
            owl:onProperty people:developsLanguageCapability ;
            owl:someValuesFrom people:LanguageCapability ],
        [ a owl:Restriction ;
            owl:onProperty people:hasSourceDocument ;
            owl:someValuesFrom people:ProfileDocument ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which a person performs work for an organization in an office building over a temporal region, realizing an occupation role and developing skills and language capabilities."@en ;
    skos:example "Alice Dupont working as Head of Product for Demo, worldwide, since April 2023."@en .

people:ProfileDocument a owl:Class ;
    rdfs:label "Profile Document"@en ;
    rdfs:comment "The provenance anchor of the demo graph: everything asserted from a profile page: missions, roles, skills, enrollments, degrees, certifications points back to the ProfileDocument it was read from."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Person ],
        abi:DocumentContentEntity ;
    skos:definition "A document content entity, published at a retrievable address, from which statements about a person's history are taken: what they did, where they studied, what they hold. Carried by the person the profile is about."@en ;
    skos:example "https://demo.example/profiles/demo"@en .

abi:Organization rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty people:hasOfficeBuilding ;
            owl:someValuesFrom cco:ont00000468 ],
        [ a owl:Restriction ;
            owl:onProperty people:hasAssessmentFacility ;
            owl:someValuesFrom cco:ont00000192 ] .

