people:Skill a owl:Class ;
    rdfs:label "Skill"@en ;
    rdfs:comment "Borne by the person, not by the process: the skill outlives any one act of working. people:developsSkill links a planned act, of whatever kind, to the skills exercised and grown in it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:inheresIn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty people:isSkillDevelopedIn ;
            owl:someValuesFrom cco:ont00000228 ],
        abi:Quality ;
    skos:definition "A quality that inheres in a person, consisting in a learned capacity to perform a kind of task, developed and exercised in the acts the person carries out: working, studying, being certified."@en ;
    skos:example "Python (Programming Language); Business Analysis; SAP BFC."@en .

abi:Person rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty people:hasWorkFacility ;
            owl:someValuesFrom cco:ont00000468 ],
        [ a owl:Restriction ;
            owl:onProperty people:hasCertificationFacility ;
            owl:someValuesFrom cco:ont00000192 ],
        [ a owl:Restriction ;
            owl:onProperty people:hasStudyFacility ;
            owl:someValuesFrom cco:ont00000270 ] .

