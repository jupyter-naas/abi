people:developsSkill a owl:ObjectProperty ;
    rdfs:label "develops skill"@en ;
    rdfs:domain cco:ont00000228 ;
    rdfs:range people:Skill ;
    owl:inverseOf people:isSkillDevelopedIn ;
    skos:definition "Relates a planned act (an act of working or of studying, for one) to a skill exercised and developed in the course of it."@en .

people:PeopleOntology a owl:Ontology ;
    abi:ontologyResource "ontologies/modules/PeopleOntology.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.intelligence.modules.people" ;
    abi:pythonResource "ontologies/modules/PeopleOntology.py" ;
    dc:contributor "Alice Dupont" ;
    dc:date "2026-08-18"^^xsd:date ;
    dcterms:description "Shared vocabulary for people intelligence (S2): what can be known about any person, whoever employs them - the occupation and student roles they bear, the missions, skills, language capabilities and interests they carry, and the records and documents that report them. It also holds what a person is presented as: the profile summary and portrait published for them, the certifications they hold and the recommendations others write about them. Internal HR records (employee role, job position, employment record and contract, remuneration, grade, service line) are not here: an organization keeps those about its own staff, and specializes these classes to do so. Process slices (ActOfWorkingProcess, ActOfStudyingProcess, ActOfCertificationProcess, ActOfProfilingProcess) import nothing from this file; this ontology imports them and they restrict these classes in context."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "People Ontology"@en ;
    rdfs:comment "Shared people classes. Process restrictions live in ontologies/processes/. Nothing here depends on an organization's internal records: a vocabulary that specializes these classes imports this one, never the reverse."@en ;
    rdfs:seeAlso <https://raw.githubusercontent.com/jupyter-naas/abi/refs/heads/main/libs/naas-abi-marketplace/naas_abi_marketplace/domains/intelligence/modules/people/ontologies/modules/PeopleOntology.ttl> ;
    owl:imports abi:Ontology,
        people:ActOfCertificationProcess,
        people:ActOfProfilingProcess,
        people:ActOfStudyingProcess,
        people:ActOfWorkingProcess,
        cco:AgentOntology,
        cco:FacilityOntology,
        cco:InformationEntityOntology,
        cco:QualityOntology .

