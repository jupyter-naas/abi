<http://ontology.naas.ai/personnel/Mission/grace-lambert-human-coders-human-talks-organizer> a personnel:Mission,
        owl:NamedIndividual ;
    rdfs:label "Organizing monthly Human Talks developer meetups in Montpellier." ;
