<http://ontology.naas.ai/personnel/Mission/grace-lambert-bress-healthcare-system-administrator-devops> a personnel:Mission,
        owl:NamedIndividual ;
    rdfs:label "Deployed the whole infrastructure for Bress Healthcare while completing an MSc in Network and Networks Security at the University of Kent." ;
    personnel:isMissionCarriedBy <http://ontology.naas.ai/abi/Person/grace-lambert> ;
