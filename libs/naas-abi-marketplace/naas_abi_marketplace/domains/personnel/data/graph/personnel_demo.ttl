personnel:ActOfWorkingProcess a owl:Ontology ;
    abi:ontologyResource "ontologies/processes/ActOfWorkingProcess.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
    abi:pythonResource "ontologies/processes/ActOfWorkingProcess.py" ;
    dc:contributor "Alice Dupont",
        "Emma Petit",
        "Grace Lambert" ;
    dc:date "2026-08-13"^^xsd:date ;
    dcterms:description "Process slice for the act of working — a CCO Planned Act (and Act of Employment) in which a person performs work for an organization at a site, concretizing an employment contract and realizing an employee role."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Act of Working Process Ontology"@en ;
    rdfs:comment "Process slice for Act of Working. Reuses shared personnel classes."@en ;
    rdfs:member "bpl-processes/personnel" ;
    rdfs:seeAlso personnel:PersonnelOntology ;
    owl:imports abi:Ontology,
        cco:AgentOntology,
        cco:EventOntology .

