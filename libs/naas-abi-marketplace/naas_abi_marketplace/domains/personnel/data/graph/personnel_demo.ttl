personnel:ActOfStudyingProcess a owl:Ontology ;
    abi:ontologyResource "ontologies/processes/ActOfStudyingProcess.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
    abi:pythonResource "ontologies/processes/ActOfStudyingProcess.py" ;
    dc:contributor "Alice Dupont",
        "Emma Petit",
        "Grace Lambert" ;
    dc:date "2026-08-14"^^xsd:date ;
    dcterms:description "Process slice for the act of studying — a CCO Planned Act (Act of Educational Training Acquisition) in which a person acquires knowledge of a curriculum from an educational organization at a site, concretizing an enrollment record and realizing a student role."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Act of Studying Process Ontology"@en ;
    rdfs:comment "Process slice for Act of Studying. Reuses shared personnel classes."@en ;
    rdfs:member "bpl-processes/personnel" ;
    rdfs:seeAlso personnel:PersonnelOntology ;
    owl:imports abi:Ontology,
        cco:AgentOntology,
        cco:EventOntology,
        cco:InformationEntityOntology .

