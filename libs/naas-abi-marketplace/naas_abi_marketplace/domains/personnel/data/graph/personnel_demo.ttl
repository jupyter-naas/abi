personnel:StudentRole a owl:Class ;
    rdfs:label "Student Role"@en ;
    rdfs:comment "No CCO student-role class; minted in the personnel namespace. Ends when the enrollment ends, without the person ceasing to exist."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isStudentRoleOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasRealization ;
            owl:someValuesFrom personnel:ActOfStudying ],
        abi:Role ;
    skos:definition "A role that inheres in a person in virtue of being enrolled in a curriculum at an educational organization, realized in the Act of Studying."@en ;
    skos:example "The role Florent bears as a computer-science student at Université de Rennes 1."@en .

