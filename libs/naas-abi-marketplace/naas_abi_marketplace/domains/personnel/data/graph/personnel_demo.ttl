personnel:PersonnelOntology a owl:Ontology ;
    abi:ontologyResource "ontologies/modules/PersonnelOntology.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
    abi:pythonResource "ontologies/modules/PersonnelOntology.py" ;
    dc:contributor "Alice Dupont" ;
    dc:date "2026-08-12"^^xsd:date ;
    dcterms:description "Ontology for the personnel (S1) domain. Models who is in an organization and what their employment status is: the person, the employment record that generically depends on them, the position they hold and the organization that employs them. Deliberately separates the person (a material entity that exists independently of any employer) from the employee role they bear and from the record that documents it — collapsing the three is the most common modelling error in HR data, and it makes a person un-representable across a change of employer."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Personnel Ontology"@en ;
    rdfs:comment "Ontology for the personnel domain: people, employment records, positions and status."@en ;
    rdfs:seeAlso <https://raw.githubusercontent.com/jupyter-naas/abi/refs/heads/main/libs/naas-abi-marketplace/naas_abi_marketplace/domains/personnel/ontologies/modules/PersonnelOntology.ttl> ;
    owl:imports abi:Ontology .

<http://ontology.naas.ai/abi/Organization/demo> a abi:Organization,
        owl:NamedIndividual ;
    rdfs:label "Naas.ai" ;
    personnel:employs <http://ontology.naas.ai/abi/Person/alice-dupont>,
        <http://ontology.naas.ai/abi/Person/emma-petit>,
        <http://ontology.naas.ai/abi/Person/grace-lambert> ;
    dcterms:created "2026-08-14T08:04:46.164462"^^xsd:dateTime ;
    dcterms:creator "generate_demo_graph" .

personnel:BirthRegistrationProcess a owl:Class,
        owl:Ontology ;
    rdfs:label "Birth Registration Process"@en ;
    abi:ontologyResource "ontologies/processes/BirthRegistrationProcess.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
    abi:pythonResource "ontologies/processes/BirthRegistrationProcess.py" ;
    dc:contributor "Alice Dupont",
        "Emma Petit",
        "Grace Lambert" ;
    dc:date "2026-08-13"^^xsd:date ;
    dcterms:description "Process ontology for birth registration — the first entry in the personnel (S1) process ledger. Separates three occurrents that are routinely conflated: the Birth itself (a mind-independent natural process, one per person), the Birth Declaration Act (an act of representative communication in which some agent asserts that the birth occurred — the evidential source), and the Birth Registration Process (the planned act that enters that assertion into the ledger and outputs a birth record). Two people declaring the same birth yield two declaration acts and two registrations over one and the same Birth. Decomposed across the BFO seven buckets: the person (with their given and family name) and the animals that participate (WHO), the temporal regions occupied (WHEN), the site it occurs in (WHERE), the birth record (HOW WE KNOW), the weight, length, gestational age and biological sex borne by the newborn (HOW IT IS), and the birth function and newborn dispositions realized (WHY). Adapted from the NCOR BFO-Process-Ledger entry of the same name."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://github.com/NCOR-Organization/BFO-Process-Ledger/blob/master/src/ontology/bpl-processes/personnel/BirthRegistration.ttl> ;
    dcterms:title "Birth Registration Process Ontology"@en ;
    rdfs:comment "Process ontology for birth registration, decomposed across the BFO seven buckets."@en,
        "Two registrations of the same birth by different declarants are two distinct instances of this class related to one and the same instance of cco:ont00001237. Its own temporal region is ledger time — when the entry was made — which is distinct from the declaration act's temporal region (when it was said) and from the birth's (when it happened)."@en ;
    rdfs:member "bpl-processes/personnel" ;
    rdfs:seeAlso personnel:PersonnelOntology ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        cco:ont00000228 ;
    owl:imports abi:BFO7Buckets,
        personnel:PersonnelOntology,
        cco:AgentOntology,
        cco:EventOntology,
        cco:ExtendedRelationOntology,
        cco:InformationEntityOntology ;
    skos:definition "A Planned Act in which the content asserted by a birth declaration act is entered into the personnel ledger, producing a birth record."@en ;
    skos:example "The personnel agent writes Jeremy's birth record on 2026-08-13 from Florent's declaration; a second registration is written two weeks later from Christine's."@en .

