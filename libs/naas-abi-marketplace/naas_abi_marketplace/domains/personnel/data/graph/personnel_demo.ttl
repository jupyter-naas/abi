personnel:WorkingProcess a owl:Ontology ;
    abi:ontologyResource "ontologies/processes/WorkingProcess.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
    abi:pythonResource "ontologies/processes/WorkingProcess.py" ;
    dc:contributor "Alice Dupont",
        "Emma Petit",
        "Grace Lambert" ;
    dc:date "2026-08-13"^^xsd:date ;
    dcterms:description "Process ontology for the act of working — an ongoing occurrent in which a person performs work for an organization at a site, under a contract and job position, with remuneration. Decomposed across BFO buckets."@en ;
    dcterms:title "Working Process Ontology"@en ;
    rdfs:member "bpl-processes/personnel" ;
    rdfs:seeAlso personnel:PersonnelOntology ;
    owl:imports abi:BFO7Buckets,
        personnel:PersonnelOntology,
        cco:EventOntology,
        cco:InformationEntityOntology .

