    dcterms:created "2026-08-18T10:34:37.202450"^^xsd:dateTime ;
    dcterms:creator "generate_demo_graph" .

personnel:EmploymentStatus a owl:Class ;
    rdfs:label "Employment Status"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isEmploymentStatusOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:concretizes ;
            owl:someValuesFrom personnel:EmploymentRecord ],
        abi:Quality ;
    skos:definition "A quality that inheres in a person and holds the state of their employment relationship at a point in time."@en ;
    skos:example "'on-leave' for a person on parental leave."@en .

personnel:JobDescription a owl:Class ;
    rdfs:label "Job Description"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Organization ],
        abi:DocumentContentEntity ;
    skos:definition "A document content entity that states the duties, responsibilities and requirements of a job position."@en ;
    skos:example "The published job description for 'Senior Data Engineer, EMEA'."@en .

personnel:ProfileDocument a owl:Class ;
    rdfs:label "Profile Document"@en ;
    rdfs:comment "The provenance anchor of the demo graph: every Mission, EmployeeRole and Skill asserted from a profile page points back to the ProfileDocument it was read from."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Person ],
        abi:DocumentContentEntity ;
    skos:definition "A document content entity, published at a retrievable address, from which statements about a person's working and studying history are taken. Carried by the person the profile is about."@en ;
    skos:example "https://demo.example/profiles/demo"@en .

personnel:ActOfStudying a owl:Class ;
    rdfs:label "Act of Studying"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty personnel:forEducationalOrganization ;
            owl:someValuesFrom cco:ont00000564 ],
        [ a owl:Restriction ;
            owl:onProperty abi:occursIn ;
            owl:someValuesFrom abi:Site ],
        [ a owl:Restriction ;
            owl:onProperty abi:occupiesTemporalRegion ;
            owl:someValuesFrom abi:TemporalRegion ],
        [ a owl:Restriction ;
            owl:onProperty personnel:hasEnrollment ;
            owl:someValuesFrom personnel:EnrollmentRecord ],
        [ a owl:Restriction ;
            owl:onProperty abi:realizes ;
            owl:someValuesFrom personnel:StudentRole ],
        cco:ont00000228,
        cco:ont00001074 ;
    skos:definition "A Planned Act, and an Act of Educational Training Acquisition, in which a person acquires knowledge of a curriculum from an educational organization at a site, under an enrollment record, realizing a student role."@en ;
    skos:example "Alice Dupont studying computer science at Université de Rennes 1 in Rennes from 2009-09-01 to 2014-06-30."@en .

personnel:EmploymentRecord a owl:Class ;
    rdfs:label "Employment Record"@en ;
    rdfs:comment "Generically dependent on the person: the same record can be copied between systems without ceasing to be the record of that person. Concretized by the Act of Working that the relationship consists in."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isEmploymentRecordOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom personnel:ActOfWorking ],
        abi:GenericallyDependentContinuant ;
    skos:definition "An information content entity that documents an employment relationship between a person and an organization, including its identifier and its start and end dates."@en ;
    skos:example "The HR system record for employee E-10428, hired 2024-03-01."@en .

personnel:EnrollmentRecord a owl:Class ;
    rdfs:label "Enrollment Record"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom personnel:ActOfStudying ],
        [ a owl:Restriction ;
            owl:onProperty personnel:isEnrollmentRecordOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom cco:ont00000564 ],
        abi:GenericallyDependentContinuant ;
    skos:definition "An information content entity that documents a person's enrollment in a curriculum at an educational organization, including the programme name and its start and end dates."@en ;
    skos:example "Enrollment in the Computer Science licence at Université de Rennes 1, 2009-09-01 to 2014-06-30."@en .

personnel:EmploymentContract a owl:Class ;
    rdfs:label "Employment Contract"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom personnel:ActOfWorking ],
        abi:GenericallyDependentContinuant ;
    skos:definition "A generically dependent continuant that specifies the terms under which a person works for an organization."@en ;
    skos:example "Permanent contract CDI — Alice Dupont / naas.ai."@en .

<http://ontology.naas.ai/personnel/ProfileDocument/alice-dupont-linkedin> a personnel:ProfileDocument,
        owl:NamedIndividual ;
    rdfs:label "LinkedIn experience — Alice Dupont" ;
    personnel:isProfileDocumentOf <http://ontology.naas.ai/abi/Person/alice-dupont> ;
    personnel:source_url "https://demo.example/profiles/demo" ;
    dcterms:created "2026-08-18T10:34:37.193946"^^xsd:dateTime ;
    dcterms:creator "generate_demo_graph" .

personnel:Mission a owl:Class ;
    rdfs:label "Mission"@en ;
    rdfs:comment "Deliberately a GDC and NOT a BFO function. A mission is stated, copied between systems and survives the person leaving the post, which a disposition inhering in the person could not. The WHY that inheres in the person is personnel:EmployeeRole; the mission is what that role concretizes, mirroring the JobPosition ← EmployeeRole pattern in PersonnelOntology. rdfs:label carries the opening sentence; personnel:mission_content carries the full text."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isSourcedFrom ;
            owl:someValuesFrom personnel:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom personnel:EmployeeRole ],
        abi:GenericallyDependentContinuant ;
    skos:definition "An information content entity that states what a person is charged with achieving in an employment relationship: the remit, its objectives and its main activities. Generically dependent on the person, and concretized by the employee role through which the person carries it out."@en ;
    skos:example "'Leading the development of an open Universal Data & AI Platform to help organizations create powerful ecosystems of AI Agents.'"@en .

personnel:Skill a owl:Class ;
    rdfs:label "Skill"@en ;
    rdfs:comment "Borne by the person, not by the process: the skill outlives any one act of working. personnel:developsSkill links the act to the skills exercised and grown in it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:inheresIn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty personnel:isSkillDevelopedIn ;
            owl:someValuesFrom personnel:ActOfWorking ],
        abi:Quality ;
    skos:definition "A quality that inheres in a person, consisting in a learned capacity to perform a kind of task, developed and exercised in the acts of working the person carries out."@en ;
    skos:example "Python (Programming Language); Business Analysis; SAP BFC."@en .

personnel:EmployeeRole a owl:Class ;
    rdfs:label "Employee Role"@en ;
    rdfs:comment "Externally grounded: it exists only while the employment relationship holds, and ends without the person ceasing to exist. Concretizes a JobPosition (possibly filling a previously vacant requisition)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isEmployeeRoleOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasRealization ;
            owl:someValuesFrom personnel:ActOfWorking ],
        [ a owl:Restriction ;
            owl:onProperty personnel:hasJobPosition ;
            owl:someValuesFrom personnel:JobPosition ],
        abi:Role ;
    owl:equivalentClass cco:ont00000984 ;
    skos:definition "A role that inheres in a person in virtue of an employment relationship with an organization, realized in the Act of Working the person carries out for that organization. Equivalent to CCO Occupation Role."@en ;
    skos:example "The role Jane bears as a data engineer at ACME."@en .

personnel:JobPosition a owl:Class ;
    rdfs:label "Job Position"@en ;
    rdfs:comment "Deliberately NOT a subclass of abi:Role. A BFO role must inhere in a bearer, but an open requisition has no occupant. Occupied positions are concretized by personnel:EmployeeRole (allValuesFrom, not someValuesFrom, so a vacant position remains satisfiable)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:allValuesFrom personnel:EmployeeRole ;
            owl:onProperty abi:isConcretizedBy ],
        abi:GenericallyDependentContinuant ;
    skos:definition "An information content entity, defined by an organization as part of its structure, that specifies a role to be borne by whoever fills it. Fundable and referable independently of any occupant, and possibly vacant."@en ;
    skos:example "Requisition R-2291, 'Senior Data Engineer, EMEA', currently vacant."@en .

personnel:ActOfWorking a owl:Class ;
    rdfs:label "Act of Working"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty personnel:forOrganization ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:onProperty abi:occursIn ;
            owl:someValuesFrom abi:Site ],
        [ a owl:Restriction ;
            owl:onProperty abi:occupiesTemporalRegion ;
            owl:someValuesFrom abi:TemporalRegion ],
        [ a owl:Restriction ;
            owl:onProperty abi:realizes ;
            owl:someValuesFrom personnel:EmployeeRole ],
        [ a owl:Restriction ;
            owl:onProperty personnel:developsSkill ;
            owl:someValuesFrom personnel:Skill ],
        [ a owl:Restriction ;
            owl:onProperty personnel:hasContract ;
            owl:someValuesFrom personnel:EmploymentContract ],
        cco:ont00000228,
        cco:ont00001226 ;
    skos:definition "A Planned Act, and an Act of Employment, in which a person performs work for an organization at a site over a temporal region, realizing an employee role, developing skills, under an employment contract."@en ;
    skos:example "Alice Dupont working as Head of Product for Demo, worldwide, since April 2023."@en .

