personnel:EmploymentRecord a owl:Class ;
    rdfs:label "Employment Record"@en ;
    rdfs:comment "Generically dependent on the person: the same record can be copied between systems without ceasing to be the record of that person. Concretized by the Act of Working that the relationship consists in."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isEmploymentRecordOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom personnel:ActOfWorking ],
        abi:GenericallyDependentContinuant ;
    skos:definition "An information content entity that documents an employment relationship between a person and an organization, including its identifier and its start and end dates."@en ;
    skos:example "The HR system record for employee E-10428, hired 2024-03-01."@en .

personnel:ProfileDocument a owl:Class ;
    rdfs:label "Profile Document"@en ;
    rdfs:comment "The provenance anchor of the demo graph: every Mission, EmployeeRole and Skill asserted from a profile page points back to the ProfileDocument it was read from."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Person ],
        abi:DocumentContentEntity ;
    skos:definition "A document content entity, published at a retrievable address, from which statements about a person's working and studying history are taken. Carried by the person the profile is about."@en ;
    skos:example "https://demo.example/profiles/demo"@en .

