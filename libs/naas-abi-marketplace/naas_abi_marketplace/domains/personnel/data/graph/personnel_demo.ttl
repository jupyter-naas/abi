personnel:JobDescription a owl:Class ;
    rdfs:label "Job Description"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Organization ],
        abi:DocumentContentEntity ;
    skos:definition "A document content entity that states the duties, responsibilities and requirements of a job position."@en ;
    skos:example "The published job description for 'Senior Data Engineer, EMEA'."@en .

