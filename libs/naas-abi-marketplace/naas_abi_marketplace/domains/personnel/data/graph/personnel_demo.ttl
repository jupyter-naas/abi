personnel:BirthProcess a owl:Class,
        owl:Ontology ;
    rdfs:label "Birth Process"@en ;
    abi:ontologyResource "ontologies/processes/BirthProcess.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
    abi:pythonResource "ontologies/processes/BirthProcess.py" ;
    dc:contributor "Alice Dupont",
        "Emma Petit",
        "Grace Lambert" ;
    dc:date "2026-08-13"^^xsd:date ;
    dcterms:description "Process slice for birth. Separates three occurrents: Birth (natural process, one per person), Birth Declaration Act (evidential source), and Birth Process (ledger entry that concretizes a BirthRecord). Shared classes (BirthRecord, qualities, kinship, names) live in PersonnelOntology; this file restricts them in context."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://github.com/NCOR-Organization/BFO-Process-Ledger/blob/master/src/ontology/bpl-processes/personnel/BirthRegistration.ttl> ;
    dcterms:title "Birth Process Ontology"@en ;
    rdfs:comment "Process slice for birth. Reuses shared personnel classes."@en,
        "WHY is omitted here: BirthFunction and NewbornDisposition are realized by the natural Birth, not by the ledger entry. HOW WE KNOW is the BirthRecord this process concretizes."@en ;
    rdfs:member "bpl-processes/personnel" ;
    rdfs:seeAlso personnel:PersonnelOntology ;
    rdfs:subClassOf [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        [ ],
        cco:ont00000228 ;
    owl:imports abi:Ontology,
        cco:AgentOntology,
        cco:EventOntology,
        cco:ExtendedRelationOntology,
        cco:InformationEntityOntology ;
    skos:definition "A Planned Act in which the content asserted by a birth declaration act is entered into the personnel ledger, producing a birth record."@en ;
    skos:example "The personnel agent writes Jeremy's birth record on 2026-08-13 from Florent's declaration."@en .

