@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix intentMapping: <http://ontology.naas.ai/intentMapping/> .

#################################################################
#  Personnel (S1) Queries
#  Data: GRAPH <http://ontology.naas.ai/graph/personnel>
#  Schema: <http://ontology.naas.ai/personnel/>
#
#  Person vs employee role vs employment record
#  --------------------------------------------
#  The graph keeps three things apart that HR systems usually merge.
#
#    abi:Person                    the human being; survives any employer
#    personnel:EmployeeRole        inheres in that person while employed
#    personnel:EmploymentRecord    the document that reports the relationship
#
#  Consequences for querying: counting abi:Person is a headcount of people
#  ever recorded, not of current staff. Counting personnel:EmploymentRecord
#  double-counts anyone rehired or transferred between entities. Current
#  headcount means employment records with no personnel:termination_date, which
#  is what find_active_employees does.
#
#  personnel:JobPosition may be vacant - it is defined by the organization and
#  needs no bearer. Queries over positions therefore do NOT join through a
#  person unless they mean to exclude open requisitions.
#################################################################

#-----------------------------------------------------------------
# Roster queries
#-----------------------------------------------------------------

intentMapping:findActiveEmployeesQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_active_employees"@en ;
    intentMapping:intentDescription "Return the people currently employed, i.e. those whose employment record carries no termination date. Useful to answer 'who works here right now?' or 'what is our current headcount?'. Employment records that have been terminated are excluded." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?employeeId ?jobTitle ?hireDate ?statusValue
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    personnel:hasEmploymentRecord ?record .
            ?record personnel:employee_id ?employeeId .
            FILTER NOT EXISTS { ?record personnel:termination_date ?anyEnd }
            OPTIONAL { ?person rdfs:label ?personLabel . }
            OPTIONAL { ?record personnel:hire_date ?hireDate . }
            OPTIONAL {
              ?person personnel:hasEmployeeRole ?role .
              ?role personnel:hasJobPosition ?position .
              ?position personnel:job_title ?jobTitle .
            }
            OPTIONAL {
              ?person personnel:hasEmploymentStatus ?status .
              ?status personnel:status_value ?statusValue .
            }
          }
        }
        ORDER BY ?personLabel
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

intentMapping:findEmployeeByIdQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_employee_by_id"@en ;
    intentMapping:intentDescription "Look up a single person by their employee id and return their employment record, position and status. Returns terminated employees too, flagged by the ?terminationDate column." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?employeeId ?jobTitle ?hireDate ?terminationDate ?statusValue ?organizationLabel
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?record personnel:employee_id ?employeeId .
            FILTER(STR(?employeeId) = "{{ employee_id }}")
            ?record personnel:isEmploymentRecordOf ?person .
            OPTIONAL { ?person rdfs:label ?personLabel . }
            OPTIONAL { ?record personnel:hire_date ?hireDate . }
            OPTIONAL { ?record personnel:termination_date ?terminationDate . }
            OPTIONAL {
              ?person personnel:hasEmployeeRole ?role .
              ?role personnel:hasJobPosition ?position .
              ?position personnel:job_title ?jobTitle .
            }
            OPTIONAL {
              ?person personnel:hasEmploymentStatus ?status .
              ?status personnel:status_value ?statusValue .
            }
            OPTIONAL {
              ?person personnel:isEmployedBy ?organization .
              ?organization rdfs:label ?organizationLabel .
            }
          }
        }
    """ ;
    intentMapping:hasArgument intentMapping:personnelEmployeeIdArg .

intentMapping:findEmployeesByStatusQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_employees_by_status"@en ;
    intentMapping:intentDescription "Return the people whose employment status matches a given value, e.g. 'active', 'on-leave', 'notice-period' or 'terminated'. Useful to answer 'who is on leave?' or 'who is serving notice?'." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?employeeId ?statusValue ?jobTitle
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    personnel:hasEmploymentStatus ?status .
            ?status personnel:status_value ?statusValue .
            FILTER(LCASE(STR(?statusValue)) = LCASE("{{ status_value }}"))
            OPTIONAL { ?person rdfs:label ?personLabel . }
            OPTIONAL {
              ?person personnel:hasEmploymentRecord ?record .
              ?record personnel:employee_id ?employeeId .
            }
            OPTIONAL {
              ?person personnel:hasEmployeeRole ?role .
              ?role personnel:hasJobPosition ?position .
              ?position personnel:job_title ?jobTitle .
            }
          }
        }
        ORDER BY ?personLabel
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelStatusValueArg ,
                              intentMapping:personnelLimitArg .

intentMapping:findEmployeesByOrganizationQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_employees_by_organization"@en ;
    intentMapping:intentDescription "Return the people employed by an organization whose name contains a given substring. Useful to answer 'who works at <company>?' across a group with several legal entities. Includes terminated employees; filter on ?terminationDate to exclude them." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?organization ?organizationLabel ?employeeId ?terminationDate
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    personnel:isEmployedBy ?organization .
            ?organization rdfs:label ?organizationLabel .
            FILTER(CONTAINS(LCASE(STR(?organizationLabel)), LCASE("{{ organization_name }}")))
            OPTIONAL { ?person rdfs:label ?personLabel . }
            OPTIONAL {
              ?person personnel:hasEmploymentRecord ?record .
              ?record personnel:employee_id ?employeeId .
              OPTIONAL { ?record personnel:termination_date ?terminationDate . }
            }
          }
        }
        ORDER BY ?organizationLabel ?personLabel
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelOrganizationNameArg ,
                              intentMapping:personnelLimitArg .

intentMapping:findEmployeeRosterQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_employee_roster"@en ;
    intentMapping:intentDescription "Return every person with an employment record together with their current job family, status, organization and employee role. Unlike find_active_employees, no status or termination filter is applied, so dashboards can show the full status mix." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?personLabel ?employeeId ?jobTitle ?jobFamily ?hireDate ?statusValue ?organizationLabel ?role
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    personnel:hasEmploymentRecord ?record .
            ?record personnel:employee_id ?employeeId .
            OPTIONAL { ?person rdfs:label ?personLabel . }
            OPTIONAL { ?record personnel:hire_date ?hireDate . }
            # job_family marks the person's current post, so this join picks out
            # exactly one position even when they have held many.
            ?person personnel:hasEmployeeRole ?role .
            ?role personnel:hasJobPosition ?position .
            ?position personnel:job_family ?jobFamily .
            OPTIONAL { ?position personnel:job_title ?jobTitle . }
            OPTIONAL {
              ?person personnel:hasEmploymentStatus ?status .
              ?status personnel:status_value ?statusValue .
            }
            OPTIONAL {
              ?person personnel:isEmployedBy ?org .
              ?org rdfs:label ?organizationLabel .
            }
          }
        }
        ORDER BY ?personLabel
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

#-----------------------------------------------------------------
# Position queries
#-----------------------------------------------------------------

intentMapping:findOpenJobPositionsQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_open_job_positions"@en ;
    intentMapping:intentDescription "Return the job positions that no employee role currently fills - the open requisitions. Useful to answer 'what roles are we hiring for?'. A position is open when no personnel:EmployeeRole points at it via personnel:hasJobPosition." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?position ?jobTitle ?jobFamily ?descriptionLabel
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?position rdf:type personnel:JobPosition ;
                      personnel:job_title ?jobTitle .
            FILTER NOT EXISTS { ?position personnel:isJobPositionOf ?anyRole }
            OPTIONAL { ?position personnel:job_family ?jobFamily . }
            OPTIONAL {
              ?position personnel:hasJobDescription ?description .
              ?description rdfs:label ?descriptionLabel .
            }
          }
        }
        ORDER BY ?jobTitle
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

intentMapping:findPositionsByTitleQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_positions_by_title"@en ;
    intentMapping:intentDescription "Return job positions whose title contains a given substring, together with whoever currently fills each one. Vacant positions are returned with an empty ?person column." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?position ?jobTitle ?jobFamily ?person ?personLabel
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?position rdf:type personnel:JobPosition ;
                      personnel:job_title ?jobTitle .
            FILTER(CONTAINS(LCASE(STR(?jobTitle)), LCASE("{{ job_title }}")))
            OPTIONAL { ?position personnel:job_family ?jobFamily . }
            OPTIONAL {
              ?position personnel:isJobPositionOf ?role .
              ?role personnel:isEmployeeRoleOf ?person .
              OPTIONAL { ?person rdfs:label ?personLabel . }
            }
          }
        }
        ORDER BY ?jobTitle
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelJobTitleArg ,
                              intentMapping:personnelLimitArg .

intentMapping:findHeadcountByJobFamilyQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_headcount_by_job_family"@en ;
    intentMapping:intentDescription "Return the number of currently-employed people per job family, largest first. Useful to answer 'how is the org split across disciplines?'. Counts distinct people whose employment record carries no termination date, so it is a true headcount rather than a count of records." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT ?jobFamily (COUNT(DISTINCT ?person) AS ?headcount)
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    personnel:hasEmploymentRecord ?record ;
                    personnel:hasEmployeeRole ?role .
            FILTER NOT EXISTS { ?record personnel:termination_date ?anyEnd }
            ?role personnel:hasJobPosition ?position .
            ?position personnel:job_family ?jobFamily .
          }
        }
        GROUP BY ?jobFamily
        ORDER BY DESC(?headcount)
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

#-----------------------------------------------------------------
# Process queries
#-----------------------------------------------------------------

intentMapping:findWorkingProcessesQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_working_processes"@en ;
    intentMapping:intentDescription "Return every act of working with the seven buckets it ties together: the person performing the work and the organization they work for (WHO), the site (WHERE), the temporal region and its bounding instants (WHEN), the employee role and the mission that role concretizes (WHY), the skills developed (HOW IT IS), and the contract and profile document it was sourced from (HOW WE KNOW). Backed by the ActOfWorkingProcess ontology." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?working ?workingLabel ?org ?orgLabel ?site ?siteLabel
                        ?temporal ?temporalLabel ?temporalStart ?temporalEnd ?durationLabel
                        ?firstInstant ?firstInstantLabel ?lastInstant ?lastInstantLabel
                        ?contract ?contractLabel ?contractType
                        ?role ?roleLabel ?position ?positionLabel ?jobTitle
                        ?mission ?missionLabel ?missionContent
                        ?profile ?profileLabel ?sourceUrl
                        ?remuneration ?remunerationLabel ?remunerationAmount ?remunerationCurrency
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    rdfs:label ?personLabel ;
                    personnel:hasActOfWorking ?working .
            ?working rdf:type personnel:ActOfWorking .
            OPTIONAL { ?working rdfs:label ?workingLabel . }
            OPTIONAL { ?working personnel:forOrganization ?org . ?org rdfs:label ?orgLabel . }
            OPTIONAL { ?working abi:occursIn ?site . ?site rdfs:label ?siteLabel . }
            OPTIONAL {
              ?working abi:occupiesTemporalRegion ?temporal .
              ?temporal rdfs:label ?temporalLabel .
              OPTIONAL { ?temporal personnel:duration_label ?durationLabel . }
              OPTIONAL {
                ?temporal abi:hasFirstInstant ?firstInstant .
                ?firstInstant personnel:instant_date ?temporalStart .
                OPTIONAL { ?firstInstant rdfs:label ?firstInstantLabel . }
              }
              # An ongoing experience has no last instant: the region stays open.
              OPTIONAL {
                ?temporal abi:hasLastInstant ?lastInstant .
                ?lastInstant personnel:instant_date ?temporalEnd .
                OPTIONAL { ?lastInstant rdfs:label ?lastInstantLabel . }
              }
            }
            OPTIONAL {
              ?working personnel:hasContract ?contract .
              ?contract rdfs:label ?contractLabel .
              OPTIONAL { ?contract personnel:contract_type ?contractType . }
            }
            # Reached through the act, not through the person: a person bears one
            # employee role per job, so joining on the person would cross-join
            # every role against every act of working they ever performed.
            OPTIONAL {
              ?working abi:realizes ?role .
              OPTIONAL { ?role rdfs:label ?roleLabel . }
              OPTIONAL {
                ?role personnel:hasJobPosition ?position .
                ?position rdfs:label ?positionLabel .
                OPTIONAL { ?position personnel:job_title ?jobTitle . }
              }
              OPTIONAL {
                ?role personnel:hasMission ?mission .
                ?mission rdfs:label ?missionLabel .
                OPTIONAL { ?mission personnel:mission_content ?missionContent . }
                OPTIONAL {
                  ?mission personnel:isSourcedFrom ?profile .
                  ?profile rdfs:label ?profileLabel .
                  OPTIONAL { ?profile personnel:source_url ?sourceUrl . }
                }
              }
            }
            OPTIONAL {
              ?working abi:hasParticipant ?remuneration .
              ?remuneration a personnel:Remuneration ; rdfs:label ?remunerationLabel .
              OPTIONAL { ?remuneration personnel:remuneration_amount ?remunerationAmount . }
              OPTIONAL { ?remuneration personnel:remuneration_currency ?remunerationCurrency . }
            }
          }
        }
        ORDER BY ?personLabel DESC(?temporalStart)
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

intentMapping:findSkillsDevelopedQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_skills_developed"@en ;
    intentMapping:intentDescription "Return every skill a person bears together with each act of working in which it was developed. A skill exercised across several jobs yields one row per job, which is what links those jobs to one another in the graph. Backed by the ActOfWorkingProcess ontology." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?personLabel ?skill ?skillLabel ?working ?orgLabel
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    rdfs:label ?personLabel ;
                    personnel:hasSkill ?skill .
            ?skill rdf:type personnel:Skill ; rdfs:label ?skillLabel .
            OPTIONAL {
              ?skill personnel:isSkillDevelopedIn ?working .
              OPTIONAL { ?working personnel:forOrganization ?org . ?org rdfs:label ?orgLabel . }
            }
          }
        }
        ORDER BY ?personLabel ?skillLabel
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

intentMapping:findActsOfStudyingQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_acts_of_studying"@en ;
    intentMapping:intentDescription "Return every act of studying: the person enrolled, the educational organization, site, temporal region, enrollment record, programme name, and student role. Backed by the ActOfStudyingProcess ontology." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?studying ?studyingLabel ?org ?orgLabel ?site ?siteLabel
                        ?temporal ?temporalLabel ?temporalStart ?temporalEnd ?durationLabel
                        ?firstInstant ?firstInstantLabel ?lastInstant ?lastInstantLabel
                        ?enrollment ?enrollmentLabel ?programName ?activitiesContent
                        ?role ?roleLabel
                        ?degree ?degreeLabel
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    rdfs:label ?personLabel ;
                    personnel:hasActOfStudying ?studying .
            ?studying rdf:type personnel:ActOfStudying .
            OPTIONAL { ?studying rdfs:label ?studyingLabel . }
            OPTIONAL { ?studying personnel:forEducationalOrganization ?org . ?org rdfs:label ?orgLabel . }
            OPTIONAL { ?studying abi:occursIn ?site . ?site rdfs:label ?siteLabel . }
            OPTIONAL {
              ?studying abi:occupiesTemporalRegion ?temporal .
              ?temporal rdfs:label ?temporalLabel .
              OPTIONAL { ?temporal personnel:duration_label ?durationLabel . }
              OPTIONAL {
                ?temporal abi:hasFirstInstant ?firstInstant .
                ?firstInstant personnel:instant_date ?temporalStart .
                OPTIONAL { ?firstInstant rdfs:label ?firstInstantLabel . }
              }
              OPTIONAL {
                ?temporal abi:hasLastInstant ?lastInstant .
                ?lastInstant personnel:instant_date ?temporalEnd .
                OPTIONAL { ?lastInstant rdfs:label ?lastInstantLabel . }
              }
            }
            OPTIONAL {
              ?studying personnel:hasEnrollment ?enrollment .
              ?enrollment rdfs:label ?enrollmentLabel .
              OPTIONAL { ?enrollment personnel:program_name ?programName . }
              OPTIONAL { ?enrollment personnel:activities_content ?activitiesContent . }
            }
            OPTIONAL {
              ?studying abi:realizes ?role .
              OPTIONAL { ?role rdfs:label ?roleLabel . }
            }
            OPTIONAL {
              ?studying personnel:hasDegree ?degree .
              ?degree rdfs:label ?degreeLabel .
            }
          }
        }
        ORDER BY ?personLabel DESC(?temporalStart)
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

#-----------------------------------------------------------------
# Profile queries
#
# One query per section of a published profile. Each returns rows for
# every person unless a person_slug is given, so the same query serves
# both the directory export and a single profile page.
#
# Sections a person has nothing for return no rows. That is the answer,
# not an error: a profile with no recommendations is not a profile with
# unknown recommendations, and the app says so rather than leaving a gap.
#-----------------------------------------------------------------

intentMapping:findPeopleDirectoryQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_people_directory"@en ;
    intentMapping:intentDescription "Return one row per person for a people directory: slug, name, headline, summary, quote, portrait, employer, office and country, service line, grade and years of experience. Useful to answer 'who is in the directory?' or to build a searchable index of people. Every field beyond the person and their label is optional, so someone with only a name is still returned." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?slug ?headline ?about ?quote ?yearsOfExperience
                        ?portraitUrl ?portraitPath
                        ?organizationLabel ?serviceLineLabel ?gradeValue
                        ?officeLabel ?cityName ?countryName ?countryCode
                        ?profileUrl
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    rdfs:label ?personLabel .
            OPTIONAL { ?person personnel:profile_slug ?slug . }
            OPTIONAL {
              ?person personnel:hasProfileSummary ?summary .
              OPTIONAL { ?summary personnel:headline_text ?headline . }
              OPTIONAL { ?summary personnel:summary_content ?about . }
              OPTIONAL { ?summary personnel:quote_content ?quote . }
              OPTIONAL { ?summary personnel:years_of_experience ?yearsOfExperience . }
              OPTIONAL { ?summary personnel:isSourcedFrom ?profileDoc . ?profileDoc personnel:source_url ?profileUrl . }
            }
            OPTIONAL {
              ?person personnel:hasPortrait ?portrait .
              OPTIONAL { ?portrait personnel:portrait_url ?portraitUrl . }
              OPTIONAL { ?portrait personnel:portrait_path ?portraitPath . }
            }
            OPTIONAL { ?person personnel:isEmployedBy ?org . ?org rdfs:label ?organizationLabel . }
            # Read the service line from membership, not from an employee role:
            # a person in the directory may have no recorded job yet.
            OPTIONAL {
              ?serviceLine rdf:type personnel:ServiceLine ;
                           abi:hasMemberPart ?person ;
                           rdfs:label ?serviceLineLabel .
            }
            OPTIONAL { ?person personnel:hasGrade ?grade . ?grade personnel:grade_value ?gradeValue . }
            # personnel:hasWorkLocation reaches every site the person has worked
            # at. The one that says where they are based is the one whose place
            # has been stated, so bind that and leave the rest to the acts of
            # working they belong to.
            OPTIONAL {
              ?person personnel:hasWorkLocation ?site .
              FILTER EXISTS {
                ?site ?placeProperty ?placeValue .
                FILTER(?placeProperty IN (personnel:office_label, personnel:city_name,
                                          personnel:country_name, personnel:country_code))
              }
              OPTIONAL { ?site personnel:office_label ?officeLabel . }
              OPTIONAL { ?site personnel:city_name ?cityName . }
              OPTIONAL { ?site personnel:country_name ?countryName . }
              OPTIONAL { ?site personnel:country_code ?countryCode . }
            }
          }
        }
        ORDER BY ?personLabel
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

intentMapping:findProfileHeaderQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_profile_header"@en ;
    intentMapping:intentDescription "Return the header of one person's profile, identified by their profile slug: name, headline, summary, quote, portrait, employer, office and country, service line, grade and years of experience. Useful to answer 'who is alice_dupont?' before asking for their experience or skills." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?slug ?headline ?about ?quote ?yearsOfExperience
                        ?portraitUrl ?portraitPath
                        ?organizationLabel ?serviceLineLabel ?gradeValue
                        ?officeLabel ?cityName ?countryName ?countryCode
                        ?profileUrl
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    rdfs:label ?personLabel ;
                    personnel:profile_slug ?slug .
            FILTER(LCASE(STR(?slug)) = LCASE("{{ person_slug }}"))
            OPTIONAL {
              ?person personnel:hasProfileSummary ?summary .
              OPTIONAL { ?summary personnel:headline_text ?headline . }
              OPTIONAL { ?summary personnel:summary_content ?about . }
              OPTIONAL { ?summary personnel:quote_content ?quote . }
              OPTIONAL { ?summary personnel:years_of_experience ?yearsOfExperience . }
              OPTIONAL { ?summary personnel:isSourcedFrom ?profileDoc . ?profileDoc personnel:source_url ?profileUrl . }
            }
            OPTIONAL {
              ?person personnel:hasPortrait ?portrait .
              OPTIONAL { ?portrait personnel:portrait_url ?portraitUrl . }
              OPTIONAL { ?portrait personnel:portrait_path ?portraitPath . }
            }
            OPTIONAL { ?person personnel:isEmployedBy ?org . ?org rdfs:label ?organizationLabel . }
            # Read the service line from membership, not from an employee role:
            # a person in the directory may have no recorded job yet.
            OPTIONAL {
              ?serviceLine rdf:type personnel:ServiceLine ;
                           abi:hasMemberPart ?person ;
                           rdfs:label ?serviceLineLabel .
            }
            OPTIONAL { ?person personnel:hasGrade ?grade . ?grade personnel:grade_value ?gradeValue . }
            # personnel:hasWorkLocation reaches every site the person has worked
            # at. The one that says where they are based is the one whose place
            # has been stated, so bind that and leave the rest to the acts of
            # working they belong to.
            OPTIONAL {
              ?person personnel:hasWorkLocation ?site .
              FILTER EXISTS {
                ?site ?placeProperty ?placeValue .
                FILTER(?placeProperty IN (personnel:office_label, personnel:city_name,
                                          personnel:country_name, personnel:country_code))
              }
              OPTIONAL { ?site personnel:office_label ?officeLabel . }
              OPTIONAL { ?site personnel:city_name ?cityName . }
              OPTIONAL { ?site personnel:country_name ?countryName . }
              OPTIONAL { ?site personnel:country_code ?countryCode . }
            }
          }
        }
        LIMIT 1
    """ ;
    intentMapping:hasArgument intentMapping:personnelPersonSlugArg .

intentMapping:findPersonSkillsQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_person_skills"@en ;
    intentMapping:intentDescription "Return the skills each person bears, one row per person and skill, without joining through the acts of working in which they were developed. Useful to answer 'who knows Python?' or to list someone's skills. Use find_skills_developed instead when the question is where a skill was acquired." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?slug ?skillLabel
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    rdfs:label ?personLabel ;
                    personnel:hasSkill ?skill .
            ?skill rdf:type personnel:Skill ; rdfs:label ?skillLabel .
            OPTIONAL { ?person personnel:profile_slug ?slug . }
          }
        }
        ORDER BY ?personLabel ?skillLabel
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

intentMapping:findCertificationsQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_certifications"@en ;
    intentMapping:intentDescription "Return the certifications and licences people hold: the certification name, the organization that issued it, the date it was issued, the date it expires, its status and where it can be verified. Useful to answer 'who is a certified auditor?' or 'what licences does this person hold?'." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?slug ?certification ?certificationName
                        ?issuerLabel ?issueDate ?expiryDate ?certificationStatus ?credentialId ?credentialUrl
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    rdfs:label ?personLabel ;
                    personnel:hasCertification ?certification .
            OPTIONAL { ?person personnel:profile_slug ?slug . }
            OPTIONAL { ?certification personnel:certification_name ?certificationName . }
            OPTIONAL { ?certification personnel:issuedByOrganization ?issuer . ?issuer rdfs:label ?issuerLabel . }
            OPTIONAL { ?certification personnel:issue_date ?issueDate . }
            OPTIONAL { ?certification personnel:expiry_date ?expiryDate . }
            OPTIONAL { ?certification personnel:certification_status ?certificationStatus . }
            OPTIONAL { ?certification personnel:credential_id ?credentialId . }
            OPTIONAL { ?certification personnel:credential_url ?credentialUrl . }
          }
        }
        ORDER BY ?personLabel DESC(?issueDate) ?certificationName
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

intentMapping:findLanguagesQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_languages"@en ;
    intentMapping:intentDescription "Return the languages people can work in, with the proficiency each source states. Useful to answer 'who speaks Spanish?' or 'what languages does this person work in?'. Proficiency is free text because sources report it in incompatible scales." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?slug ?capability ?languageName ?proficiencyLevel ?languageLabel
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    rdfs:label ?personLabel ;
                    personnel:hasLanguageCapability ?capability .
            OPTIONAL { ?person personnel:profile_slug ?slug . }
            OPTIONAL { ?capability personnel:language_name ?languageName . }
            OPTIONAL { ?capability personnel:proficiency_level ?proficiencyLevel . }
            OPTIONAL { ?capability personnel:ofLanguage ?language . ?language rdfs:label ?languageLabel . }
          }
        }
        ORDER BY ?personLabel ?languageName
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

intentMapping:findRecommendationsQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_recommendations"@en ;
    intentMapping:intentDescription "Return the recommendations written about people: who wrote each one, how the author describes the working relationship, when it was written and its full text. Useful to answer 'what do colleagues say about this person?'. A person with no recommendations returns no rows." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?slug ?recommendation ?authorLabel ?authorHeadline
                        ?relationshipLabel ?recommendationDate ?recommendationContent
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    rdfs:label ?personLabel ;
                    personnel:hasRecommendation ?recommendation .
            OPTIONAL { ?person personnel:profile_slug ?slug . }
            OPTIONAL {
              ?recommendation personnel:hasRecommendationAuthor ?author .
              ?author rdfs:label ?authorLabel .
              OPTIONAL {
                ?author personnel:hasProfileSummary ?authorSummary .
                ?authorSummary personnel:headline_text ?authorHeadline .
              }
            }
            OPTIONAL { ?recommendation personnel:relationship_label ?relationshipLabel . }
            OPTIONAL { ?recommendation personnel:recommendation_date ?recommendationDate . }
            OPTIONAL { ?recommendation personnel:recommendation_content ?recommendationContent . }
          }
        }
        ORDER BY ?personLabel DESC(?recommendationDate)
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

intentMapping:findInterestsQuery a intentMapping:TemplatableSparqlQuery ;
    rdfs:label "find_interests"@en ;
    intentMapping:intentDescription "Return what people follow or care about outside the duties of any one job, with the kind of thing each interest is in and, where the graph holds one, the entity it points at. Useful to answer 'what is this person interested in?'." ;
    intentMapping:sparqlTemplate """
        PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX abi:  <http://ontology.naas.ai/abi/>
        PREFIX personnel: <http://ontology.naas.ai/personnel/>

        SELECT DISTINCT ?person ?personLabel ?slug ?interest ?interestName ?interestDescription ?interestKind ?targetLabel
        WHERE {
          GRAPH <http://ontology.naas.ai/graph/personnel> {
            ?person rdf:type abi:Person ;
                    rdfs:label ?personLabel ;
                    personnel:hasInterest ?interest .
            OPTIONAL { ?person personnel:profile_slug ?slug . }
            OPTIONAL { ?interest personnel:interest_name ?interestName . }
            OPTIONAL { ?interest personnel:interest_description ?interestDescription . }
            OPTIONAL { ?interest personnel:interest_kind ?interestKind . }
            OPTIONAL { ?interest personnel:hasInterestTarget ?target . ?target rdfs:label ?targetLabel . }
          }
        }
        ORDER BY ?personLabel ?interestName
        LIMIT {{ limit }}
    """ ;
    intentMapping:hasArgument intentMapping:personnelLimitArg .

#-----------------------------------------------------------------
# Query arguments
#
# TemplatableSparqlQueryLoader requires all four predicates below on
# every argument; an argument missing one is not loaded, and the query
# that references it then renders with its placeholder unfilled.
# validationPattern is matched against the raw value before substitution
# - keep it tight enough to block injection.
#-----------------------------------------------------------------

intentMapping:personnelLimitArg a intentMapping:QueryArgument ;
    intentMapping:argumentName "limit" ;
    intentMapping:argumentDescription "Maximum number of rows to return (positive integer)." ;
    intentMapping:validationPattern "^[1-9][0-9]{0,3}$" ;
    intentMapping:validationFormat "integer" .

intentMapping:personnelPersonSlugArg a intentMapping:QueryArgument ;
    intentMapping:argumentName "person_slug" ;
    intentMapping:argumentDescription "Profile slug of one person, e.g. 'alice_dupont'. Lowercase ASCII letters, digits and underscores." ;
    intentMapping:validationPattern "^[a-z][a-z0-9_]{0,63}$" ;
    intentMapping:validationFormat "person_slug" .

intentMapping:personnelEmployeeIdArg a intentMapping:QueryArgument ;
    intentMapping:argumentName "employee_id" ;
    intentMapping:argumentDescription "Identifier an employing organization assigned to a person, e.g. 'E-10428'." ;
    intentMapping:validationPattern "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" ;
    intentMapping:validationFormat "employee_id" .

intentMapping:personnelStatusValueArg a intentMapping:QueryArgument ;
    intentMapping:argumentName "status_value" ;
    intentMapping:argumentDescription "Employment status to filter on, e.g. 'active', 'on-leave', 'notice-period', 'terminated'." ;
    intentMapping:validationPattern "^[A-Za-z][A-Za-z -]{0,63}$" ;
    intentMapping:validationFormat "status_value" .

intentMapping:personnelOrganizationNameArg a intentMapping:QueryArgument ;
    intentMapping:argumentName "organization_name" ;
    intentMapping:argumentDescription "Name of an organization to filter on, matched case-insensitively." ;
    intentMapping:validationPattern "^[^\\\\\"{}]{1,128}$" ;
    intentMapping:validationFormat "organization_name" .

intentMapping:personnelJobTitleArg a intentMapping:QueryArgument ;
    intentMapping:argumentName "job_title" ;
    intentMapping:argumentDescription "Job title, or part of one, to match against published positions." ;
    intentMapping:validationPattern "^[^\\\\\"{}]{1,128}$" ;
    intentMapping:validationFormat "job_title" .
