@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:    <http://purl.org/dc/terms/> .
@prefix dc11:  <http://purl.org/dc/elements/1.1/> .
@prefix bfo:   <http://purl.obolibrary.org/obo/> .
@prefix cco:   <https://www.commoncoreontologies.org/> .
@prefix abi:   <http://ontology.naas.ai/abi/> .
@prefix personnel: <http://ontology.naas.ai/personnel/> .

personnel:PersonnelOntology a owl:Ontology ;
  # One owl:imports statement per IRI - onto2py's codegen pre-scan only matches
  # an IRI directly after the `owl:imports` keyword.
  owl:imports <http://ontology.naas.ai/abi/Ontology> ;
  owl:imports <https://www.commoncoreontologies.org/QualityOntology> ;
  owl:imports <https://www.commoncoreontologies.org/InformationEntityOntology> ;
  owl:imports <https://www.commoncoreontologies.org/AgentOntology> ;
  owl:imports <https://www.commoncoreontologies.org/FacilityOntology> ;
  owl:imports <http://ontology.naas.ai/personnel/ActOfWorkingProcess> ;
  owl:imports <http://ontology.naas.ai/personnel/ActOfStudyingProcess> ;
  owl:imports <http://ontology.naas.ai/personnel/ActOfPersonnelProfilingProcess> ;
  owl:imports <http://ontology.naas.ai/personnel/ActOfCertificationProcess> ;
  rdfs:seeAlso <https://raw.githubusercontent.com/jupyter-naas/abi/refs/heads/main/libs/naas-abi-marketplace/naas_abi_marketplace/domains/personnel/ontologies/modules/PersonnelOntology.ttl> ;
  abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
  abi:ontologyResource "ontologies/modules/PersonnelOntology.ttl" ;
  abi:pythonResource "ontologies/modules/PersonnelOntology.py" ;
  dc:title "Personnel Ontology"@en ;
  dc:description "Shared vocabulary for the personnel (S1) domain: the person, the employee and student roles they bear, the job position an employee role concretizes, and the records, contracts and qualities that outlive any one process. It also holds what a person is presented as: the profile summary and portrait published for them, the certifications they hold, the languages they speak, the interests they bear, the recommendations others write about them, and the grade and service line their employment places them in. Process slices (ActOfWorkingProcess, ActOfStudyingProcess, ActOfCertificationProcess, ActOfPersonnelProfilingProcess) import nothing from this file; this ontology imports them and they restrict these classes in context."@en ;
  dc:license <https://creativecommons.org/licenses/by/4.0/> ;
  rdfs:comment "Shared personnel classes. Process restrictions live in ontologies/processes/."@en ;
  dc11:contributor "Alice Dupont" ;
  dc11:date "2026-08-18"^^xsd:date .

#################################################################
#    Object Properties
#################################################################

# WHO ↔ HOW WE KNOW - person carries an employment record
personnel:hasEmploymentRecord a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:isCarrierOf ;
    owl:inverseOf personnel:isEmploymentRecordOf ;
    rdfs:label "has employment record"@en ;
    skos:definition "Relates a person to an employment record that generically depends on them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:EmploymentRecord .

personnel:isEmploymentRecordOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf personnel:hasEmploymentRecord ;
    rdfs:label "is employment record of"@en ;
    skos:definition "Relates an employment record to the person on which it generically depends."@en ;
    rdfs:domain personnel:EmploymentRecord ;
    rdfs:range abi:Person .

# WHO ↔ WHY - person bears an employee role
personnel:hasEmployeeRole a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:bearerOf ;
    owl:inverseOf personnel:isEmployeeRoleOf ;
    rdfs:label "has employee role"@en ;
    skos:definition "Relates a person to an employee role that inheres in them for the duration of an employment relationship."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:EmployeeRole .

personnel:isEmployeeRoleOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf personnel:hasEmployeeRole ;
    rdfs:label "is employee role of"@en ;
    skos:definition "Relates an employee role to the person in whom it inheres."@en ;
    rdfs:domain personnel:EmployeeRole ;
    rdfs:range abi:Person .

# WHO ↔ WHY - person bears a student role
personnel:hasStudentRole a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:bearerOf ;
    owl:inverseOf personnel:isStudentRoleOf ;
    rdfs:label "has student role"@en ;
    skos:definition "Relates a person to a student role that inheres in them for the duration of a course of study."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:StudentRole .

personnel:isStudentRoleOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf personnel:hasStudentRole ;
    rdfs:label "is student role of"@en ;
    skos:definition "Relates a student role to the person in whom it inheres."@en ;
    rdfs:domain personnel:StudentRole ;
    rdfs:range abi:Person .

# WHO ↔ HOW WE KNOW - person carries an enrollment record
personnel:hasEnrollmentRecord a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:isCarrierOf ;
    owl:inverseOf personnel:isEnrollmentRecordOf ;
    rdfs:label "has enrollment record"@en ;
    skos:definition "Relates a person to an enrollment record that generically depends on them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:EnrollmentRecord .

personnel:isEnrollmentRecordOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf personnel:hasEnrollmentRecord ;
    rdfs:label "is enrollment record of"@en ;
    skos:definition "Relates an enrollment record to the person on which it generically depends."@en ;
    rdfs:domain personnel:EnrollmentRecord ;
    rdfs:range abi:Person .

# WHO ↔ WHO - convenience shortcut. Backbone is Person bears EmployeeRole
# and participates in ActOfWorking; do not use this as the employment model.
personnel:employs a owl:ObjectProperty ;
    owl:inverseOf personnel:isEmployedBy ;
    rdfs:label "employs"@en ;
    skos:definition "Convenience relation from an organization to a person it employs. Derived from ActOfWorking + EmployeeRole; not a BFO primitive."@en ;
    rdfs:domain abi:Organization ;
    rdfs:range abi:Person .

personnel:isEmployedBy a owl:ObjectProperty ;
    owl:inverseOf personnel:employs ;
    rdfs:label "is employed by"@en ;
    skos:definition "Convenience relation from a person to the organization that employs them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range abi:Organization .

# WHY ↔ HOW WE KNOW - employee role concretizes the job position (GDC)
personnel:hasJobPosition a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:concretizes ;
    owl:inverseOf personnel:isJobPositionOf ;
    rdfs:label "has job position"@en ;
    skos:definition "Relates an employee role to the job position it concretizes. Named sub-property of abi:concretizes: a role (SDC) concretizes a position (GDC)."@en ;
    rdfs:domain personnel:EmployeeRole ;
    rdfs:range personnel:JobPosition .

personnel:isJobPositionOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:isConcretizedBy ;
    owl:inverseOf personnel:hasJobPosition ;
    rdfs:label "is job position of"@en ;
    skos:definition "Relates a job position to the employee role that concretizes it, when the position is occupied."@en ;
    rdfs:domain personnel:JobPosition ;
    rdfs:range personnel:EmployeeRole .

# HOW WE KNOW ↔ HOW WE KNOW - job position is described by a job description
personnel:hasJobDescription a owl:ObjectProperty ;
    owl:inverseOf personnel:isJobDescriptionOf ;
    rdfs:label "has job description"@en ;
    skos:definition "Relates a job position to the job description document that states its duties and requirements."@en ;
    rdfs:domain personnel:JobPosition ;
    rdfs:range personnel:JobDescription .

personnel:isJobDescriptionOf a owl:ObjectProperty ;
    owl:inverseOf personnel:hasJobDescription ;
    rdfs:label "is job description of"@en ;
    skos:definition "Relates a job description document to the job position it describes."@en ;
    rdfs:domain personnel:JobDescription ;
    rdfs:range personnel:JobPosition .

# HOW WE KNOW ↔ HOW WE KNOW - contract is about a job description
personnel:isAboutJobDescription a owl:ObjectProperty ;
    rdfs:subPropertyOf cco:ont00001808 ;
    owl:inverseOf personnel:isJobDescriptionOfContract ;
    rdfs:label "is about job description"@en ;
    skos:definition "Relates an employment contract to the job description it is about."@en ;
    rdfs:domain personnel:EmploymentContract ;
    rdfs:range personnel:JobDescription .

personnel:isJobDescriptionOfContract a owl:ObjectProperty ;
    owl:inverseOf personnel:isAboutJobDescription ;
    rdfs:label "is job description of contract"@en ;
    skos:definition "Relates a job description to an employment contract that is about it."@en ;
    rdfs:domain personnel:JobDescription ;
    rdfs:range personnel:EmploymentContract .

# WHO ↔ HOW IT IS - person bears an employment status
personnel:hasEmploymentStatus a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:bearerOf ;
    owl:inverseOf personnel:isEmploymentStatusOf ;
    rdfs:label "has employment status"@en ;
    skos:definition "Relates a person to the employment status quality that inheres in them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:EmploymentStatus .

personnel:isEmploymentStatusOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf personnel:hasEmploymentStatus ;
    rdfs:label "is employment status of"@en ;
    skos:definition "Relates an employment status quality to the person in whom it inheres."@en ;
    rdfs:domain personnel:EmploymentStatus ;
    rdfs:range abi:Person .

# WHO ↔ HOW WE KNOW - person carries a certification
personnel:hasCertification a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:isCarrierOf ;
    owl:inverseOf personnel:isCertificationOf ;
    rdfs:label "has certification"@en ;
    skos:definition "Relates a person to a certification that generically depends on them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:Certification .

personnel:isCertificationOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf personnel:hasCertification ;
    rdfs:label "is certification of"@en ;
    skos:definition "Relates a certification to the person on which it generically depends."@en ;
    rdfs:domain personnel:Certification ;
    rdfs:range abi:Person .

# HOW WE KNOW ↔ WHO - certification is issued by an organization
personnel:issuedByOrganization a owl:ObjectProperty ;
    owl:inverseOf personnel:isIssuerOfCertification ;
    rdfs:label "issued by organization"@en ;
    skos:definition "Relates a certification to the organization that issued it and stands behind what it attests."@en ;
    rdfs:domain personnel:Certification ;
    rdfs:range abi:Organization .

personnel:isIssuerOfCertification a owl:ObjectProperty ;
    owl:inverseOf personnel:issuedByOrganization ;
    rdfs:label "is issuer of certification"@en ;
    skos:definition "Relates an organization to a certification it issued."@en ;
    rdfs:domain abi:Organization ;
    rdfs:range personnel:Certification .

# WHO ↔ HOW IT IS - person bears a language capability
personnel:hasLanguageCapability a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:bearerOf ;
    owl:inverseOf personnel:isLanguageCapabilityOf ;
    rdfs:label "has language capability"@en ;
    skos:definition "Relates a person to a language capability that inheres in them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:LanguageCapability .

personnel:isLanguageCapabilityOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf personnel:hasLanguageCapability ;
    rdfs:label "is language capability of"@en ;
    skos:definition "Relates a language capability to the person in whom it inheres."@en ;
    rdfs:domain personnel:LanguageCapability ;
    rdfs:range abi:Person .

# HOW IT IS ↔ HOW WE KNOW - language capability is held for one language
personnel:ofLanguage a owl:ObjectProperty ;
    owl:inverseOf personnel:isLanguageOfCapability ;
    rdfs:label "of language"@en ;
    skos:definition "Relates a language capability to the language it is held for. The language is a CCO Language: a directive information content entity prescribing a canonical format for communication, shared by every speaker of it."@en ;
    rdfs:domain personnel:LanguageCapability ;
    rdfs:range cco:ont00001175 .

personnel:isLanguageOfCapability a owl:ObjectProperty ;
    owl:inverseOf personnel:ofLanguage ;
    rdfs:label "is language of capability"@en ;
    skos:definition "Relates a language to a capability held for it by some person."@en ;
    rdfs:domain cco:ont00001175 ;
    rdfs:range personnel:LanguageCapability .

# WHO ↔ HOW WE KNOW - person is the subject of a recommendation
personnel:hasRecommendation a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:isCarrierOf ;
    owl:inverseOf personnel:isRecommendationOf ;
    rdfs:label "has recommendation"@en ;
    skos:definition "Relates a person to a recommendation written about them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:Recommendation .

personnel:isRecommendationOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf personnel:hasRecommendation ;
    rdfs:label "is recommendation of"@en ;
    skos:definition "Relates a recommendation to the person it is about."@en ;
    rdfs:domain personnel:Recommendation ;
    rdfs:range abi:Person .

# HOW WE KNOW ↔ WHO - recommendation was written by a person
personnel:hasRecommendationAuthor a owl:ObjectProperty ;
    owl:inverseOf personnel:isAuthorOfRecommendation ;
    rdfs:label "has recommendation author"@en ;
    skos:definition "Relates a recommendation to the person who wrote it. Distinct from the person it is about: a recommendation always has two people."@en ;
    rdfs:domain personnel:Recommendation ;
    rdfs:range abi:Person .

personnel:isAuthorOfRecommendation a owl:ObjectProperty ;
    owl:inverseOf personnel:hasRecommendationAuthor ;
    rdfs:label "is author of recommendation"@en ;
    skos:definition "Relates a person to a recommendation they wrote about someone else."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:Recommendation .

# WHO ↔ HOW IT IS - person bears an interest
personnel:hasInterest a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:bearerOf ;
    owl:inverseOf personnel:isInterestOf ;
    rdfs:label "has interest"@en ;
    skos:definition "Relates a person to an interest that inheres in them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:Interest .

personnel:isInterestOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf personnel:hasInterest ;
    rdfs:label "is interest of"@en ;
    skos:definition "Relates an interest to the person in whom it inheres."@en ;
    rdfs:domain personnel:Interest ;
    rdfs:range abi:Person .

# HOW IT IS ↔ ANY - interest points at what it is an interest in
personnel:hasInterestTarget a owl:ObjectProperty ;
    owl:inverseOf personnel:isInterestTargetOf ;
    rdfs:label "has interest target"@en ;
    skos:definition "Relates an interest to the entity it is an interest in. Deliberately unrestricted in range: an interest can be in an organization, a person, a place or a subject that has no individual in this graph, in which case only personnel:interest_name is asserted."@en ;
    rdfs:domain personnel:Interest .

personnel:isInterestTargetOf a owl:ObjectProperty ;
    owl:inverseOf personnel:hasInterestTarget ;
    rdfs:label "is interest target of"@en ;
    skos:definition "Relates an entity to an interest held in it."@en ;
    rdfs:range personnel:Interest .

# WHY ↔ WHO - employee role sits in a service line
personnel:inServiceLine a owl:ObjectProperty ;
    owl:inverseOf personnel:isServiceLineOfEmployeeRole ;
    rdfs:label "in service line"@en ;
    skos:definition "Relates an employee role to the service line of the employing organization within which it is borne."@en ;
    rdfs:domain personnel:EmployeeRole ;
    rdfs:range personnel:ServiceLine .

personnel:isServiceLineOfEmployeeRole a owl:ObjectProperty ;
    owl:inverseOf personnel:inServiceLine ;
    rdfs:label "is service line of employee role"@en ;
    skos:definition "Relates a service line to an employee role borne within it."@en ;
    rdfs:domain personnel:ServiceLine ;
    rdfs:range personnel:EmployeeRole .

# WHO ↔ WHO - organization has a service line as a member part
personnel:hasServiceLine a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:hasMemberPart ;
    owl:inverseOf personnel:isServiceLineOf ;
    rdfs:label "has service line"@en ;
    skos:definition "Relates an organization to a service line that is a member part of it."@en ;
    rdfs:domain abi:Organization ;
    rdfs:range personnel:ServiceLine .

personnel:isServiceLineOf a owl:ObjectProperty ;
    owl:inverseOf personnel:hasServiceLine ;
    rdfs:label "is service line of"@en ;
    skos:definition "Relates a service line to the organization it is a member part of."@en ;
    rdfs:domain personnel:ServiceLine ;
    rdfs:range abi:Organization .

# WHO ↔ HOW IT IS - person bears a grade
personnel:hasGrade a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:bearerOf ;
    owl:inverseOf personnel:isGradeOf ;
    rdfs:label "has grade"@en ;
    skos:definition "Relates a person to the grade quality that inheres in them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:Grade .

personnel:isGradeOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf personnel:hasGrade ;
    rdfs:label "is grade of"@en ;
    skos:definition "Relates a grade quality to the person in whom it inheres."@en ;
    rdfs:domain personnel:Grade ;
    rdfs:range abi:Person .

# WHO ↔ HOW WE KNOW - person carries a portrait
personnel:hasPortrait a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:isCarrierOf ;
    owl:inverseOf personnel:isPortraitOf ;
    rdfs:label "has portrait"@en ;
    skos:definition "Relates a person to a portrait image of them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:Portrait .

personnel:isPortraitOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf personnel:hasPortrait ;
    rdfs:label "is portrait of"@en ;
    skos:definition "Relates a portrait image to the person it depicts."@en ;
    rdfs:domain personnel:Portrait ;
    rdfs:range abi:Person .

# WHO ↔ HOW WE KNOW - person carries a profile summary
personnel:hasProfileSummary a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:isCarrierOf ;
    owl:inverseOf personnel:isProfileSummaryOf ;
    rdfs:label "has profile summary"@en ;
    skos:definition "Relates a person to the profile summary that states how they present themselves."@en ;
    rdfs:domain abi:Person ;
    rdfs:range personnel:ProfileSummary .

personnel:isProfileSummaryOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf personnel:hasProfileSummary ;
    rdfs:label "is profile summary of"@en ;
    skos:definition "Relates a profile summary to the person it is about."@en ;
    rdfs:domain personnel:ProfileSummary ;
    rdfs:range abi:Person .

# WHAT ↔ HOW IT IS - a planned act develops the skills the person bears
personnel:developsSkill a owl:ObjectProperty ;
  owl:inverseOf personnel:isSkillDevelopedIn ;
  rdfs:label "develops skill"@en ;
  skos:definition "Relates a planned act (an act of working or of studying, for one) to a skill exercised and developed in the course of it."@en ;
  rdfs:domain cco:ont00000228 ;
  rdfs:range  personnel:Skill .

personnel:isSkillDevelopedIn a owl:ObjectProperty ;
  owl:inverseOf personnel:developsSkill ;
  rdfs:label "is skill developed in"@en ;
  skos:definition "Relates a skill to a planned act in which it is exercised and developed."@en ;
  rdfs:domain personnel:Skill ;
  rdfs:range  cco:ont00000228 .

# WHAT ↔ HOW IT IS - a planned act develops the language capabilities the person bears
personnel:developsLanguageCapability a owl:ObjectProperty ;
  owl:inverseOf personnel:isLanguageCapabilityDevelopedIn ;
  rdfs:label "develops language capability"@en ;
  skos:definition "Relates a planned act (an act of working, of studying or of certification) to a language capability exercised and developed in the course of it."@en ;
  rdfs:domain cco:ont00000228 ;
  rdfs:range  personnel:LanguageCapability .

personnel:isLanguageCapabilityDevelopedIn a owl:ObjectProperty ;
  owl:inverseOf personnel:developsLanguageCapability ;
  rdfs:label "is language capability developed in"@en ;
  skos:definition "Relates a language capability to a planned act in which it is exercised and developed."@en ;
  rdfs:domain personnel:LanguageCapability ;
  rdfs:range  cco:ont00000228 .

# WHO ↔ HOW IT IS - the person bears the skill
personnel:hasSkill a owl:ObjectProperty ;
  rdfs:subPropertyOf abi:bearerOf ;
  owl:inverseOf personnel:isSkillOf ;
  rdfs:label "has skill"@en ;
  skos:definition "Relates a person to a skill quality that inheres in them."@en ;
  rdfs:domain abi:Person ;
  rdfs:range  personnel:Skill .

personnel:isSkillOf a owl:ObjectProperty ;
  rdfs:subPropertyOf abi:inheresIn ;
  owl:inverseOf personnel:hasSkill ;
  rdfs:label "is skill of"@en ;
  skos:definition "Relates a skill to the person in whom it inheres."@en ;
  rdfs:domain personnel:Skill ;
  rdfs:range  abi:Person .

# WHO ↔ HOW WE KNOW - the person carries the profile document
personnel:hasProfileDocument a owl:ObjectProperty ;
  rdfs:subPropertyOf abi:isCarrierOf ;
  owl:inverseOf personnel:isProfileDocumentOf ;
  rdfs:label "has profile document"@en ;
  skos:definition "Relates a person to a profile document that generically depends on them."@en ;
  rdfs:domain abi:Person ;
  rdfs:range  personnel:ProfileDocument .

personnel:isProfileDocumentOf a owl:ObjectProperty ;
  rdfs:subPropertyOf abi:genericallyDependsOn ;
  owl:inverseOf personnel:hasProfileDocument ;
  rdfs:label "is profile document of"@en ;
  skos:definition "Relates a profile document to the person it is about and on which it generically depends."@en ;
  rdfs:domain personnel:ProfileDocument ;
  rdfs:range  abi:Person .

# HOW WE KNOW ↔ HOW WE KNOW - provenance of an asserted entity
personnel:isSourcedFrom a owl:ObjectProperty ;
  rdfs:subPropertyOf cco:ont00001808 ;
  owl:inverseOf personnel:isSourceOf ;
  rdfs:label "is sourced from"@en ;
  skos:definition "Relates an information content entity to the profile document it was read from."@en ;
  rdfs:domain abi:GenericallyDependentContinuant ;
  rdfs:range  personnel:ProfileDocument .

personnel:isSourceOf a owl:ObjectProperty ;
  owl:inverseOf personnel:isSourcedFrom ;
  rdfs:label "is source of"@en ;
  skos:definition "Relates a profile document to an information content entity read from it."@en ;
  rdfs:domain personnel:ProfileDocument ;
  rdfs:range  abi:GenericallyDependentContinuant .

# WHAT ↔ HOW WE KNOW - a planned act, of whatever kind, informed by the profile
# document it was read from. personnel:isSourcedFrom carries this for a
# generically dependent continuant (a Mission, a Certification); this is the
# same idea for the act itself, so every act that registers something from a
# profile document can say so, and the document is never left unconnected to
# the acts it substantiates.
personnel:hasSourceDocument a owl:ObjectProperty ;
  rdfs:subPropertyOf cco:ont00001808 ;
  owl:inverseOf personnel:isSourceDocumentOf ;
  rdfs:label "has source document"@en ;
  skos:definition "Relates a planned act to the profile document it was read from and registered against."@en ;
  rdfs:domain cco:ont00000228 ;
  rdfs:range  personnel:ProfileDocument .

personnel:isSourceDocumentOf a owl:ObjectProperty ;
  owl:inverseOf personnel:hasSourceDocument ;
  rdfs:label "is source document of"@en ;
  skos:definition "Relates a profile document to a planned act that was read from it and registered against it."@en ;
  rdfs:domain personnel:ProfileDocument ;
  rdfs:range  cco:ont00000228 .

#################################################################
#    Data Properties
#################################################################

personnel:employee_id a owl:DatatypeProperty ;
    rdfs:label "employee id"@en ;
    skos:definition "Identifier assigned to a person by the employing organization's HR system."@en ;
    rdfs:domain personnel:EmploymentRecord ;
    rdfs:range xsd:string .

personnel:job_title a owl:DatatypeProperty ;
    rdfs:label "job title"@en ;
    skos:definition "Title of the job position as published by the organization."@en ;
    rdfs:domain personnel:JobPosition ;
    rdfs:range xsd:string .

personnel:job_family a owl:DatatypeProperty ;
    rdfs:label "job family"@en ;
    skos:definition "Grouping of related job positions sharing a common discipline or career track."@en ;
    rdfs:domain personnel:JobPosition ;
    rdfs:range xsd:string .

personnel:hire_date a owl:DatatypeProperty ;
    rdfs:label "hire date"@en ;
    skos:definition "Date on which the employment relationship documented by this record began."@en ;
    rdfs:domain personnel:EmploymentRecord ;
    rdfs:range xsd:date .

personnel:termination_date a owl:DatatypeProperty ;
    rdfs:label "termination date"@en ;
    skos:definition "Date on which the employment relationship documented by this record ended. Absent while the relationship is active."@en ;
    rdfs:domain personnel:EmploymentRecord ;
    rdfs:range xsd:date .

personnel:status_value a owl:DatatypeProperty ;
    rdfs:label "status value"@en ;
    skos:definition "Value of an employment status, e.g. 'active', 'on-leave', 'notice-period', 'terminated'."@en ;
    rdfs:domain personnel:EmploymentStatus ;
    rdfs:range xsd:string .

personnel:given_name a owl:DatatypeProperty ;
    rdfs:label "given name"@en ;
    skos:altLabel "forename"@en ;
    skos:definition "The name conferred on a person individually, typically at or near birth, as distinct from the family name they share with kin."@en ;
    skos:example "'Jeremy'."@en ;
    rdfs:domain abi:Person ;
    rdfs:range  xsd:string .

personnel:family_name a owl:DatatypeProperty ;
    rdfs:label "family name"@en ;
    skos:altLabel "surname"@en ;
    skos:definition "The name a person shares with or inherits from kin, as distinct from the given name conferred on them individually."@en ;
    skos:example "'Ravenel'."@en ;
    rdfs:domain abi:Person ;
    rdfs:range  xsd:string .

personnel:instant_date a owl:DatatypeProperty ;
    rdfs:label "instant date"@en ;
    skos:definition "Calendar date a temporal instant denotes, carried so processes can be ordered and capped by recency without parsing display labels."@en ;
    rdfs:domain abi:TemporalInstant ;
    rdfs:range  xsd:date .

personnel:remuneration_amount a owl:DatatypeProperty ;
    rdfs:label "remuneration amount"@en ;
    skos:definition "Annual remuneration amount in the contract currency."@en ;
    rdfs:domain personnel:Remuneration ;
    rdfs:range  xsd:decimal .

personnel:remuneration_currency a owl:DatatypeProperty ;
    rdfs:label "remuneration currency"@en ;
    rdfs:domain personnel:Remuneration ;
    rdfs:range  xsd:string .

personnel:program_name a owl:DatatypeProperty ;
    rdfs:label "program name"@en ;
    skos:definition "Name of the curriculum or programme the enrollment is for."@en ;
    rdfs:domain personnel:EnrollmentRecord ;
    rdfs:range  xsd:string .

personnel:enrollment_date a owl:DatatypeProperty ;
    rdfs:label "enrollment date"@en ;
    skos:definition "Date on which the course of study documented by this record began."@en ;
    rdfs:domain personnel:EnrollmentRecord ;
    rdfs:range  xsd:date .

personnel:completion_date a owl:DatatypeProperty ;
    rdfs:label "completion date"@en ;
    skos:definition "Date on which the course of study documented by this record ended. Absent while the person is still enrolled."@en ;
    rdfs:domain personnel:EnrollmentRecord ;
    rdfs:range  xsd:date .

personnel:profile_slug a owl:DatatypeProperty ;
    rdfs:label "profile slug"@en ;
    skos:definition "Stable, lowercase, ASCII key identifying a person in profile URLs and dataset rows. Assigned by the system that publishes the profile, not by the person."@en ;
    skos:example "'alice_dupont'."@en ;
    rdfs:domain abi:Person ;
    rdfs:range  xsd:string .

# Contact details. Stated on the person, like the profile slug, because they
# address the person rather than any one role, document or job. A directory
# publishes them only when its instance opts in (privacy.publish_contact_details).
personnel:email_address a owl:DatatypeProperty ;
    rdfs:label "email address"@en ;
    skos:definition "Address at which the person can be reached by email, as published for them by the directory that lists them."@en ;
    skos:example "'alice.dupont@demo.example'."@en ;
    rdfs:domain abi:Person ;
    rdfs:range  xsd:string .

personnel:telephone_number a owl:DatatypeProperty ;
    rdfs:label "telephone number"@en ;
    skos:definition "Number at which the person can be reached by telephone, written in international form with its country code."@en ;
    skos:example "'+33 1 99 00 00 01'."@en ;
    rdfs:domain abi:Person ;
    rdfs:range  xsd:string .

personnel:linkedin_url a owl:DatatypeProperty ;
    rdfs:label "linkedin url"@en ;
    skos:definition "Address of the person's own LinkedIn profile page. Distinct from the source a profile was read from, which may be any published page."@en ;
    skos:example "'https://www.linkedin.com/in/alice-dupont-demo'."@en ;
    rdfs:domain abi:Person ;
    rdfs:range  xsd:anyURI .

personnel:certification_name a owl:DatatypeProperty ;
    rdfs:label "certification name"@en ;
    skos:definition "Name of the certification as published by the issuing organization."@en ;
    skos:example "'Certified Information Systems Auditor'."@en ;
    rdfs:domain personnel:Certification ;
    rdfs:range  xsd:string .

personnel:issue_date a owl:DatatypeProperty ;
    rdfs:label "issue date"@en ;
    skos:definition "Date on which the certification was issued."@en ;
    rdfs:domain personnel:Certification ;
    rdfs:range  xsd:date .

personnel:expiry_date a owl:DatatypeProperty ;
    rdfs:label "expiry date"@en ;
    skos:definition "Date on which the certification ceases to be valid. Absent when the certification does not expire."@en ;
    rdfs:domain personnel:Certification ;
    rdfs:range  xsd:date .

personnel:credential_id a owl:DatatypeProperty ;
    rdfs:label "credential id"@en ;
    skos:definition "Identifier the issuing organization assigned to this certification, by which it can be verified."@en ;
    rdfs:domain personnel:Certification ;
    rdfs:range  xsd:string .

personnel:credential_url a owl:DatatypeProperty ;
    rdfs:label "credential url"@en ;
    skos:definition "Address at which the issuing organization publishes verification of this certification."@en ;
    rdfs:domain personnel:Certification ;
    rdfs:range  xsd:anyURI .

personnel:certification_status a owl:DatatypeProperty ;
    rdfs:label "certification status"@en ;
    skos:definition "State of a certification at a point in time, e.g. 'active', 'expired', 'in-progress'."@en ;
    rdfs:domain personnel:Certification ;
    rdfs:range  xsd:string .

personnel:language_name a owl:DatatypeProperty ;
    rdfs:label "language name"@en ;
    skos:definition "Name of the language a capability is held for, as displayed."@en ;
    skos:example "'French'; 'Mandarin'."@en ;
    rdfs:domain personnel:LanguageCapability ;
    rdfs:range  xsd:string .

personnel:proficiency_level a owl:DatatypeProperty ;
    rdfs:label "proficiency level"@en ;
    skos:definition "Reported level of a language capability. Free text rather than a code list: sources state it in incompatible scales (CEFR, 'native', 'professional working proficiency') and converting between them would assert more than the source does."@en ;
    skos:example "'Native or bilingual'; 'C1'."@en ;
    rdfs:domain personnel:LanguageCapability ;
    rdfs:range  xsd:string .

personnel:recommendation_content a owl:DatatypeProperty ;
    rdfs:label "recommendation content"@en ;
    skos:definition "Full text of the recommendation, as written by its author."@en ;
    rdfs:domain personnel:Recommendation ;
    rdfs:range  xsd:string .

personnel:recommendation_date a owl:DatatypeProperty ;
    rdfs:label "recommendation date"@en ;
    skos:definition "Date on which the recommendation was written."@en ;
    rdfs:domain personnel:Recommendation ;
    rdfs:range  xsd:date .

personnel:relationship_label a owl:DatatypeProperty ;
    rdfs:label "relationship label"@en ;
    skos:definition "How the author of a recommendation describes their working relationship with the person it is about."@en ;
    skos:example "'Managed Alice directly'; 'Worked with Alice on the same team'."@en ;
    rdfs:domain personnel:Recommendation ;
    rdfs:range  xsd:string .

personnel:interest_name a owl:DatatypeProperty ;
    rdfs:label "interest name"@en ;
    skos:definition "Name of what the interest is in, carried on the interest itself so an interest with no individual to point at is still stated."@en ;
    skos:example "'Ocean conservation'."@en ;
    rdfs:domain personnel:Interest ;
    rdfs:range  xsd:string .

personnel:interest_description a owl:DatatypeProperty ;
    rdfs:label "interest description"@en ;
    skos:definition "Sentence stating what the interest consists in."@en ;
    rdfs:domain personnel:Interest ;
    rdfs:range  xsd:string .

personnel:interest_kind a owl:DatatypeProperty ;
    rdfs:label "interest kind"@en ;
    skos:definition "Category of the interest target, used to group interests for display, e.g. 'organization', 'school', 'person', 'topic'."@en ;
    rdfs:domain personnel:Interest ;
    rdfs:range  xsd:string .

personnel:grade_value a owl:DatatypeProperty ;
    rdfs:label "grade value"@en ;
    skos:definition "Value of a grade, i.e. the seniority level the employing organization recognises for the person."@en ;
    skos:example "'Partner'; 'Senior Manager'; 'Associate'."@en ;
    rdfs:domain personnel:Grade ;
    rdfs:range  xsd:string .

personnel:portrait_url a owl:DatatypeProperty ;
    rdfs:label "portrait url"@en ;
    skos:definition "Address at which the portrait image can be retrieved."@en ;
    rdfs:domain personnel:Portrait ;
    rdfs:range  xsd:anyURI .

personnel:portrait_path a owl:DatatypeProperty ;
    rdfs:label "portrait path"@en ;
    skos:definition "Repository-relative or object-storage path of the portrait image, for portraits that are not published at a public address."@en ;
    rdfs:domain personnel:Portrait ;
    rdfs:range  xsd:string .

personnel:headline_text a owl:DatatypeProperty ;
    rdfs:label "headline text"@en ;
    skos:definition "One-line statement of what a person does, as they present it. Distinct from personnel:job_title, which is the title of the position the organization defines."@en ;
    skos:example "'Partner, Audit - Consumer goods and food & beverage'."@en ;
    rdfs:domain personnel:ProfileSummary ;
    rdfs:range  xsd:string .

personnel:summary_content a owl:DatatypeProperty ;
    rdfs:label "summary content"@en ;
    skos:definition "Full text of the profile summary: the paragraph a person or their organization publishes about them."@en ;
    rdfs:domain personnel:ProfileSummary ;
    rdfs:range  xsd:string .

personnel:quote_content a owl:DatatypeProperty ;
    rdfs:label "quote content"@en ;
    skos:definition "Sentence attributed to the person in their own words, published alongside the summary."@en ;
    rdfs:domain personnel:ProfileSummary ;
    rdfs:range  xsd:string .

personnel:years_of_experience a owl:DatatypeProperty ;
    rdfs:label "years of experience"@en ;
    skos:definition "Number of years of professional experience the profile summary claims. A claim carried by the summary and traceable to its source, not a figure computed from the acts of working in this graph: the graph holds only the working history that has been recorded."@en ;
    rdfs:domain personnel:ProfileSummary ;
    rdfs:range  xsd:integer .

personnel:office_label a owl:DatatypeProperty ;
    rdfs:label "office label"@en ;
    skos:definition "Name by which an organization refers to a site, as it appears in its own directory."@en ;
    skos:example "'Paris La Défense'."@en ;
    rdfs:domain abi:Site ;
    rdfs:range  xsd:string .

personnel:city_name a owl:DatatypeProperty ;
    rdfs:label "city name"@en ;
    skos:definition "Name of the city a site is in."@en ;
    rdfs:domain abi:Site ;
    rdfs:range  xsd:string .

personnel:country_name a owl:DatatypeProperty ;
    rdfs:label "country name"@en ;
    skos:definition "Name of the country a site is in."@en ;
    rdfs:domain abi:Site ;
    rdfs:range  xsd:string .

personnel:country_code a owl:DatatypeProperty ;
    rdfs:label "country code"@en ;
    skos:definition "ISO 3166-1 alpha-2 code of the country a site is in, carried so places can be grouped and flagged without matching country names across languages."@en ;
    skos:example "'FR'; 'SG'; 'ZA'."@en ;
    rdfs:domain abi:Site ;
    rdfs:range  xsd:string .

personnel:skill_name a owl:DatatypeProperty ;
  rdfs:label "skill name"@en ;
  skos:definition "Name of a skill as stated on the source profile."@en ;
  rdfs:domain personnel:Skill ;
  rdfs:range  xsd:string .

personnel:source_url a owl:DatatypeProperty ;
  rdfs:label "source url"@en ;
  skos:definition "Address at which a profile document can be retrieved."@en ;
  rdfs:domain personnel:ProfileDocument ;
  rdfs:range  xsd:anyURI .

personnel:duration_label a owl:DatatypeProperty ;
  rdfs:label "duration label"@en ;
  skos:definition "Human-readable span of a temporal region as stated on the source profile, e.g. '3 yrs 5 mos'."@en ;
  rdfs:domain abi:TemporalRegion ;
  rdfs:range  xsd:string .

#################################################################
#    Classes - HOW WE KNOW
#################################################################

personnel:EmploymentRecord a owl:Class ;
    rdfs:subClassOf abi:GenericallyDependentContinuant ,
      [ a owl:Restriction ; owl:onProperty personnel:isEmploymentRecordOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:isConcretizedBy ; owl:someValuesFrom personnel:ActOfWorking ] ;
    rdfs:label "Employment Record"@en ;
    skos:definition "An information content entity that documents an employment relationship between a person and an organization, including its identifier and its start and end dates."@en ;
    skos:example "The HR system record for employee E-10428, hired 2024-03-01."@en ;
    rdfs:comment "Generically dependent on the person: the same record can be copied between systems without ceasing to be the record of that person. Concretized by the Act of Working that the relationship consists in."@en .

personnel:JobDescription a owl:Class ;
    rdfs:subClassOf abi:DocumentContentEntity ,
      [ a owl:Restriction ; owl:onProperty abi:genericallyDependsOn ; owl:someValuesFrom abi:Organization ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom personnel:ActOfWorking ] ;
    rdfs:label "Job Description"@en ;
    skos:definition "A document content entity that states the duties, responsibilities and requirements of a job position."@en ;
    skos:example "The published job description for 'Senior Data Engineer, EMEA'."@en .

personnel:JobPosition a owl:Class ;
    rdfs:subClassOf abi:GenericallyDependentContinuant ,
      [ a owl:Restriction ; owl:onProperty abi:genericallyDependsOn ; owl:someValuesFrom abi:Organization ] ,
      [ a owl:Restriction ; owl:onProperty abi:isConcretizedBy ; owl:allValuesFrom personnel:EmployeeRole ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom personnel:ActOfWorking ] ;
    rdfs:label "Job Position"@en ;
    skos:definition "An information content entity, defined by an organization as part of its structure, that specifies a role to be borne by whoever fills it. Fundable and referable independently of any occupant, and possibly vacant."@en ;
    skos:example "Requisition R-2291, 'Senior Data Engineer, EMEA', currently vacant."@en ;
    rdfs:comment "Deliberately NOT a subclass of abi:Role. A BFO role must inhere in a bearer, but an open requisition has no occupant. Occupied positions are concretized by personnel:EmployeeRole (allValuesFrom, not someValuesFrom, so a vacant position remains satisfiable)."@en .

personnel:EmploymentContract a owl:Class ;
    rdfs:subClassOf abi:GenericallyDependentContinuant ,
      [ a owl:Restriction ; owl:onProperty abi:genericallyDependsOn ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:isConcretizedBy ; owl:someValuesFrom personnel:ActOfWorking ] ;
    rdfs:label "Employment Contract"@en ;
    skos:definition "A generically dependent continuant that specifies the terms under which a person works for an organization."@en ;
    skos:example "Permanent contract CDI - Alice Dupont / naas.ai."@en .

personnel:EnrollmentRecord a owl:Class ;
    rdfs:subClassOf abi:GenericallyDependentContinuant ,
      [ a owl:Restriction ; owl:onProperty personnel:isEnrollmentRecordOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:genericallyDependsOn ; owl:someValuesFrom cco:ont00000564 ] ,
      [ a owl:Restriction ; owl:onProperty abi:isConcretizedBy ; owl:someValuesFrom personnel:ActOfStudying ] ;
    rdfs:label "Enrollment Record"@en ;
    skos:definition "An information content entity that documents a person's enrollment in a curriculum at an educational organization, including the programme name and its start and end dates."@en ;
    skos:example "Enrollment in the Computer Science licence at Université de Rennes 1, 2009-09-01 to 2014-06-30."@en .

personnel:AcademicDegree a owl:Class ;
    owl:equivalentClass cco:ont00002003 ;
    rdfs:subClassOf abi:GenericallyDependentContinuant ,
      [ a owl:Restriction ; owl:onProperty abi:genericallyDependsOn ; owl:someValuesFrom abi:Person ] ;
    rdfs:label "Academic Degree"@en ;
    skos:definition "A certificate issued by an educational organization to a person to indicate that the person has satisfactorily completed a course of study. Equivalent to CCO Academic Degree."@en ;
    skos:example "Licence Informatique, Université de Rennes 1."@en .

personnel:Certification a owl:Class ;
    rdfs:subClassOf cco:ont00002002 ,
      abi:GenericallyDependentContinuant ,
      [ a owl:Restriction ; owl:onProperty personnel:isCertificationOf ; owl:someValuesFrom abi:Person ] ;
    rdfs:label "Certification"@en ;
    skos:definition "A certificate issued to a person by an organization to attest that they have demonstrated a competence, met a professional standard, or hold a licence to practise. Subclass of CCO Certificate, sibling of personnel:AcademicDegree."@en ;
    skos:example "Certified Information Systems Auditor, issued by ISACA in 2019; Commissaire aux comptes."@en ;
    rdfs:comment "Covers both certifications and licences: the difference is who may withhold it and what it permits, not what kind of entity it is. Where that distinction matters, state it with personnel:certification_status and the issuing organization."@en .

personnel:Recommendation a owl:Class ;
    rdfs:subClassOf abi:DocumentContentEntity ,
      [ a owl:Restriction ; owl:onProperty personnel:isRecommendationOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty personnel:hasRecommendationAuthor ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom personnel:ActOfPersonnelProfiling ] ;
    rdfs:label "Recommendation"@en ;
    skos:definition "A document content entity in which one person states, in their own words, what it was like to work with another and what that person is good at."@en ;
    skos:example "'Alice rebuilt our close process in one quarter' - written by her former CFO, 2024-11-02."@en ;
    rdfs:comment "Two people, and both are required: the subject it generically depends on, and the author who wrote it. An anonymous testimonial is not a recommendation in this sense and must not be minted as one."@en .

personnel:Portrait a owl:Class ;
    rdfs:subClassOf cco:ont00002004 ,
      abi:GenericallyDependentContinuant ,
      [ a owl:Restriction ; owl:onProperty personnel:isPortraitOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom personnel:ActOfPersonnelProfiling ] ;
    rdfs:label "Portrait"@en ;
    skos:definition "An image that depicts a person, published to identify them. Subclass of CCO Image."@en ;
    skos:example "The photograph published on a person's directory page."@en ;
    rdfs:comment "The individual carries the address of the image (personnel:portrait_url or personnel:portrait_path), never the bytes. Image data belongs in object storage."@en .

personnel:ProfileSummary a owl:Class ;
    rdfs:subClassOf abi:DocumentContentEntity ,
      [ a owl:Restriction ; owl:onProperty personnel:isProfileSummaryOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty personnel:isSourcedFrom ; owl:someValuesFrom personnel:ProfileDocument ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom personnel:ActOfPersonnelProfiling ] ;
    rdfs:label "Profile Summary"@en ;
    skos:definition "A document content entity that states how a person is presented in general: the one-line headline, the paragraph about them, an attributed quote, and the years of experience claimed for them."@en ;
    skos:example "The headline and 'About' paragraph on a person's published directory page."@en ;
    rdfs:comment "Person-level, where personnel:Mission is job-level: the summary spans a career, a mission describes one act of working. Sourced from a ProfileDocument so every claim it carries stays traceable to where it was published."@en .

personnel:ProfileDocument a owl:Class ;
  rdfs:subClassOf abi:DocumentContentEntity ,
    [ a owl:Restriction ; owl:onProperty abi:genericallyDependsOn ; owl:someValuesFrom abi:Person ] ;
  rdfs:label "Profile Document"@en ;
  skos:definition "A document content entity, published at a retrievable address, from which statements about a person's history are taken: what they did, where they studied, what they hold. Carried by the person the profile is about."@en ;
  skos:example "https://demo.example/profiles/demo"@en ;
  rdfs:comment "The provenance anchor of the demo graph: everything asserted from a profile page: missions, roles, skills, enrollments, degrees, certifications points back to the ProfileDocument it was read from."@en .

#################################################################
#    Classes - WHY
#################################################################

personnel:EmployeeRole a owl:Class ;
    owl:equivalentClass cco:ont00000984 ;
    rdfs:subClassOf abi:Role ,
      [ a owl:Restriction ; owl:onProperty personnel:isEmployeeRoleOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:hasRealization ; owl:someValuesFrom personnel:ActOfWorking ] ,
      [ a owl:Restriction ; owl:onProperty personnel:hasJobPosition ; owl:someValuesFrom personnel:JobPosition ] ;
    rdfs:label "Employee Role"@en ;
    skos:definition "A role that inheres in a person in virtue of an employment relationship with an organization, realized in the Act of Working the person carries out for that organization. Equivalent to CCO Occupation Role."@en ;
    skos:example "The role Jane bears as a data engineer at ACME."@en ;
    rdfs:comment "Externally grounded: it exists only while the employment relationship holds, and ends without the person ceasing to exist. Concretizes a JobPosition (possibly filling a previously vacant requisition)."@en .

personnel:StudentRole a owl:Class ;
    rdfs:subClassOf abi:Role ,
      [ a owl:Restriction ; owl:onProperty personnel:isStudentRoleOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:hasRealization ; owl:someValuesFrom personnel:ActOfStudying ] ;
    rdfs:label "Student Role"@en ;
    skos:definition "A role that inheres in a person in virtue of being enrolled in a curriculum at an educational organization, realized in the Act of Studying."@en ;
    skos:example "The role Florent bears as a computer-science student at Université de Rennes 1."@en ;
    rdfs:comment "No CCO student-role class; minted in the personnel namespace. Ends when the enrollment ends, without the person ceasing to exist."@en .

#################################################################
#    Classes - HOW IT IS
#################################################################

personnel:EmploymentStatus a owl:Class ;
    rdfs:subClassOf abi:Quality ,
      [ a owl:Restriction ; owl:onProperty personnel:isEmploymentStatusOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:concretizes ; owl:someValuesFrom personnel:EmploymentRecord ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom personnel:ActOfWorking ] ;
    rdfs:label "Employment Status"@en ;
    skos:definition "A quality that inheres in a person and holds the state of their employment relationship at a point in time."@en ;
    skos:example "'on-leave' for a person on parental leave."@en .

personnel:Remuneration a owl:Class ;
    rdfs:subClassOf abi:Quality ,
      [ a owl:Restriction ; owl:onProperty abi:inheresIn ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom personnel:ActOfWorking ] ;
    rdfs:label "Remuneration"@en ;
    skos:definition "A quality borne by a person that specifies what they are paid for their work."@en ;
    skos:example "95000 EUR per year."@en .

personnel:LanguageCapability a owl:Class ;
    rdfs:subClassOf abi:Quality ,
      [ a owl:Restriction ; owl:onProperty personnel:isLanguageCapabilityOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty personnel:isLanguageCapabilityDevelopedIn ; owl:someValuesFrom cco:ont00000228 ] ,
      [ a owl:Restriction ; owl:onProperty personnel:ofLanguage ; owl:someValuesFrom cco:ont00001175 ] ;
    rdfs:label "Language Capability"@en ;
    skos:definition "A quality that inheres in a person and holds how well they can communicate in one language, developed and exercised in the acts the person carries out: working, studying, being certified."@en ;
    skos:example "Spanish at native or bilingual proficiency."@en ;
    rdfs:comment "Deliberately NOT equivalent to CCO Language Skill (cco:ont00000181). That class is an Agent Capability and therefore a BFO realizable entity, which is disjoint from quality; this domain already models personnel:Skill as a quality, and asserting both would make the ontology inconsistent. The language itself is a CCO Language, reached through personnel:ofLanguage. Like a skill, it is borne by the person and outlives any one act: personnel:developsLanguageCapability links a planned act, of whatever kind, to the capabilities exercised and grown in it."@en .

personnel:Interest a owl:Class ;
    rdfs:subClassOf abi:Quality ,
      [ a owl:Restriction ; owl:onProperty personnel:isInterestOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom personnel:ActOfPersonnelProfiling ] ;
    rdfs:label "Interest"@en ;
    skos:definition "A quality that inheres in a person and holds what they follow, care about or give their attention to outside the duties of any one job."@en ;
    skos:example "Ocean conservation; the alumni association of a school they attended."@en ;
    rdfs:comment "Modelled as a quality for consistency with personnel:Skill rather than as a disposition. Points at its target with personnel:hasInterestTarget where an individual exists for it, and otherwise carries personnel:interest_name alone."@en .

personnel:Grade a owl:Class ;
    rdfs:subClassOf abi:Quality ,
      [ a owl:Restriction ; owl:onProperty personnel:isGradeOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom personnel:ActOfWorking ] ;
    rdfs:label "Grade"@en ;
    skos:definition "A quality that inheres in a person and holds the seniority level the employing organization recognises for them."@en ;
    skos:example "'Partner' for a person admitted to the partnership."@en ;
    rdfs:comment "Kept apart from personnel:job_title, which names a position, and from personnel:EmployeeRole, which is what the person bears. Two people with the same grade can hold different positions, and the same position can be held at different grades."@en .

personnel:Skill a owl:Class ;
  rdfs:subClassOf abi:Quality ,
    [ a owl:Restriction ; owl:onProperty abi:inheresIn ; owl:someValuesFrom abi:Person ] ,
    [ a owl:Restriction ; owl:onProperty personnel:isSkillDevelopedIn ; owl:someValuesFrom cco:ont00000228 ] ;
  rdfs:label "Skill"@en ;
  skos:definition "A quality that inheres in a person, consisting in a learned capacity to perform a kind of task, developed and exercised in the acts the person carries out: working, studying, being certified."@en ;
  skos:example "Python (Programming Language); Business Analysis; SAP BFC."@en ;
  rdfs:comment "Borne by the person, not by the process: the skill outlives any one act of working. personnel:developsSkill links a planned act, of whatever kind, to the skills exercised and grown in it."@en .

#################################################################
#    Classes - WHO
#################################################################

personnel:ServiceLine a owl:Class ;
    rdfs:subClassOf abi:Organization ,
      [ a owl:Restriction ; owl:onProperty personnel:isServiceLineOf ; owl:someValuesFrom abi:Organization ] ;
    rdfs:label "Service Line"@en ;
    skos:definition "An organization that is a member part of a larger organization and groups the people who deliver one kind of service."@en ;
    skos:example "Audit; Tax; Advisory; Financial Advisory Services."@en ;
    rdfs:comment "An organization in its own right, not a label on a person: it has its own members, its own leadership and can be reorganized without any person changing. A person reaches their service line through the employee role they bear (personnel:inServiceLine)."@en .
