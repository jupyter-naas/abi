@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:    <http://purl.org/dc/terms/> .
@prefix dc11:  <http://purl.org/dc/elements/1.1/> .
@prefix bfo:   <http://purl.obolibrary.org/obo/> .
@prefix cco:   <https://www.commoncoreontologies.org/> .
@prefix abi:   <http://ontology.naas.ai/abi/> .
@prefix people: <http://ontology.naas.ai/people/> .
@prefix personnel: <http://ontology.naas.ai/personnel/> .

abi:PersonnelOntology a owl:Ontology ;
  # One owl:imports statement per IRI - onto2py's codegen pre-scan only matches
  # an IRI directly after the `owl:imports` keyword.
  owl:imports <http://ontology.naas.ai/abi/Ontology> ;
  owl:imports <http://ontology.naas.ai/abi/DocumentContentEntityOntology> ;
  owl:imports <http://ontology.naas.ai/abi/PersonOntology> ;
  owl:imports <http://ontology.naas.ai/abi/OrganizationOntology> ;
  owl:imports <https://www.commoncoreontologies.org/QualityOntology> ;
  owl:imports <https://www.commoncoreontologies.org/InformationEntityOntology> ;
  owl:imports <https://www.commoncoreontologies.org/AgentOntology> ;
  owl:imports <http://ontology.naas.ai/abi/PeopleOntology> ;
  rdfs:seeAlso <https://raw.githubusercontent.com/jupyter-naas/abi/refs/heads/main/libs/naas-abi-marketplace/naas_abi_marketplace/domains/personnel/ontologies/modules/PersonnelOntology.ttl> ;
  abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
  abi:ontologyResource "ontologies/modules/PersonnelOntology.ttl" ;
  abi:pythonResource "ontologies/modules/PersonnelOntology.py" ;
  dc:title "Personnel Ontology"@en ;
  dc:description "Internal vocabulary for the personnel (S1) domain: what an organization records about its own staff - the employee role a person bears while employed, the job position it concretizes and the job description of that position, the employment record and contract that document the relationship, and the employment status, remuneration, grade and service line the organization assigns. Every class specializes or relates to the people intelligence vocabulary (PeopleOntology), which it imports: an act of employment is an act of working, an employee role is an occupation role. Nothing in PeopleOntology refers back here."@en ;
  dc:license <https://creativecommons.org/licenses/by/4.0/> ;
  rdfs:comment "Internal HR classes. The generic person, working, studying and profile vocabulary is people:, in intelligence/modules/people."@en ;
  dc11:contributor "Florent Ravenel" ;
  dc11:date "2026-10-04"^^xsd:date .

#################################################################
#    Object Properties
#################################################################

# WHO ↔ HOW WE KNOW - person carries an employment record
abi:hasEmploymentRecord a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:isCarrierOf ;
    owl:inverseOf abi:isEmploymentRecordOf ;
    rdfs:label "has employment record"@en ;
    skos:definition "Relates a person to an employment record that generically depends on them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range abi:EmploymentRecord .

abi:isEmploymentRecordOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf abi:hasEmploymentRecord ;
    rdfs:label "is employment record of"@en ;
    skos:definition "Relates an employment record to the person on which it generically depends."@en ;
    rdfs:domain abi:EmploymentRecord ;
    rdfs:range abi:Person .

# WHO ↔ WHY - person bears an employee role
abi:hasEmployeeRole a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:bearerOf ;
    owl:inverseOf abi:isEmployeeRoleOf ;
    rdfs:label "has employee role"@en ;
    skos:definition "Relates a person to an employee role that inheres in them for the duration of an employment relationship."@en ;
    rdfs:domain abi:Person ;
    rdfs:range abi:EmployeeRole .

abi:isEmployeeRoleOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf abi:hasEmployeeRole ;
    rdfs:label "is employee role of"@en ;
    skos:definition "Relates an employee role to the person in whom it inheres."@en ;
    rdfs:domain abi:EmployeeRole ;
    rdfs:range abi:Person .

# WHO ↔ WHO - convenience shortcut. Backbone is Person bears EmployeeRole
# and participates in ActOfWorking; do not use this as the employment model.
abi:employs a owl:ObjectProperty ;
    owl:inverseOf abi:isEmployedBy ;
    rdfs:label "employs"@en ;
    skos:definition "Convenience relation from an organization to a person it employs. Derived from ActOfEmployment + EmployeeRole; not a BFO primitive."@en ;
    rdfs:domain abi:Organization ;
    rdfs:range abi:Person .

abi:isEmployedBy a owl:ObjectProperty ;
    owl:inverseOf abi:employs ;
    rdfs:label "is employed by"@en ;
    skos:definition "Convenience relation from a person to the organization that employs them, as that organization records it. The published counterpart is abi:worksFor."@en ;
    rdfs:domain abi:Person ;
    rdfs:range abi:Organization .

# WHY ↔ HOW WE KNOW - employee role concretizes the job position (GDC)
abi:hasJobPosition a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:concretizes ;
    owl:inverseOf abi:isJobPositionOf ;
    rdfs:label "has job position"@en ;
    skos:definition "Relates an employee role to the job position it concretizes. Named sub-property of abi:concretizes: a role (SDC) concretizes a position (GDC)."@en ;
    rdfs:domain abi:EmployeeRole ;
    rdfs:range abi:JobPosition .

abi:isJobPositionOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:isConcretizedBy ;
    owl:inverseOf abi:hasJobPosition ;
    rdfs:label "is job position of"@en ;
    skos:definition "Relates a job position to the employee role that concretizes it, when the position is occupied."@en ;
    rdfs:domain abi:JobPosition ;
    rdfs:range abi:EmployeeRole .

# HOW WE KNOW ↔ HOW WE KNOW - job position is described by a job description
abi:hasJobDescription a owl:ObjectProperty ;
    owl:inverseOf abi:isJobDescriptionOf ;
    rdfs:label "has job description"@en ;
    skos:definition "Relates a job position to the job description document that states its duties and requirements."@en ;
    rdfs:domain abi:JobPosition ;
    rdfs:range abi:JobDescription .

abi:isJobDescriptionOf a owl:ObjectProperty ;
    owl:inverseOf abi:hasJobDescription ;
    rdfs:label "is job description of"@en ;
    skos:definition "Relates a job description document to the job position it describes."@en ;
    rdfs:domain abi:JobDescription ;
    rdfs:range abi:JobPosition .

# HOW WE KNOW ↔ HOW WE KNOW - contract is about a job description
abi:isAboutJobDescription a owl:ObjectProperty ;
    rdfs:subPropertyOf cco:ont00001808 ;
    owl:inverseOf abi:isJobDescriptionOfContract ;
    rdfs:label "is about job description"@en ;
    skos:definition "Relates an employment contract to the job description it is about."@en ;
    rdfs:domain abi:EmploymentContract ;
    rdfs:range abi:JobDescription .

abi:isJobDescriptionOfContract a owl:ObjectProperty ;
    owl:inverseOf abi:isAboutJobDescription ;
    rdfs:label "is job description of contract"@en ;
    skos:definition "Relates a job description to an employment contract that is about it."@en ;
    rdfs:domain abi:JobDescription ;
    rdfs:range abi:EmploymentContract .

# WHO ↔ HOW IT IS - person bears an employment status
abi:hasEmploymentStatus a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:bearerOf ;
    owl:inverseOf abi:isEmploymentStatusOf ;
    rdfs:label "has employment status"@en ;
    skos:definition "Relates a person to the employment status quality that inheres in them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range abi:EmploymentStatus .

abi:isEmploymentStatusOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf abi:hasEmploymentStatus ;
    rdfs:label "is employment status of"@en ;
    skos:definition "Relates an employment status quality to the person in whom it inheres."@en ;
    rdfs:domain abi:EmploymentStatus ;
    rdfs:range abi:Person .

# WHY ↔ WHO - employee role sits in a service line
abi:inServiceLine a owl:ObjectProperty ;
    owl:inverseOf abi:isServiceLineOfEmployeeRole ;
    rdfs:label "in service line"@en ;
    skos:definition "Relates an employee role to the service line of the employing organization within which it is borne."@en ;
    rdfs:domain abi:EmployeeRole ;
    rdfs:range abi:ServiceLine .

abi:isServiceLineOfEmployeeRole a owl:ObjectProperty ;
    owl:inverseOf abi:inServiceLine ;
    rdfs:label "is service line of employee role"@en ;
    skos:definition "Relates a service line to an employee role borne within it."@en ;
    rdfs:domain abi:ServiceLine ;
    rdfs:range abi:EmployeeRole .

# WHO ↔ WHO - organization has a service line as a member part
abi:hasServiceLine a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:hasMemberPart ;
    owl:inverseOf abi:isServiceLineOf ;
    rdfs:label "has service line"@en ;
    skos:definition "Relates an organization to a service line that is a member part of it."@en ;
    rdfs:domain abi:Organization ;
    rdfs:range abi:ServiceLine .

abi:isServiceLineOf a owl:ObjectProperty ;
    owl:inverseOf abi:hasServiceLine ;
    rdfs:label "is service line of"@en ;
    skos:definition "Relates a service line to the organization it is a member part of."@en ;
    rdfs:domain abi:ServiceLine ;
    rdfs:range abi:Organization .

# WHO ↔ HOW IT IS - person bears a grade
abi:hasGrade a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:bearerOf ;
    owl:inverseOf abi:isGradeOf ;
    rdfs:label "has grade"@en ;
    skos:definition "Relates a person to the grade quality that inheres in them."@en ;
    rdfs:domain abi:Person ;
    rdfs:range abi:Grade .

abi:isGradeOf a owl:ObjectProperty ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf abi:hasGrade ;
    rdfs:label "is grade of"@en ;
    skos:definition "Relates a grade quality to the person in whom it inheres."@en ;
    rdfs:domain abi:Grade ;
    rdfs:range abi:Person .

#################################################################
#    Data Properties
#################################################################

abi:employee_id a owl:DatatypeProperty ;
    rdfs:label "employee id"@en ;
    skos:definition "Identifier assigned to a person by the employing organization's HR system."@en ;
    rdfs:domain abi:EmploymentRecord ;
    rdfs:range xsd:string .

abi:job_position_title a owl:DatatypeProperty ;
    rdfs:label "job title"@en ;
    skos:definition "Title of the job position as published by the organization."@en ;
    rdfs:domain abi:JobPosition ;
    rdfs:range xsd:string .

abi:job_family a owl:DatatypeProperty ;
    rdfs:label "job family"@en ;
    skos:definition "Grouping of related job positions sharing a common discipline or career track."@en ;
    rdfs:domain abi:JobPosition ;
    rdfs:range xsd:string .

abi:hire_date a owl:DatatypeProperty ;
    rdfs:label "hire date"@en ;
    skos:definition "Date on which the employment relationship documented by this record began."@en ;
    rdfs:domain abi:EmploymentRecord ;
    rdfs:range xsd:date .

abi:termination_date a owl:DatatypeProperty ;
    rdfs:label "termination date"@en ;
    skos:definition "Date on which the employment relationship documented by this record ended. Absent while the relationship is active."@en ;
    rdfs:domain abi:EmploymentRecord ;
    rdfs:range xsd:date .

abi:status_value a owl:DatatypeProperty ;
    rdfs:label "status value"@en ;
    skos:definition "Value of an employment status, e.g. 'active', 'on-leave', 'notice-period', 'terminated'."@en ;
    rdfs:domain abi:EmploymentStatus ;
    rdfs:range xsd:string .

abi:remuneration_amount a owl:DatatypeProperty ;
    rdfs:label "remuneration amount"@en ;
    skos:definition "Annual remuneration amount in the contract currency."@en ;
    rdfs:domain abi:Remuneration ;
    rdfs:range  xsd:decimal .

abi:remuneration_currency a owl:DatatypeProperty ;
    rdfs:label "remuneration currency"@en ;
    rdfs:domain abi:Remuneration ;
    rdfs:range  xsd:string .

abi:grade_value a owl:DatatypeProperty ;
    rdfs:label "grade value"@en ;
    skos:definition "Value of a grade, i.e. the seniority level the employing organization recognises for the person."@en ;
    skos:example "'Partner'; 'Senior Manager'; 'Associate'."@en ;
    rdfs:domain abi:Grade ;
    rdfs:range  xsd:string .

#################################################################
#    Classes - HOW WE KNOW
#################################################################

abi:EmploymentRecord a owl:Class ;
    rdfs:subClassOf abi:GenericallyDependentContinuant ,
      [ a owl:Restriction ; owl:onProperty abi:isEmploymentRecordOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:isConcretizedBy ; owl:someValuesFrom abi:ActOfEmployment ] ;
    rdfs:label "Employment Record"@en ;
    skos:definition "An information content entity that documents an employment relationship between a person and an organization, including its identifier and its start and end dates."@en ;
    skos:example "The HR system record for employee E-10428, hired 2024-03-01."@en ;
    rdfs:comment "Generically dependent on the person: the same record can be copied between systems without ceasing to be the record of that person. Concretized by the Act of Working that the relationship consists in."@en .

abi:JobDescription a owl:Class ;
    rdfs:subClassOf abi:DocumentContentEntity ,
      [ a owl:Restriction ; owl:onProperty abi:genericallyDependsOn ; owl:someValuesFrom abi:Organization ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom abi:ActOfEmployment ] ;
    rdfs:label "Job Description"@en ;
    skos:definition "A document content entity that states the duties, responsibilities and requirements of a job position."@en ;
    skos:example "The published job description for 'Senior Data Engineer, EMEA'."@en .

abi:JobPosition a owl:Class ;
    rdfs:subClassOf abi:GenericallyDependentContinuant ,
      [ a owl:Restriction ; owl:onProperty abi:genericallyDependsOn ; owl:someValuesFrom abi:Organization ] ,
      [ a owl:Restriction ; owl:onProperty abi:isConcretizedBy ; owl:allValuesFrom abi:EmployeeRole ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom abi:ActOfEmployment ] ;
    rdfs:label "Job Position"@en ;
    skos:definition "An information content entity, defined by an organization as part of its structure, that specifies a role to be borne by whoever fills it. Fundable and referable independently of any occupant, and possibly vacant."@en ;
    skos:example "Requisition R-2291, 'Senior Data Engineer, EMEA', currently vacant."@en ;
    rdfs:comment "Deliberately NOT a subclass of abi:Role. A BFO role must inhere in a bearer, but an open requisition has no occupant. Occupied positions are concretized by abi:EmployeeRole (allValuesFrom, not someValuesFrom, so a vacant position remains satisfiable)."@en .

abi:EmploymentContract a owl:Class ;
    rdfs:subClassOf abi:GenericallyDependentContinuant ,
      [ a owl:Restriction ; owl:onProperty abi:genericallyDependsOn ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:isConcretizedBy ; owl:someValuesFrom abi:ActOfEmployment ] ;
    rdfs:label "Employment Contract"@en ;
    skos:definition "A document content entity that specifies the terms under which a person works for an organization."@en ;
    skos:example "Permanent contract CDI - Alice Dupont / naas.ai."@en .

#################################################################
#    Classes - WHY
#################################################################

abi:EmployeeRole a owl:Class ;
    rdfs:subClassOf abi:OccupationRole ,
      [ a owl:Restriction ; owl:onProperty abi:isEmployeeRoleOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:hasRealization ; owl:someValuesFrom abi:ActOfEmployment ] ,
      [ a owl:Restriction ; owl:onProperty abi:hasJobPosition ; owl:someValuesFrom abi:JobPosition ] ;
    rdfs:label "Employee Role"@en ;
    skos:definition "A role that inheres in a person in virtue of an employment relationship with an organization, realized in the Act of Working the person carries out for that organization. A specialization of abi:OccupationRole: the occupation as the employing organization records it about its own staff."@en ;
    skos:example "The role Jane bears as a data engineer at ACME."@en ;
    rdfs:comment "Externally grounded: it exists only while the employment relationship holds, and ends without the person ceasing to exist. Concretizes a JobPosition (possibly filling a previously vacant requisition)."@en .

#################################################################
#    Classes - HOW IT IS
#################################################################

abi:EmploymentStatus a owl:Class ;
    rdfs:subClassOf abi:Quality ,
      [ a owl:Restriction ; owl:onProperty abi:isEmploymentStatusOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:concretizes ; owl:someValuesFrom abi:EmploymentRecord ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom abi:ActOfEmployment ] ;
    rdfs:label "Employment Status"@en ;
    skos:definition "A quality that inheres in a person and holds the state of their employment relationship at a point in time."@en ;
    skos:example "'on-leave' for a person on parental leave."@en .

abi:Remuneration a owl:Class ;
    rdfs:subClassOf abi:Quality ,
      [ a owl:Restriction ; owl:onProperty abi:inheresIn ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom abi:ActOfEmployment ] ;
    rdfs:label "Remuneration"@en ;
    skos:definition "A quality borne by a person that specifies what they are paid for their work."@en ;
    skos:example "95000 EUR per year."@en .

abi:Grade a owl:Class ;
    rdfs:subClassOf abi:Quality ,
      [ a owl:Restriction ; owl:onProperty abi:isGradeOf ; owl:someValuesFrom abi:Person ] ,
      [ a owl:Restriction ; owl:onProperty abi:participatesIn ; owl:someValuesFrom abi:ActOfEmployment ] ;
    rdfs:label "Grade"@en ;
    skos:definition "A quality that inheres in a person and holds the seniority level the employing organization recognises for them."@en ;
    skos:example "'Partner' for a person admitted to the partnership."@en ;
    rdfs:comment "Kept apart from abi:job_position_title, which names a position, and from abi:EmployeeRole, which is what the person bears. Two people with the same grade can hold different positions, and the same position can be held at different grades."@en .

#################################################################
#    Classes - WHO
#################################################################

abi:ServiceLine a owl:Class ;
    rdfs:subClassOf abi:Organization ,
      [ a owl:Restriction ; owl:onProperty abi:isServiceLineOf ; owl:someValuesFrom abi:Organization ] ;
    rdfs:label "Service Line"@en ;
    skos:definition "An organization that is a member part of a larger organization and groups the people who deliver one kind of service."@en ;
    skos:example "Audit; Tax; Advisory; Financial Advisory Services."@en ;
    rdfs:comment "An organization in its own right, not a label on a person: it has its own members, its own leadership and can be reorganized without any person changing. A person reaches their service line through the employee role they bear (abi:inServiceLine)."@en .

# >>> onto2py:consolidated-processes >>>
# Generated by naas_abi_core.utils.onto2py.consolidate from
# ontologies/processes/*.ttl. Do not edit between these markers: edit the
# process files and re-run onto2py on the module.

<http://ontology.naas.ai/abi/PersonnelOntology>
  owl:imports <https://www.commoncoreontologies.org/EventOntology> .

#################################################################
#    Process slice: http://ontology.naas.ai/abi/ActOfEmploymentProcess
#    Source: ontologies/processes/ActOfEmploymentProcess.ttl
#################################################################

#################################################################
#    Classes - WHAT
#################################################################

abi:ActOfEmployment a owl:Class ;
  rdfs:subClassOf abi:ActOfWorking ,
    cco:ont00001226 ,
    [ a owl:Restriction ; owl:onProperty abi:realizes ; owl:someValuesFrom abi:EmployeeRole ] ,
    [ a owl:Restriction ; owl:onProperty abi:hasContract ; owl:someValuesFrom abi:EmploymentContract ] ;
  rdfs:label "Act of Employment"@en ;
  skos:definition "An Act of Working, and a CCO Act of Employment, that a person performs for the organization that employs them, realizing an employee role under an employment contract."@en ;
  skos:example "Alice Dupont working as Head of Product for Demo under a permanent contract, as Demo's HR system records it."@en ;
  rdfs:comment "Everything the act of working states (organization, client, site, temporal region, occupation role, mission, skills, profile document) is inherited and stays in the people graph. The act of employment adds the employer's records: the employee role and the contract."@en .

#################################################################
#    Object properties - process-only
#################################################################

abi:hasContract a owl:ObjectProperty ;
  rdfs:subPropertyOf abi:concretizes ;
  owl:inverseOf abi:isContractOf ;
  rdfs:label "has contract"@en ;
  skos:definition "Relates an act of employment to the employment contract it concretizes."@en ;
  rdfs:domain abi:ActOfEmployment ;
  rdfs:range  abi:EmploymentContract .

abi:isContractOf a owl:ObjectProperty ;
  rdfs:subPropertyOf abi:isConcretizedBy ;
  owl:inverseOf abi:hasContract ;
  rdfs:label "is contract of"@en ;
  skos:definition "Relates an employment contract to the act of employment that concretizes it."@en ;
  rdfs:domain abi:EmploymentContract ;
  rdfs:range  abi:ActOfEmployment .

#################################################################
#    Data properties
#################################################################

abi:contract_type a owl:DatatypeProperty ;
  rdfs:label "contract type"@en ;
  skos:definition "Engagement type of an employment contract as the employer records it, e.g. 'Permanent', 'Fixed-term', 'Freelance'. The published counterpart is abi:employment_type, stated on the act of working."@en ;
  rdfs:domain abi:EmploymentContract ;
  rdfs:range  xsd:string .
# <<< onto2py:consolidated-processes <<<
