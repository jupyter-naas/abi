        <http://ontology.naas.ai/personnel/Mission/grace-lambert-deviceworks-cto>,
        <http://ontology.naas.ai/personnel/Mission/grace-lambert-streamcorp-head-of-partner-experiences> ;
    personnel:hasProfileDocument <http://ontology.naas.ai/personnel/ProfileDocument/grace-lambert-linkedin> ;
    personnel:hasSkill <http://ontology.naas.ai/personnel/Skill/grace-lambert-engineering>,
        <http://ontology.naas.ai/personnel/Skill/grace-lambert-partnerships>,
        <http://ontology.naas.ai/personnel/Skill/grace-lambert-product>,
        <http://ontology.naas.ai/personnel/Skill/grace-lambert-strategy> ;
    personnel:hasWorkLocation <http://ontology.naas.ai/personnel/Site/california>,
        <http://ontology.naas.ai/personnel/Site/paris>,
        <http://ontology.naas.ai/personnel/Site/toronto> ;
    dcterms:created "2026-08-19T17:41:38.118935"^^xsd:dateTime ;
    dcterms:creator "demo_graph_builder" .

personnel:Mission a owl:Class ;
    rdfs:label "Mission"@en ;
    rdfs:comment "Deliberately a GDC and NOT a BFO function. A mission is stated, copied between systems and survives the person leaving the post, which a disposition inhering in the person could not. The WHY that inheres in the person is personnel:EmployeeRole; the mission is what that role concretizes, mirroring the JobPosition ← EmployeeRole pattern in PersonnelOntology. rdfs:label carries the opening sentence; personnel:mission_content carries the full text."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isSourcedFrom ;
            owl:someValuesFrom personnel:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom personnel:EmployeeRole ],
        abi:GenericallyDependentContinuant ;
    skos:definition "An information content entity that states what a person is charged with achieving in an employment relationship: the remit, its objectives and its main activities. Generically dependent on the person, and concretized by the employee role through which the person carries it out."@en ;
    skos:example "'Leading the development of an open Universal Data & AI Platform to help organizations create powerful ecosystems of AI Agents.'"@en .

personnel:JobPosition a owl:Class ;
    rdfs:label "Job Position"@en ;
    rdfs:comment "Deliberately NOT a subclass of abi:Role. A BFO role must inhere in a bearer, but an open requisition has no occupant. Occupied positions are concretized by personnel:EmployeeRole (allValuesFrom, not someValuesFrom, so a vacant position remains satisfiable)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:allValuesFrom personnel:EmployeeRole ;
            owl:onProperty abi:isConcretizedBy ],
        abi:GenericallyDependentContinuant ;
    skos:definition "An information content entity, defined by an organization as part of its structure, that specifies a role to be borne by whoever fills it. Fundable and referable independently of any occupant, and possibly vacant."@en ;
    skos:example "Requisition R-2291, 'Senior Data Engineer, EMEA', currently vacant."@en .

personnel:EmployeeRole a owl:Class ;
    rdfs:label "Employee Role"@en ;
    rdfs:comment "Externally grounded: it exists only while the employment relationship holds, and ends without the person ceasing to exist. Concretizes a JobPosition (possibly filling a previously vacant requisition)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isEmployeeRoleOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasRealization ;
            owl:someValuesFrom personnel:ActOfWorking ],
        [ a owl:Restriction ;
            owl:onProperty personnel:hasJobPosition ;
            owl:someValuesFrom personnel:JobPosition ],
        abi:Role ;
    owl:equivalentClass cco:ont00000984 ;
    skos:definition "A role that inheres in a person in virtue of an employment relationship with an organization, realized in the Act of Working the person carries out for that organization. Equivalent to CCO Occupation Role."@en ;
    skos:example "The role Jane bears as a data engineer at ACME."@en .

personnel:ActOfWorking a owl:Class ;
    rdfs:label "Act of Working"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty personnel:forOrganization ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:onProperty abi:occursIn ;
            owl:someValuesFrom abi:Site ],
        [ a owl:Restriction ;
            owl:onProperty abi:occupiesTemporalRegion ;
            owl:someValuesFrom abi:TemporalRegion ],
        [ a owl:Restriction ;
            owl:onProperty abi:realizes ;
            owl:someValuesFrom personnel:EmployeeRole ],
        [ a owl:Restriction ;
            owl:onProperty personnel:developsSkill ;
            owl:someValuesFrom personnel:Skill ],
        [ a owl:Restriction ;
            owl:onProperty personnel:hasContract ;
            owl:someValuesFrom personnel:EmploymentContract ],
        cco:ont00000228,
        cco:ont00001226 ;
    skos:definition "A Planned Act, and an Act of Employment, in which a person performs work for an organization at a site over a temporal region, realizing an employee role, developing skills, under an employment contract."@en ;
    skos:example "Alice Dupont working as Head of Product for Demo, worldwide, since April 2023."@en .

personnel:Skill a owl:Class ;
    rdfs:label "Skill"@en ;
    rdfs:comment "Borne by the person, not by the process: the skill outlives any one act of working. personnel:developsSkill links the act to the skills exercised and grown in it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:inheresIn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty personnel:isSkillDevelopedIn ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( personnel:ActOfWorking personnel:ActOfStudying ) ] ],
        abi:Quality ;
    skos:definition "A quality that inheres in a person, consisting in a learned capacity to perform a kind of task, developed and exercised in the acts of working the person carries out."@en ;
    skos:example "Python (Programming Language); Business Analysis; SAP BFC."@en .

