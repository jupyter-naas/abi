personnel:isSourcedFrom a owl:ObjectProperty ;
    rdfs:label "is sourced from"@en ;
    rdfs:domain abi:GenericallyDependentContinuant ;
    rdfs:range personnel:ProfileDocument ;
    rdfs:subPropertyOf cco:ont00001808 ;
    owl:inverseOf personnel:isSourceOf ;
    skos:definition "Relates an information content entity to the profile document it was read from."@en .

<http://ontology.naas.ai/personnel/Site/france> a abi:Site,
        owl:NamedIndividual ;
    rdfs:label "France" ;
    dcterms:created "2026-08-19T17:41:38.075986"^^xsd:dateTime ;
    dcterms:creator "demo_graph_builder" .

<http://ontology.naas.ai/abi/Organization/demo> a abi:Organization,
        owl:NamedIndividual ;
    rdfs:label "Demo" ;
    dcterms:created "2026-08-19T17:41:38.042348"^^xsd:dateTime ;
    dcterms:creator "demo_graph_builder" .

personnel:EnrollmentRecord a owl:Class ;
    rdfs:label "Enrollment Record"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isSourcedFrom ;
            owl:someValuesFrom personnel:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom personnel:ActOfStudying ],
        [ a owl:Restriction ;
            owl:onProperty personnel:isEnrollmentRecordOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom cco:ont00000564 ],
        abi:GenericallyDependentContinuant ;
    skos:definition "An information content entity that documents a person's enrollment in a curriculum at an educational organization, including the programme name and its start and end dates."@en ;
    skos:example "Enrollment in the Computer Science licence at Université de Rennes 1, 2009-09-01 to 2014-06-30."@en .

<http://ontology.naas.ai/personnel/Site/paris> a abi:Site,
        owl:NamedIndividual ;
    rdfs:label "Paris" ;
    dcterms:created "2026-08-19T17:41:38.072008"^^xsd:dateTime ;
    dcterms:creator "demo_graph_builder" .

personnel:EmploymentStatus a owl:Class ;
    rdfs:label "Employment Status"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isEmploymentStatusOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:concretizes ;
            owl:someValuesFrom personnel:EmploymentRecord ],
        abi:Quality ;
    skos:definition "A quality that inheres in a person and holds the state of their employment relationship at a point in time."@en ;
    skos:example "'on-leave' for a person on parental leave."@en .

personnel:JobDescription a owl:Class ;
    rdfs:label "Job Description"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Organization ],
        abi:DocumentContentEntity ;
    skos:definition "A document content entity that states the duties, responsibilities and requirements of a job position."@en ;
    skos:example "The published job description for 'Senior Data Engineer, EMEA'."@en .

