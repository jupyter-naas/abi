personnel:ActOfStudyingProcess a owl:Ontology ;
    abi:ontologyResource "ontologies/processes/ActOfStudyingProcess.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
    abi:pythonResource "ontologies/processes/ActOfStudyingProcess.py" ;
    dc:contributor "Alice Dupont",
        "Emma Petit",
        "Grace Lambert" ;
    dc:date "2026-08-19"^^xsd:date ;
    dcterms:description "Process slice for the act of studying - a CCO Planned Act (Act of Educational Training Acquisition) in which a person acquires knowledge of a curriculum from an educational organization at a site over a temporal region, realizing a student role, developing skills, and concretizing an enrollment record and academic degree."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Act of Studying Process Ontology"@en ;
    rdfs:comment "Process slice for Act of Studying. Reuses shared personnel classes and ProfileDocument from ActOfWorkingProcess."@en ;
    rdfs:member "bpl-processes/personnel" ;
    rdfs:seeAlso personnel:PersonnelOntology ;
    owl:imports abi:Ontology,
        cco:AgentOntology,
        cco:EventOntology,
        cco:InformationEntityOntology .

personnel:ActOfWorkingProcess a owl:Ontology ;
    abi:ontologyResource "ontologies/processes/ActOfWorkingProcess.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
    abi:pythonResource "ontologies/processes/ActOfWorkingProcess.py" ;
    dc:contributor "Alice Dupont",
        "Emma Petit",
        "Grace Lambert" ;
    dc:date "2026-08-18"^^xsd:date ;
    dcterms:description "Process slice for the act of working - a CCO Planned Act (and Act of Employment) in which a person performs work for an organization at a site over a temporal region, realizing an employee role that concretizes a mission, developing the skills the person bears, and concretizing an employment contract."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Act of Working Process Ontology"@en ;
    rdfs:comment "Process slice for Act of Working. Reuses shared personnel classes."@en ;
    rdfs:member "bpl-processes/personnel" ;
    rdfs:seeAlso personnel:PersonnelOntology ;
    owl:imports abi:Ontology,
        cco:AgentOntology,
        cco:EventOntology,
        cco:InformationEntityOntology .

