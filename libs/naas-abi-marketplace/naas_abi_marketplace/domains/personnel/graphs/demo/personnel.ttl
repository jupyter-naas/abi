personnel:Certification a owl:Class ;
    rdfs:label "Certification"@en ;
    rdfs:comment "Covers both certifications and licences: the difference is who may withhold it and what it permits, not what kind of entity it is. Where that distinction matters, state it with personnel:certification_status and the issuing organization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isCertificationOf ;
            owl:someValuesFrom abi:Person ],
        abi:GenericallyDependentContinuant,
        cco:ont00002002 ;
    skos:definition "A certificate issued to a person by an organization to attest that they have demonstrated a competence, met a professional standard, or hold a licence to practise. Subclass of CCO Certificate, sibling of personnel:AcademicDegree."@en ;
    skos:example "Certified Information Systems Auditor, issued by ISACA in 2019; Commissaire aux comptes."@en .

personnel:ActOfStudying a owl:Class ;
    rdfs:label "Act of Studying"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty personnel:forEducationalOrganization ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:onProperty abi:occursIn ;
            owl:someValuesFrom abi:Site ],
        [ a owl:Restriction ;
            owl:onProperty abi:occupiesTemporalRegion ;
            owl:someValuesFrom abi:TemporalRegion ],
        [ a owl:Restriction ;
            owl:onProperty personnel:hasEnrollment ;
            owl:someValuesFrom personnel:EnrollmentRecord ],
        [ a owl:Restriction ;
            owl:onProperty personnel:hasDegree ;
            owl:someValuesFrom personnel:AcademicDegree ],
        [ a owl:Restriction ;
            owl:onProperty abi:realizes ;
            owl:someValuesFrom personnel:StudentRole ],
        [ a owl:Restriction ;
            owl:onProperty personnel:developsSkill ;
            owl:someValuesFrom personnel:Skill ],
        cco:ont00000228,
        cco:ont00001074 ;
    skos:definition "A Planned Act, and an Act of Educational Training Acquisition, in which a person acquires knowledge of a curriculum from an educational organization at a site over a temporal region, realizing a student role, developing skills, under an enrollment record and academic degree."@en ;
    skos:example "Alice Dupont studying for a Master's Degree in Corporate Finance at KEDGE Business School in Bordeaux from 2012 to 2016."@en .

personnel:EmploymentContract a owl:Class ;
    rdfs:label "Employment Contract"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom personnel:ActOfWorking ],
        abi:GenericallyDependentContinuant ;
    skos:definition "A generically dependent continuant that specifies the terms under which a person works for an organization."@en ;
    skos:example "Permanent contract CDI - Alice Dupont / naas.ai."@en .

personnel:LanguageCapability a owl:Class ;
    rdfs:label "Language Capability"@en ;
    rdfs:comment "Deliberately NOT equivalent to CCO Language Skill (cco:ont00000181). That class is an Agent Capability and therefore a BFO realizable entity, which is disjoint from quality; this domain already models personnel:Skill as a quality, and asserting both would make the ontology inconsistent. The language itself is a CCO Language, reached through personnel:ofLanguage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isLanguageCapabilityOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty personnel:ofLanguage ;
            owl:someValuesFrom cco:ont00001175 ],
        abi:Quality ;
    skos:definition "A quality that inheres in a person and holds how well they can communicate in one language."@en ;
    skos:example "Spanish at native or bilingual proficiency."@en .

