personnel:developsSkill a owl:ObjectProperty ;
    rdfs:label "develops skill"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( personnel:ActOfWorking personnel:ActOfStudying ) ] ;
    rdfs:range personnel:Skill ;
    owl:inverseOf personnel:isSkillDevelopedIn ;
    skos:definition "Relates an act of working or studying to a skill exercised and developed in the course of it."@en .

personnel:ActOfPersonnelProfiling a owl:Class ;
    rdfs:label "Act of Personnel Profiling"@en ;
    rdfs:comment "Orchestration only. Episode triples are written by the working and studying pipelines; summary, certifications and social proof by the person profile pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty personnel:fromProfileDocument ;
            owl:someValuesFrom personnel:ProfileDocument ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which a person is registered in the knowledge graph from a published profile document: working and studying episodes plus person-level presentation facts, with provenance on the document URL."@en ;
    skos:example "Registering Alice Dupont from https://demo.example/profiles/alice_dupont into the personnel graph."@en .

