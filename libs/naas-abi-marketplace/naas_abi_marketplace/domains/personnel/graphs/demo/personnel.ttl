personnel:EmploymentStatus a owl:Class ;
    rdfs:label "Employment Status"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty personnel:isEmploymentStatusOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:concretizes ;
            owl:someValuesFrom personnel:EmploymentRecord ],
        abi:Quality ;
    skos:definition "A quality that inheres in a person and holds the state of their employment relationship at a point in time."@en ;
    skos:example "'on-leave' for a person on parental leave."@en .

personnel:PersonnelOntology a owl:Ontology ;
    abi:ontologyResource "ontologies/modules/PersonnelOntology.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
    abi:pythonResource "ontologies/modules/PersonnelOntology.py" ;
    dc:contributor "Alice Dupont" ;
    dc:date "2026-08-18"^^xsd:date ;
    dcterms:description "Shared vocabulary for the personnel (S1) domain: the person, the employee and student roles they bear, the job position an employee role concretizes, and the records, contracts and qualities that outlive any one process. It also holds what a person is presented as: the profile summary and portrait published for them, the certifications they hold, the languages they speak, the interests they bear, the recommendations others write about them, and the grade and service line their employment places them in. Process slices (ActOfWorkingProcess, ActOfStudyingProcess, PersonnelProfilingProcess) import nothing from this file; this ontology imports them and they restrict these classes in context."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Personnel Ontology"@en ;
    rdfs:comment "Shared personnel classes. Process restrictions live in ontologies/processes/."@en ;
    rdfs:seeAlso <https://raw.githubusercontent.com/jupyter-naas/abi/refs/heads/main/libs/naas-abi-marketplace/naas_abi_marketplace/domains/personnel/ontologies/modules/PersonnelOntology.ttl> ;
    owl:imports abi:Ontology,
        personnel:ActOfStudyingProcess,
        personnel:ActOfWorkingProcess,
        personnel:PersonnelProfilingProcess,
        cco:AgentOntology,
        cco:InformationEntityOntology,
        cco:QualityOntology .

