<http://ontology.naas.ai/abi/Organization/demo-institute> a abi:Organization,
        owl:NamedIndividual ;
    rdfs:label "Demo Institute" ;
    dcterms:created "2026-10-02T15:09:23.488432"^^xsd:dateTime ;
    dcterms:creator "DemoPersonnelGraphWorkflow" .

