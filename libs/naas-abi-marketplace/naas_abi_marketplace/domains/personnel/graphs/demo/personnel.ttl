personnel:Remuneration a owl:Class ;
    rdfs:label "Remuneration"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:inheresIn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:participatesIn ;
            owl:someValuesFrom personnel:ActOfWorking ],
        abi:Quality ;
    skos:definition "A quality borne by a person that specifies what they are paid for their work."@en ;
    skos:example "95000 EUR per year."@en .

