<http://ontology.naas.ai/personnel/ProfileSummary/alice-dupont> a personnel:ProfileSummary,
        owl:NamedIndividual ;
    rdfs:label "COO, Demo - platform operations and agent orchestration" ;
    personnel:headline_text "COO, Demo - platform operations and agent orchestration" ;
    personnel:isProfileSummaryOf <http://ontology.naas.ai/abi/Person/alice-dupont> ;
    personnel:isSourcedFrom <http://ontology.naas.ai/personnel/ProfileDocument/alice-dupont-linkedin> ;
    personnel:quote_content "An operating model is only real once someone is on call for it." ;
    personnel:summary_content "Runs platform operations at Demo, where she is responsible for how agents are deployed, monitored and retired. Came to operations from data engineering, and still writes the tooling her team runs on." ;
    personnel:years_of_experience 12 ;
    dcterms:created "2026-09-21T08:31:08.436687"^^xsd:dateTime ;
    dcterms:creator "DemoPersonGraphWorkflow" .

