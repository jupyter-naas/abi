personnel:hasStudyLocation a owl:ObjectProperty ;
    rdfs:label "has study location"@en ;
    rdfs:domain abi:Person ;
    rdfs:range abi:Site ;
    owl:inverseOf personnel:isStudyLocationOf ;
    skos:definition "Convenience relation from a person to a site at which an act of studying they participate in is executed. Derived from ActOfStudying + occursIn; not a BFO primitive."@en .

personnel:hasWorkLocation a owl:ObjectProperty ;
    rdfs:label "has work location"@en ;
    rdfs:domain abi:Person ;
    rdfs:range abi:Site ;
    owl:inverseOf personnel:isWorkLocationOf ;
