personnel:PersonnelProfilingProcess a owl:Ontology ;
    abi:ontologyResource "ontologies/processes/PersonnelProfilingProcess.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
    abi:pythonResource "ontologies/processes/PersonnelProfilingProcess.py" ;
    dc:contributor "Alice Dupont" ;
    dc:date "2026-09-18"^^xsd:date ;
    dcterms:description "Process slice for personnel profiling: a planned act in which statements from a published profile document are registered as acts of working, acts of studying and person-level directory facts without duplicating episode data in a second store."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Personnel Profiling Process Ontology"@en ;
    rdfs:comment "Runtime: register_profile_from_source. NCOR ledger entry personnel-profiling.ttl (upstream)."@en ;
    rdfs:member "bpl-processes/personnel" ;
    rdfs:seeAlso personnel:PersonnelOntology ;
    owl:imports abi:Ontology,
        cco:AgentOntology,
        cco:EventOntology,
        cco:InformationEntityOntology .

