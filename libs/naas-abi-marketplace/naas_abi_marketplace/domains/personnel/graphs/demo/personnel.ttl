abi:Organization rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasAssessmentFacility ;
            owl:someValuesFrom cco:ont00000192 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasOfficeBuilding ;
            owl:someValuesFrom cco:ont00000468 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasAssessmentFacility ;
            owl:someValuesFrom cco:ont00000192 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasOfficeBuilding ;
            owl:someValuesFrom cco:ont00000468 ] .

abi:Person rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasCertificationFacility ;
            owl:someValuesFrom cco:ont00000192 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasWorkFacility ;
            owl:someValuesFrom cco:ont00000468 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasCertificationFacility ;
            owl:someValuesFrom cco:ont00000192 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasStudyFacility ;
            owl:someValuesFrom cco:ont00000270 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasWorkFacility ;
            owl:someValuesFrom cco:ont00000468 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasStudyFacility ;
            owl:someValuesFrom cco:ont00000270 ] .

