cco:ont00000564 rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasEducationalFacility ;
            owl:someValuesFrom cco:ont00000270 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasEducationalFacility ;
            owl:someValuesFrom cco:ont00000270 ] .

<http://ontology.naas.ai/people/ProfileDocument/alice-dupont-linkedin> a abi:ProfileDocument,
        owl:NamedIndividual ;
    rdfs:label "LinkedIn experience - Alice Dupont" ;
    abi:isProfileDocumentOf <http://ontology.naas.ai/abi/Person/alice-dupont> ;
    abi:source_url "https://demo.example/profiles/alice_dupont" ;
    dcterms:created "2026-10-02T15:09:23.476147"^^xsd:dateTime ;
    dcterms:creator "DemoPersonnelGraphWorkflow" .

abi:developsLanguageCapability a owl:ObjectProperty ;
    rdfs:label "develops language capability"@en ;
    rdfs:domain cco:ont00000228 ;
    rdfs:range abi:LanguageCapability ;
    owl:inverseOf abi:isLanguageCapabilityDevelopedIn ;
    skos:definition "Relates a planned act (an act of working, of studying or of certification) to a language capability exercised and developed in the course of it."@en .

abi:Remuneration a owl:Class ;
    rdfs:label "Remuneration"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:inheresIn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:participatesIn ;
            owl:someValuesFrom abi:ActOfEmployment ],
        abi:Quality ;
    skos:definition "A quality borne by a person that specifies what they are paid for their work."@en ;
    skos:example "95000 EUR per year."@en .

abi:AcademicDegree a owl:Class ;
    rdfs:label "Academic Degree"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:isSourcedFrom ;
            owl:someValuesFrom abi:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:isSourcedFrom ;
            owl:someValuesFrom abi:ProfileDocument ],
        abi:GenericallyDependentContinuant ;
    owl:equivalentClass cco:ont00002003 ;
    skos:definition "A certificate issued by an educational organization to a person to indicate that the person has satisfactorily completed a course of study. Equivalent to CCO Academic Degree."@en ;
    skos:example "Licence Informatique, Université de Rennes 1."@en .

abi:ActOfProfiling a owl:Class ;
    rdfs:label "Act of Profiling"@en ;
    rdfs:comment "Orchestration only. Episode triples are written by the working and studying pipelines; summary, certifications and social proof by the person profile pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:fromProfileDocument ;
            owl:someValuesFrom abi:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:fromProfileDocument ;
            owl:someValuesFrom abi:ProfileDocument ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which a person is registered in the knowledge graph from a published profile document: working and studying episodes plus person-level presentation facts, with provenance on the document URL."@en ;
    skos:example "Registering Alice Dupont from https://demo.example/profiles/alice_dupont into the people graph."@en .

abi:StudentRole a owl:Class ;
    rdfs:label "Student Role"@en ;
    rdfs:comment "No CCO student-role class; minted in the people namespace. Ends when the enrollment ends, without the person ceasing to exist."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isStudentRoleOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasRealization ;
            owl:someValuesFrom abi:ActOfStudying ],
        abi:Role ;
    skos:definition "A role that inheres in a person in virtue of being enrolled in a curriculum at an educational organization, realized in the Act of Studying."@en ;
    skos:example "The role Florent bears as a computer-science student at Université de Rennes 1."@en .

abi:hasSourceDocument a owl:ObjectProperty ;
    rdfs:label "has source document"@en ;
    rdfs:domain cco:ont00000228 ;
    rdfs:range abi:ProfileDocument ;
    rdfs:subPropertyOf cco:ont00001808 ;
    owl:inverseOf abi:isSourceDocumentOf ;
    skos:definition "Relates a planned act to the profile document it was read from and registered against."@en .

abi:ServiceLine a owl:Class ;
    rdfs:label "Service Line"@en ;
    rdfs:comment "An organization in its own right, not a label on a person: it has its own members, its own leadership and can be reorganized without any person changing. A person reaches their service line through the employee role they bear (abi:inServiceLine)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isServiceLineOf ;
            owl:someValuesFrom abi:Organization ],
        abi:Organization ;
    skos:definition "An organization that is a member part of a larger organization and groups the people who deliver one kind of service."@en ;
    skos:example "Audit; Tax; Advisory; Financial Advisory Services."@en .

abi:CertificationCandidateRole a owl:Class ;
    rdfs:label "Certification Candidate Role"@en ;
    rdfs:comment "No CCO candidate-role class; minted in the people namespace. Kept apart from the occupation and student roles: a person is a candidate whether or not they were working or enrolled at the time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isCertificationCandidateRoleOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasRealization ;
            owl:someValuesFrom abi:ActOfCertification ],
        [ a owl:Restriction ;
            owl:onProperty abi:isCertificationCandidateRoleOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasRealization ;
            owl:someValuesFrom abi:ActOfCertification ],
        abi:Role ;
    skos:definition "A role that inheres in a person in virtue of being assessed by a certifying organization for a certification, realized in the Act of Certification."@en ;
    skos:example "The role Alice Dupont bears as a candidate for the Certified Information Systems Auditor certification."@en .

abi:isSourcedFrom a owl:ObjectProperty ;
    rdfs:label "is sourced from"@en ;
    rdfs:domain abi:GenericallyDependentContinuant ;
    rdfs:range abi:ProfileDocument ;
    rdfs:subPropertyOf cco:ont00001808 ;
    owl:inverseOf abi:isSourceOf ;
    skos:definition "Relates an information content entity to the profile document it was read from."@en .

abi:Recommendation a owl:Class ;
    rdfs:label "Recommendation"@en ;
    rdfs:comment "Two people, and both are required: the subject it generically depends on, and the author who wrote it. An anonymous testimonial is not a recommendation in this sense and must not be minted as one."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isRecommendationOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasRecommendationAuthor ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:participatesIn ;
            owl:someValuesFrom abi:ActOfProfiling ],
        abi:DocumentContentEntity ;
    skos:definition "A document content entity in which one person states, in their own words, what it was like to work with another and what that person is good at."@en ;
    skos:example "'Alice rebuilt our close process in one quarter' - written by her former CFO, 2024-11-02."@en .

abi:EmploymentStatus a owl:Class ;
    rdfs:label "Employment Status"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isEmploymentStatusOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:concretizes ;
            owl:someValuesFrom abi:EmploymentRecord ],
        [ a owl:Restriction ;
            owl:onProperty abi:participatesIn ;
            owl:someValuesFrom abi:ActOfEmployment ],
        abi:Quality ;
    skos:definition "A quality that inheres in a person and holds the state of their employment relationship at a point in time."@en ;
    skos:example "'on-leave' for a person on parental leave."@en .

abi:Grade a owl:Class ;
    rdfs:label "Grade"@en ;
    rdfs:comment "Kept apart from abi:job_position_title, which names a position, and from abi:EmployeeRole, which is what the person bears. Two people with the same grade can hold different positions, and the same position can be held at different grades."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isGradeOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:participatesIn ;
            owl:someValuesFrom abi:ActOfEmployment ],
        abi:Quality ;
    skos:definition "A quality that inheres in a person and holds the seniority level the employing organization recognises for them."@en ;
    skos:example "'Partner' for a person admitted to the partnership."@en .

abi:Portrait a owl:Class ;
    rdfs:label "Portrait"@en ;
    rdfs:comment "The individual carries the address of the image (abi:portrait_url or abi:portrait_path), never the bytes. Image data belongs in object storage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:participatesIn ;
            owl:someValuesFrom abi:ActOfProfiling ],
        [ a owl:Restriction ;
            owl:onProperty abi:isPortraitOf ;
            owl:someValuesFrom abi:Person ],
        abi:GenericallyDependentContinuant,
        cco:ont00002004 ;
    skos:definition "An image that depicts a person, published to identify them. Subclass of CCO Image."@en ;
    skos:example "The photograph published on a person's directory page."@en .

<http://ontology.naas.ai/people/Site/paris> a abi:Site,
        owl:NamedIndividual ;
    rdfs:label "Paris" ;
    dcterms:created "2026-10-02T15:09:23.484136"^^xsd:dateTime ;
    dcterms:creator "DemoPersonnelGraphWorkflow" .

abi:JobDescription a owl:Class ;
    rdfs:label "Job Description"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:onProperty abi:participatesIn ;
            owl:someValuesFrom abi:ActOfEmployment ],
        abi:DocumentContentEntity ;
    skos:definition "A document content entity that states the duties, responsibilities and requirements of a job position."@en ;
    skos:example "The published job description for 'Senior Data Engineer, EMEA'."@en .

abi:Interest a owl:Class ;
    rdfs:label "Interest"@en ;
    rdfs:comment "Modelled as a quality for consistency with abi:Skill rather than as a disposition. Points at its target with abi:hasInterestTarget where an individual exists for it, and otherwise carries abi:interest_name alone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isInterestOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:participatesIn ;
            owl:someValuesFrom abi:ActOfProfiling ],
        abi:Quality ;
    skos:definition "A quality that inheres in a person and holds what they follow, care about or give their attention to outside the duties of any one job."@en ;
    skos:example "Ocean conservation; the alumni association of a school they attended."@en .

abi:ActOfStudying a owl:Class ;
    rdfs:label "Act of Studying"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:forEducationalOrganization ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:onProperty abi:occursIn ;
            owl:someValuesFrom cco:ont00000270 ],
        [ a owl:Restriction ;
            owl:onProperty abi:occupiesTemporalRegion ;
            owl:someValuesFrom abi:TemporalRegion ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasEnrollment ;
            owl:someValuesFrom abi:EnrollmentRecord ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasDegree ;
            owl:someValuesFrom abi:AcademicDegree ],
        [ a owl:Restriction ;
            owl:onProperty abi:realizes ;
            owl:someValuesFrom abi:StudentRole ],
        [ a owl:Restriction ;
            owl:onProperty abi:developsSkill ;
            owl:someValuesFrom abi:Skill ],
        [ a owl:Restriction ;
            owl:onProperty abi:developsLanguageCapability ;
            owl:someValuesFrom abi:LanguageCapability ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasSourceDocument ;
            owl:someValuesFrom abi:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasSourceDocument ;
            owl:someValuesFrom abi:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:forEducationalOrganization ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:onProperty abi:occursIn ;
            owl:someValuesFrom cco:ont00000270 ],
        [ a owl:Restriction ;
            owl:onProperty abi:occupiesTemporalRegion ;
            owl:someValuesFrom abi:TemporalRegion ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasEnrollment ;
            owl:someValuesFrom abi:EnrollmentRecord ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasDegree ;
            owl:someValuesFrom abi:AcademicDegree ],
        [ a owl:Restriction ;
            owl:onProperty abi:realizes ;
            owl:someValuesFrom abi:StudentRole ],
        [ a owl:Restriction ;
            owl:onProperty abi:developsSkill ;
            owl:someValuesFrom abi:Skill ],
        [ a owl:Restriction ;
            owl:onProperty abi:developsLanguageCapability ;
            owl:someValuesFrom abi:LanguageCapability ],
        cco:ont00000228,
        cco:ont00001074 ;
    skos:definition "A Planned Act, and an Act of Educational Training Acquisition, in which a person acquires knowledge of a curriculum from an educational organization in an educational facility over a temporal region, realizing a student role, developing skills and language capabilities, under an enrollment record and academic degree."@en ;
    skos:example "Alice Dupont studying for a Master's Degree in Corporate Finance at KEDGE Business School in Bordeaux from 2012 to 2016."@en .

abi:EnrollmentRecord a owl:Class ;
    rdfs:label "Enrollment Record"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isEnrollmentRecordOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom cco:ont00000564 ],
        [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom abi:ActOfStudying ],
        [ a owl:Restriction ;
            owl:onProperty abi:isSourcedFrom ;
            owl:someValuesFrom abi:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:isSourcedFrom ;
            owl:someValuesFrom abi:ProfileDocument ],
        abi:GenericallyDependentContinuant ;
    skos:definition "An information content entity that documents a person's enrollment in a curriculum at an educational organization, including the programme name and its start and end dates."@en ;
    skos:example "Enrollment in the Computer Science licence at Université de Rennes 1, 2009-09-01 to 2014-06-30."@en .

abi:ProfileSummary a owl:Class ;
    rdfs:label "Profile Summary"@en ;
    rdfs:comment "Person-level, where abi:Mission is job-level: the summary spans a career, a mission describes one act of working. Sourced from a ProfileDocument so every claim it carries stays traceable to where it was published."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isProfileSummaryOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:isSourcedFrom ;
            owl:someValuesFrom abi:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:participatesIn ;
            owl:someValuesFrom abi:ActOfProfiling ],
        abi:DocumentContentEntity ;
    skos:definition "A document content entity that states how a person is presented in general: the one-line headline, the paragraph about them, an attributed quote, and the years of experience claimed for them."@en ;
    skos:example "The headline and 'About' paragraph on a person's published directory page."@en .

<http://ontology.naas.ai/people/Site/remote> a abi:Site,
        owl:NamedIndividual ;
    rdfs:label "Remote" ;
    dcterms:created "2026-10-02T15:09:23.481765"^^xsd:dateTime ;
    dcterms:creator "DemoPersonnelGraphWorkflow" .

abi:EmploymentContract a owl:Class ;
    rdfs:label "Employment Contract"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom abi:ActOfEmployment ],
        abi:GenericallyDependentContinuant ;
    skos:definition "A document content entity that specifies the terms under which a person works for an organization."@en ;
    skos:example "Permanent contract CDI - Alice Dupont / naas.ai."@en .

abi:EmploymentRecord a owl:Class ;
    rdfs:label "Employment Record"@en ;
    rdfs:comment "Generically dependent on the person: the same record can be copied between systems without ceasing to be the record of that person. Concretized by the Act of Working that the relationship consists in."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isEmploymentRecordOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom abi:ActOfEmployment ],
        abi:GenericallyDependentContinuant ;
    skos:definition "An information content entity that documents an employment relationship between a person and an organization, including its identifier and its start and end dates."@en ;
    skos:example "The HR system record for employee E-10428, hired 2024-03-01."@en .

abi:JobPosition a owl:Class ;
    rdfs:label "Job Position"@en ;
    rdfs:comment "Deliberately NOT a subclass of abi:Role. A BFO role must inhere in a bearer, but an open requisition has no occupant. Occupied positions are concretized by abi:EmployeeRole (allValuesFrom, not someValuesFrom, so a vacant position remains satisfiable)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:allValuesFrom abi:EmployeeRole ;
            owl:onProperty abi:isConcretizedBy ],
        [ a owl:Restriction ;
            owl:onProperty abi:participatesIn ;
            owl:someValuesFrom abi:ActOfEmployment ],
        abi:GenericallyDependentContinuant ;
    skos:definition "An information content entity, defined by an organization as part of its structure, that specifies a role to be borne by whoever fills it. Fundable and referable independently of any occupant, and possibly vacant."@en ;
    skos:example "Requisition R-2291, 'Senior Data Engineer, EMEA', currently vacant."@en .

abi:EmployeeRole a owl:Class ;
    rdfs:label "Employee Role"@en ;
    rdfs:comment "Externally grounded: it exists only while the employment relationship holds, and ends without the person ceasing to exist. Concretizes a JobPosition (possibly filling a previously vacant requisition)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isEmployeeRoleOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasRealization ;
            owl:someValuesFrom abi:ActOfEmployment ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasJobPosition ;
            owl:someValuesFrom abi:JobPosition ],
        abi:OccupationRole ;
    skos:definition "A role that inheres in a person in virtue of an employment relationship with an organization, realized in the Act of Working the person carries out for that organization. A specialization of abi:OccupationRole: the occupation as the employing organization records it about its own staff."@en ;
    skos:example "The role Jane bears as a data engineer at ACME."@en .

abi:ActOfCertification a owl:Class ;
    rdfs:label "Act of Certification"@en ;
    rdfs:comment "No CCO act of certification; the process is a direct subclass of CCO Planned Act. The act is not the certificate: it ends when the certification is awarded, whereas the Certification persists and may later expire."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:forCertifyingOrganization ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:onProperty abi:occursIn ;
            owl:someValuesFrom cco:ont00000192 ],
        [ a owl:Restriction ;
            owl:onProperty abi:occupiesTemporalRegion ;
            owl:someValuesFrom abi:TemporalRegion ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasAwardedCertification ;
            owl:someValuesFrom abi:Certification ],
        [ a owl:Restriction ;
            owl:onProperty abi:realizes ;
            owl:someValuesFrom abi:CertificationCandidateRole ],
        [ a owl:Restriction ;
            owl:onProperty abi:demonstratesSkill ;
            owl:someValuesFrom abi:Skill ],
        [ a owl:Restriction ;
            owl:onProperty abi:developsLanguageCapability ;
            owl:someValuesFrom abi:LanguageCapability ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasSourceDocument ;
            owl:someValuesFrom abi:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:forCertifyingOrganization ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:onProperty abi:occursIn ;
            owl:someValuesFrom cco:ont00000192 ],
        [ a owl:Restriction ;
            owl:onProperty abi:occupiesTemporalRegion ;
            owl:someValuesFrom abi:TemporalRegion ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasAwardedCertification ;
            owl:someValuesFrom abi:Certification ],
        [ a owl:Restriction ;
            owl:onProperty abi:realizes ;
            owl:someValuesFrom abi:CertificationCandidateRole ],
        [ a owl:Restriction ;
            owl:onProperty abi:demonstratesSkill ;
            owl:someValuesFrom abi:Skill ],
        [ a owl:Restriction ;
            owl:onProperty abi:developsLanguageCapability ;
            owl:someValuesFrom abi:LanguageCapability ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasSourceDocument ;
            owl:someValuesFrom abi:ProfileDocument ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which a certifying organization attests that a person has demonstrated a competence, met a professional standard or holds a licence to practise, realizing a certification candidate role and concretizing the certification it awards."@en ;
    skos:example "Alice Dupont being certified as a Certified Information Systems Auditor by ISACA in 2019."@en .

abi:ActOfEmployment a owl:Class ;
    rdfs:label "Act of Employment"@en ;
    rdfs:comment "Everything the act of working states (organization, client, site, temporal region, occupation role, mission, skills, profile document) is inherited and stays in the people graph. The act of employment adds the employer's records: the employee role and the contract."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:realizes ;
            owl:someValuesFrom abi:EmployeeRole ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasContract ;
            owl:someValuesFrom abi:EmploymentContract ],
        abi:ActOfWorking,
        cco:ont00001226 ;
    skos:definition "An Act of Working, and a CCO Act of Employment, that a person performs for the organization that employs them, realizing an employee role under an employment contract."@en ;
    skos:example "Alice Dupont working as Head of Product for Demo under a permanent contract, as Demo's HR system records it."@en .

<http://ontology.naas.ai/abi/Person/david-leroy> a abi:Person,
        owl:NamedIndividual,
        cco:ont00000562 ;
    rdfs:label "David Leroy" ;
    abi:first_name "David" ;
