abi:PersonnelOntology a owl:Ontology ;
    abi:ontologyResource "ontologies/modules/PersonnelOntology.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.personnel" ;
    abi:pythonResource "ontologies/modules/PersonnelOntology.py" ;
    dc:contributor "Alice Dupont" ;
    dc:date "2026-10-02"^^xsd:date ;
    dcterms:description "Internal vocabulary for the personnel (S1) domain: what an organization records about its own staff - the employee role a person bears while employed, the job position it concretizes and the job description of that position, the employment record and contract that document the relationship, and the employment status, remuneration, grade and service line the organization assigns. Every class specializes or relates to the people intelligence vocabulary (PeopleOntology), which it imports: an act of employment is an act of working, an employee role is an occupation role. Nothing in PeopleOntology refers back here."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Personnel Ontology"@en ;
    rdfs:comment "Internal HR classes. The generic person, working, studying and profile vocabulary is people:, in intelligence/modules/people."@en ;
    rdfs:seeAlso <https://raw.githubusercontent.com/jupyter-naas/abi/refs/heads/main/libs/naas-abi-marketplace/naas_abi_marketplace/domains/personnel/ontologies/modules/PersonnelOntology.ttl> ;
    owl:imports abi:Ontology,
        abi:PeopleOntology,
        abi:ActOfEmploymentProcess,
        cco:AgentOntology,
        cco:InformationEntityOntology,
        cco:QualityOntology .

