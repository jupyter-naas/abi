abi:ActOfWorking a owl:Class ;
    rdfs:label "Act of Working"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:forOrganization ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:onProperty abi:occursIn ;
            owl:someValuesFrom cco:ont00000468 ],
        [ a owl:Restriction ;
            owl:onProperty abi:occupiesTemporalRegion ;
            owl:someValuesFrom abi:TemporalRegion ],
        [ a owl:Restriction ;
            owl:onProperty abi:realizes ;
            owl:someValuesFrom abi:OccupationRole ],
        [ a owl:Restriction ;
            owl:onProperty abi:developsSkill ;
            owl:someValuesFrom abi:Skill ],
        [ a owl:Restriction ;
            owl:onProperty abi:developsLanguageCapability ;
            owl:someValuesFrom abi:LanguageCapability ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasSourceDocument ;
            owl:someValuesFrom abi:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasParticipant ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:forOrganization ;
            owl:someValuesFrom abi:Organization ],
        [ a owl:Restriction ;
            owl:onProperty abi:occursIn ;
            owl:someValuesFrom cco:ont00000468 ],
        [ a owl:Restriction ;
            owl:onProperty abi:occupiesTemporalRegion ;
            owl:someValuesFrom abi:TemporalRegion ],
        [ a owl:Restriction ;
            owl:onProperty abi:realizes ;
            owl:someValuesFrom abi:OccupationRole ],
        [ a owl:Restriction ;
            owl:onProperty abi:developsSkill ;
            owl:someValuesFrom abi:Skill ],
        [ a owl:Restriction ;
            owl:onProperty abi:developsLanguageCapability ;
            owl:someValuesFrom abi:LanguageCapability ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasSourceDocument ;
            owl:someValuesFrom abi:ProfileDocument ],
        cco:ont00000228 ;
    skos:definition "A Planned Act in which a person performs work for an organization in an office building over a temporal region, realizing an occupation role and developing skills and language capabilities."@en ;
    skos:example "Alice Dupont working as Head of Product for Demo, worldwide, since April 2023."@en .

