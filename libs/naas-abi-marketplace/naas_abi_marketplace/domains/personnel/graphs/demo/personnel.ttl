personnel:forEducationalOrganization a owl:ObjectProperty ;
    rdfs:label "for educational organization"@en ;
    rdfs:domain personnel:ActOfStudying ;
    rdfs:range abi:Organization ;
    rdfs:subPropertyOf abi:hasParticipant ;
    owl:inverseOf personnel:isEducationalOrganizationOfStudying ;
    skos:definition "Relates an act of studying to the educational organization that participates as the training provider."@en .

personnel:forOrganization a owl:ObjectProperty ;
    rdfs:label "for organization"@en ;
    rdfs:domain personnel:ActOfWorking ;
    rdfs:range abi:Organization ;
    rdfs:subPropertyOf abi:hasParticipant ;
    owl:inverseOf personnel:isOrganizationOfWorking ;
    skos:definition "Relates an act of working to the organization that participates as employer."@en .

personnel:fromProfileDocument a owl:ObjectProperty ;
    rdfs:label "from profile document"@en ;
    rdfs:domain personnel:ActOfPersonnelProfiling ;
    rdfs:range personnel:ProfileDocument ;
    rdfs:subPropertyOf cco:ont00001808 ;
    owl:inverseOf personnel:isProfileDocumentForProfiling ;
    skos:definition "Relates an act of personnel profiling to the profile document that was read as its source."@en .

personnel:hasContract a owl:ObjectProperty ;
    rdfs:label "has contract"@en ;
    rdfs:domain personnel:ActOfWorking ;
    rdfs:range personnel:EmploymentContract ;
    rdfs:subPropertyOf abi:concretizes ;
    owl:inverseOf personnel:isContractOf ;
    skos:definition "Relates an act of working to the employment contract it concretizes."@en .

personnel:hasDegree a owl:ObjectProperty ;
    rdfs:label "has degree"@en ;
    rdfs:domain personnel:ActOfStudying ;
    rdfs:range personnel:AcademicDegree ;
    rdfs:subPropertyOf abi:concretizes ;
    owl:inverseOf personnel:isDegreeOf ;
    skos:definition "Relates an act of studying to the academic degree it concretizes."@en .

personnel:hasEnrollment a owl:ObjectProperty ;
    rdfs:label "has enrollment"@en ;
    rdfs:domain personnel:ActOfStudying ;
    rdfs:range personnel:EnrollmentRecord ;
    rdfs:subPropertyOf abi:concretizes ;
    owl:inverseOf personnel:isEnrollmentOf ;
    skos:definition "Relates an act of studying to the enrollment record it concretizes."@en .

personnel:hasJobPosition a owl:ObjectProperty ;
    rdfs:label "has job position"@en ;
    rdfs:domain personnel:EmployeeRole ;
    rdfs:range personnel:JobPosition ;
    rdfs:subPropertyOf abi:concretizes ;
    owl:inverseOf personnel:isJobPositionOf ;
    skos:definition "Relates an employee role to the job position it concretizes. Named sub-property of abi:concretizes: a role (SDC) concretizes a position (GDC)."@en .

personnel:hasRecommendationAuthor a owl:ObjectProperty ;
    rdfs:label "has recommendation author"@en ;
    rdfs:domain personnel:Recommendation ;
    rdfs:range abi:Person ;
    owl:inverseOf personnel:isAuthorOfRecommendation ;
    skos:definition "Relates a recommendation to the person who wrote it. Distinct from the person it is about: a recommendation always has two people."@en .

personnel:isCertificationOf a owl:ObjectProperty ;
    rdfs:label "is certification of"@en ;
    rdfs:domain personnel:Certification ;
    rdfs:range abi:Person ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf personnel:hasCertification ;
    skos:definition "Relates a certification to the person on which it generically depends."@en .

personnel:isEmployeeRoleOf a owl:ObjectProperty ;
    rdfs:label "is employee role of"@en ;
    rdfs:domain personnel:EmployeeRole ;
    rdfs:range abi:Person ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf personnel:hasEmployeeRole ;
    skos:definition "Relates an employee role to the person in whom it inheres."@en .

personnel:isEmploymentRecordOf a owl:ObjectProperty ;
    rdfs:label "is employment record of"@en ;
    rdfs:domain personnel:EmploymentRecord ;
    rdfs:range abi:Person ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf personnel:hasEmploymentRecord ;
    skos:definition "Relates an employment record to the person on which it generically depends."@en .

personnel:isEmploymentStatusOf a owl:ObjectProperty ;
    rdfs:label "is employment status of"@en ;
    rdfs:domain personnel:EmploymentStatus ;
    rdfs:range abi:Person ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf personnel:hasEmploymentStatus ;
    skos:definition "Relates an employment status quality to the person in whom it inheres."@en .

personnel:isEnrollmentRecordOf a owl:ObjectProperty ;
    rdfs:label "is enrollment record of"@en ;
    rdfs:domain personnel:EnrollmentRecord ;
    rdfs:range abi:Person ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf personnel:hasEnrollmentRecord ;
    skos:definition "Relates an enrollment record to the person on which it generically depends."@en .

personnel:isGradeOf a owl:ObjectProperty ;
    rdfs:label "is grade of"@en ;
    rdfs:domain personnel:Grade ;
    rdfs:range abi:Person ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf personnel:hasGrade ;
    skos:definition "Relates a grade quality to the person in whom it inheres."@en .

personnel:isInterestOf a owl:ObjectProperty ;
    rdfs:label "is interest of"@en ;
    rdfs:domain personnel:Interest ;
    rdfs:range abi:Person ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf personnel:hasInterest ;
    skos:definition "Relates an interest to the person in whom it inheres."@en .

personnel:isLanguageCapabilityOf a owl:ObjectProperty ;
    rdfs:label "is language capability of"@en ;
    rdfs:domain personnel:LanguageCapability ;
    rdfs:range abi:Person ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf personnel:hasLanguageCapability ;
    skos:definition "Relates a language capability to the person in whom it inheres."@en .

personnel:isPortraitOf a owl:ObjectProperty ;
    rdfs:label "is portrait of"@en ;
    rdfs:domain personnel:Portrait ;
    rdfs:range abi:Person ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf personnel:hasPortrait ;
    skos:definition "Relates a portrait image to the person it depicts."@en .

personnel:isProfileSummaryOf a owl:ObjectProperty ;
    rdfs:label "is profile summary of"@en ;
    rdfs:domain personnel:ProfileSummary ;
    rdfs:range abi:Person ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf personnel:hasProfileSummary ;
    skos:definition "Relates a profile summary to the person it is about."@en .

personnel:isRecommendationOf a owl:ObjectProperty ;
    rdfs:label "is recommendation of"@en ;
    rdfs:domain personnel:Recommendation ;
    rdfs:range abi:Person ;
    rdfs:subPropertyOf abi:genericallyDependsOn ;
    owl:inverseOf personnel:hasRecommendation ;
    skos:definition "Relates a recommendation to the person it is about."@en .

personnel:isServiceLineOf a owl:ObjectProperty ;
    rdfs:label "is service line of"@en ;
    rdfs:domain personnel:ServiceLine ;
    rdfs:range abi:Organization ;
    owl:inverseOf personnel:hasServiceLine ;
    skos:definition "Relates a service line to the organization it is a member part of."@en .

personnel:isSkillDevelopedIn a owl:ObjectProperty ;
    rdfs:label "is skill developed in"@en ;
    rdfs:domain personnel:Skill ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( personnel:ActOfWorking personnel:ActOfStudying ) ] ;
    owl:inverseOf personnel:developsSkill ;
    skos:definition "Relates a skill to an act of working or studying in which it is exercised and developed."@en .

personnel:isStudentRoleOf a owl:ObjectProperty ;
    rdfs:label "is student role of"@en ;
    rdfs:domain personnel:StudentRole ;
    rdfs:range abi:Person ;
    rdfs:subPropertyOf abi:inheresIn ;
    owl:inverseOf personnel:hasStudentRole ;
    skos:definition "Relates a student role to the person in whom it inheres."@en .

personnel:ofLanguage a owl:ObjectProperty ;
    rdfs:label "of language"@en ;
    rdfs:domain personnel:LanguageCapability ;
    rdfs:range cco:ont00001175 ;
    owl:inverseOf personnel:isLanguageOfCapability ;
    skos:definition "Relates a language capability to the language it is held for. The language is a CCO Language: a directive information content entity prescribing a canonical format for communication, shared by every speaker of it."@en .

