@prefix abi: <http://ontology.naas.ai/abi/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix people: <http://ontology.naas.ai/people/> .
@prefix personnel: <http://ontology.naas.ai/personnel/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

abi:ActOfCertificationProcess a owl:Ontology ;
    abi:ontologyResource "ontologies/processes/ActOfCertificationProcess.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.intelligence.modules.people" ;
    abi:pythonResource "ontologies/processes/ActOfCertificationProcess.py" ;
    dc:contributor "FlorentRvl" ;
    dc:date "2026-09-21"^^xsd:date ;
    dcterms:description "Process slice for the act of certification - a CCO Planned Act in which a certifying organization attests that a person has demonstrated a competence, met a professional standard or may practise, realizing a certification candidate role, demonstrating skills, and concretizing the certification it awards."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Act of Certification Process Ontology"@en ;
    rdfs:comment "Process slice for Act of Certification. Reuses Certification, Skill and ProfileDocument from PeopleOntology. The Certification stays the credential a person carries; this slice adds the act that produced it."@en ;
    rdfs:member "bpl-processes/personnel" ;
    rdfs:seeAlso abi:PeopleOntology ;
    owl:imports abi:Ontology,
        cco:AgentOntology,
        cco:EventOntology,
        cco:FacilityOntology,
        cco:InformationEntityOntology .

abi:ActOfProfilingProcess a owl:Ontology ;
    abi:ontologyResource "ontologies/processes/ActOfProfilingProcess.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.intelligence.modules.people" ;
    abi:pythonResource "ontologies/processes/ActOfProfilingProcess.py" ;
    dc:contributor "Alice Dupont" ;
    dc:date "2026-09-18"^^xsd:date ;
    dcterms:description "Process slice for profiling: a planned act in which statements from a published profile document are registered as acts of working, acts of studying and person-level directory facts without duplicating episode data in a second store."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Act of Profiling Process Ontology"@en ;
    rdfs:comment "Runtime: register_profile_from_source. NCOR ledger entry personnel-profiling.ttl (upstream)."@en ;
    rdfs:member "bpl-processes/personnel" ;
    rdfs:seeAlso abi:PeopleOntology ;
    owl:imports abi:Ontology,
        cco:AgentOntology,
        cco:EventOntology,
        cco:InformationEntityOntology .

abi:ActOfStudyingProcess a owl:Ontology ;
    abi:ontologyResource "ontologies/processes/ActOfStudyingProcess.ttl" ;
    abi:pythonPackage "naas_abi_marketplace.domains.intelligence.modules.people" ;
    abi:pythonResource "ontologies/processes/ActOfStudyingProcess.py" ;
    dc:contributor "Alice Dupont",
        "Emma Petit",
        "Grace Lambert" ;
    dc:date "2026-08-19"^^xsd:date ;
    dcterms:description "Process slice for the act of studying - a CCO Planned Act (Act of Educational Training Acquisition) in which a person acquires knowledge of a curriculum from an educational organization in an educational facility over a temporal region, realizing a student role, developing skills and language capabilities, and concretizing an enrollment record and academic degree."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Act of Studying Process Ontology"@en ;
    rdfs:comment "Process slice for Act of Studying. Reuses shared people classes, Skill and ProfileDocument from PeopleOntology."@en ;
    rdfs:member "bpl-processes/personnel" ;
    rdfs:seeAlso abi:PeopleOntology ;
    owl:imports abi:Ontology,
        cco:AgentOntology,
        cco:EventOntology,
        cco:FacilityOntology,
        cco:InformationEntityOntology .

abi:activities_content a owl:DatatypeProperty ;
    rdfs:label "activities content"@en ;
    rdfs:domain abi:EnrollmentRecord ;
    rdfs:range xsd:string ;
    skos:definition "Extracurricular activities and societies listed under an enrollment on the source profile."@en .

abi:certification_name a owl:DatatypeProperty ;
    rdfs:label "certification name"@en ;
    rdfs:domain abi:Certification ;
    rdfs:range xsd:string ;
    skos:definition "Name of the certification as published by the issuing organization."@en ;
    skos:example "'Certified Information Systems Auditor'."@en .

abi:certification_status a owl:DatatypeProperty ;
    rdfs:label "certification status"@en ;
    rdfs:domain abi:Certification ;
    rdfs:range xsd:string ;
    skos:definition "State of a certification at a point in time, e.g. 'active', 'expired', 'in-progress'."@en .

abi:city_name a owl:DatatypeProperty ;
    rdfs:label "city name"@en ;
    rdfs:domain abi:Site ;
    rdfs:range xsd:string ;
    skos:definition "Name of the city a site is in."@en .

abi:completion_date a owl:DatatypeProperty ;
    rdfs:label "completion date"@en ;
    rdfs:domain abi:EnrollmentRecord ;
    rdfs:range xsd:date ;
    skos:definition "Date on which the course of study documented by this record ended. Absent while the person is still enrolled."@en .

abi:site_country_code a owl:DatatypeProperty ;
    rdfs:label "country code"@en ;
    rdfs:domain abi:Site ;
    rdfs:range xsd:string ;
    skos:definition "ISO 3166-1 alpha-2 code of the country a site is in, carried so places can be grouped and flagged without matching country names across languages."@en ;
    skos:example "'FR'; 'SG'; 'ZA'."@en .

abi:country_name a owl:DatatypeProperty ;
    rdfs:label "country name"@en ;
    rdfs:domain abi:Site ;
    rdfs:range xsd:string ;
    skos:definition "Name of the country a site is in."@en .

abi:credential_id a owl:DatatypeProperty ;
    rdfs:label "credential id"@en ;
    rdfs:domain abi:Certification ;
    rdfs:range xsd:string ;
    skos:definition "Identifier the issuing organization assigned to this certification, by which it can be verified."@en .

abi:credential_url a owl:DatatypeProperty ;
    rdfs:label "credential url"@en ;
    rdfs:domain abi:Certification ;
    rdfs:range xsd:anyURI ;
    skos:definition "Address at which the issuing organization publishes verification of this certification."@en .

abi:duration_label a owl:DatatypeProperty ;
    rdfs:label "duration label"@en ;
    rdfs:domain abi:TemporalRegion ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable span of a temporal region as stated on the source profile, e.g. '3 yrs 5 mos'."@en .

abi:email_address a owl:DatatypeProperty ;
    rdfs:label "email address"@en ;
    rdfs:domain abi:Person ;
    rdfs:range xsd:string ;
    skos:definition "Address at which the person can be reached by email, as published for them by the directory that lists them."@en ;
    skos:example "'alice.dupont@demo.example'."@en .

abi:employment_type a owl:DatatypeProperty ;
    rdfs:label "employment type"@en ;
    rdfs:domain abi:ActOfWorking ;
    rdfs:range xsd:string ;
    skos:definition "Engagement type a source states for an act of working, e.g. 'Full-time', 'Freelance', 'Self-employed', 'Internship'. What was published, not the terms of a contract: a contract is an internal record of the employing organization, outside this vocabulary."@en .

abi:enrollment_date a owl:DatatypeProperty ;
    rdfs:label "enrollment date"@en ;
    rdfs:domain abi:EnrollmentRecord ;
    rdfs:range xsd:date ;
    skos:definition "Date on which the course of study documented by this record began."@en .

abi:expiry_date a owl:DatatypeProperty ;
    rdfs:label "expiry date"@en ;
    rdfs:domain abi:Certification ;
    rdfs:range xsd:date ;
    skos:definition "Date on which the certification ceases to be valid. Absent when the certification does not expire."@en .

abi:family_name a owl:DatatypeProperty ;
    rdfs:label "family name"@en ;
    rdfs:domain abi:Person ;
    rdfs:range xsd:string ;
    skos:altLabel "surname"@en ;
    skos:definition "The name a person shares with or inherits from kin, as distinct from the given name conferred on them individually."@en ;
    skos:example "'Ravenel'."@en .

abi:given_name a owl:DatatypeProperty ;
    rdfs:label "given name"@en ;
    rdfs:domain abi:Person ;
    rdfs:range xsd:string ;
    skos:altLabel "forename"@en ;
    skos:definition "The name conferred on a person individually, typically at or near birth, as distinct from the family name they share with kin."@en ;
    skos:example "'Jeremy'."@en .

abi:headline_text a owl:DatatypeProperty ;
    rdfs:label "headline text"@en ;
    rdfs:domain abi:ProfileSummary ;
    rdfs:range xsd:string ;
    skos:definition "One-line statement of what a person does, as they present it. Distinct from abi:job_title, which is the title of one occupation role."@en ;
    skos:example "'Partner, Audit - Consumer goods and food & beverage'."@en .

abi:instant_date a owl:DatatypeProperty ;
    rdfs:label "instant date"@en ;
    rdfs:domain abi:TemporalInstant ;
    rdfs:range xsd:date ;
    skos:definition "Calendar date a temporal instant denotes, carried so processes can be ordered and capped by recency without parsing display labels."@en .

abi:interest_description a owl:DatatypeProperty ;
    rdfs:label "interest description"@en ;
    rdfs:domain abi:Interest ;
    rdfs:range xsd:string ;
    skos:definition "Sentence stating what the interest consists in."@en .

abi:interest_kind a owl:DatatypeProperty ;
    rdfs:label "interest kind"@en ;
    rdfs:domain abi:Interest ;
    rdfs:range xsd:string ;
    skos:definition "Category of the interest target, used to group interests for display, e.g. 'organization', 'school', 'person', 'topic'."@en .

abi:interest_name a owl:DatatypeProperty ;
    rdfs:label "interest name"@en ;
    rdfs:domain abi:Interest ;
    rdfs:range xsd:string ;
    skos:definition "Name of what the interest is in, carried on the interest itself so an interest with no individual to point at is still stated."@en ;
    skos:example "'Ocean conservation'."@en .

abi:issue_date a owl:DatatypeProperty ;
    rdfs:label "issue date"@en ;
    rdfs:domain abi:Certification ;
    rdfs:range xsd:date ;
    skos:definition "Date on which the certification was issued."@en .

abi:job_title a owl:DatatypeProperty ;
    rdfs:label "job title"@en ;
    rdfs:domain abi:OccupationRole ;
    rdfs:range xsd:string ;
    skos:definition "Title of an occupation role as the source states it."@en ;
    skos:example "'Head of Product'; 'Senior Manager, Audit'."@en .

abi:language_name a owl:DatatypeProperty ;
    rdfs:label "language name"@en ;
    rdfs:domain abi:LanguageCapability ;
    rdfs:range xsd:string ;
    skos:definition "Name of the language a capability is held for, as displayed."@en ;
    skos:example "'French'; 'Mandarin'."@en .

abi:linkedin_url a owl:DatatypeProperty ;
    rdfs:label "linkedin url"@en ;
    rdfs:domain abi:Person ;
    rdfs:range xsd:anyURI ;
    skos:definition "Address of the person's own LinkedIn profile page. Distinct from the source a profile was read from, which may be any published page."@en ;
    skos:example "'https://www.linkedin.com/in/alice-dupont-demo'."@en .

abi:mission_content a owl:DatatypeProperty ;
    rdfs:label "mission content"@en ;
    rdfs:domain abi:Mission ;
    rdfs:range xsd:string ;
    skos:definition "Full stated text of a mission: the objectives and activities listed under its opening sentence, one per line when the source enumerates them as discrete tasks. The opening sentence alone is carried by rdfs:label; the situation the mission responded to is carried by abi:mission_context, not here."@en .

abi:mission_context a owl:DatatypeProperty ;
    rdfs:label "mission context"@en ;
    rdfs:domain abi:Mission ;
    rdfs:range xsd:string ;
    skos:definition "The situation a mission was undertaken in: what the organization needed and why, stated as prose before the mission's own objectives and activities. Optional: a source that states only what was done, not the situation it responded to, leaves this unset."@en .

abi:office_label a owl:DatatypeProperty ;
    rdfs:label "office label"@en ;
    rdfs:domain abi:Site ;
    rdfs:range xsd:string ;
    skos:definition "Name by which an organization refers to a site, as it appears in its own directory."@en ;
    skos:example "'Paris La Défense'."@en .

abi:portrait_path a owl:DatatypeProperty ;
    rdfs:label "portrait path"@en ;
    rdfs:domain abi:Portrait ;
    rdfs:range xsd:string ;
    skos:definition "Repository-relative or object-storage path of the portrait image, for portraits that are not published at a public address."@en .

abi:portrait_url a owl:DatatypeProperty ;
    rdfs:label "portrait url"@en ;
    rdfs:domain abi:Portrait ;
    rdfs:range xsd:anyURI ;
    skos:definition "Address at which the portrait image can be retrieved."@en .

abi:proficiency_level a owl:DatatypeProperty ;
    rdfs:label "proficiency level"@en ;
    rdfs:domain abi:LanguageCapability ;
    rdfs:range xsd:string ;
    skos:definition "Reported level of a language capability. Free text rather than a code list: sources state it in incompatible scales (CEFR, 'native', 'professional working proficiency') and converting between them would assert more than the source does."@en ;
    skos:example "'Native or bilingual'; 'C1'."@en .

abi:profile_slug a owl:DatatypeProperty ;
    rdfs:label "profile slug"@en ;
    rdfs:domain abi:Person ;
    rdfs:range xsd:string ;
    skos:definition "Stable, lowercase, ASCII key identifying a person in profile URLs and dataset rows. Assigned by the system that publishes the profile, not by the person."@en ;
    skos:example "'alice_dupont'."@en .

abi:program_name a owl:DatatypeProperty ;
    rdfs:label "program name"@en ;
    rdfs:domain abi:EnrollmentRecord ;
    rdfs:range xsd:string ;
    skos:definition "Name of the curriculum or programme the enrollment is for."@en .

abi:quote_content a owl:DatatypeProperty ;
    rdfs:label "quote content"@en ;
    rdfs:domain abi:ProfileSummary ;
    rdfs:range xsd:string ;
    skos:definition "Sentence attributed to the person in their own words, published alongside the summary."@en .

abi:recommendation_content a owl:DatatypeProperty ;
    rdfs:label "recommendation content"@en ;
    rdfs:domain abi:Recommendation ;
    rdfs:range xsd:string ;
    skos:definition "Full text of the recommendation, as written by its author."@en .

abi:recommendation_date a owl:DatatypeProperty ;
    rdfs:label "recommendation date"@en ;
    rdfs:domain abi:Recommendation ;
    rdfs:range xsd:date ;
    skos:definition "Date on which the recommendation was written."@en .

abi:relationship_label a owl:DatatypeProperty ;
    rdfs:label "relationship label"@en ;
    rdfs:domain abi:Recommendation ;
    rdfs:range xsd:string ;
    skos:definition "How the author of a recommendation describes their working relationship with the person it is about."@en ;
    skos:example "'Managed Alice directly'; 'Worked with Alice on the same team'."@en .

abi:skill_name a owl:DatatypeProperty ;
    rdfs:label "skill name"@en ;
    rdfs:domain abi:Skill ;
    rdfs:range xsd:string ;
    skos:definition "Name of a skill as stated on the source profile."@en .

abi:source_url a owl:DatatypeProperty ;
    rdfs:label "source url"@en ;
    rdfs:domain abi:ProfileDocument ;
    rdfs:range xsd:anyURI ;
    skos:definition "Address at which a profile document can be retrieved."@en .

abi:summary_content a owl:DatatypeProperty ;
    rdfs:label "summary content"@en ;
    rdfs:domain abi:ProfileSummary ;
    rdfs:range xsd:string ;
    skos:definition "Full text of the profile summary: the paragraph a person or their organization publishes about them."@en .

abi:telephone_number a owl:DatatypeProperty ;
    rdfs:label "telephone number"@en ;
    rdfs:domain abi:Person ;
    rdfs:range xsd:string ;
    skos:definition "Number at which the person can be reached by telephone, written in international form with its country code."@en ;
    skos:example "'+33 1 99 00 00 01'."@en .

abi:years_of_experience a owl:DatatypeProperty ;
    rdfs:label "years of experience"@en ;
    rdfs:domain abi:ProfileSummary ;
    rdfs:range xsd:integer ;
    skos:definition "Number of years of professional experience the profile summary claims. A claim carried by the summary and traceable to its source, not a figure computed from the acts of working in this graph: the graph holds only the working history that has been recorded."@en .

abi:contract_type a owl:DatatypeProperty ;
    rdfs:label "contract type"@en ;
    rdfs:domain abi:EmploymentContract ;
    rdfs:range xsd:string ;
    skos:definition "Engagement type of an employment contract as the employer records it, e.g. 'Permanent', 'Fixed-term', 'Freelance'. The published counterpart is abi:employment_type, stated on the act of working."@en .

abi:employee_id a owl:DatatypeProperty ;
    rdfs:label "employee id"@en ;
    rdfs:domain abi:EmploymentRecord ;
    rdfs:range xsd:string ;
    skos:definition "Identifier assigned to a person by the employing organization's HR system."@en .

abi:grade_value a owl:DatatypeProperty ;
    rdfs:label "grade value"@en ;
    rdfs:domain abi:Grade ;
    rdfs:range xsd:string ;
    skos:definition "Value of a grade, i.e. the seniority level the employing organization recognises for the person."@en ;
    skos:example "'Partner'; 'Senior Manager'; 'Associate'."@en .

abi:hire_date a owl:DatatypeProperty ;
    rdfs:label "hire date"@en ;
    rdfs:domain abi:EmploymentRecord ;
    rdfs:range xsd:date ;
    skos:definition "Date on which the employment relationship documented by this record began."@en .

abi:job_family a owl:DatatypeProperty ;
    rdfs:label "job family"@en ;
    rdfs:domain abi:JobPosition ;
    rdfs:range xsd:string ;
    skos:definition "Grouping of related job positions sharing a common discipline or career track."@en .

abi:job_position_title a owl:DatatypeProperty ;
    rdfs:label "job title"@en ;
    rdfs:domain abi:JobPosition ;
    rdfs:range xsd:string ;
    skos:definition "Title of the job position as published by the organization."@en .

abi:remuneration_amount a owl:DatatypeProperty ;
    rdfs:label "remuneration amount"@en ;
    rdfs:domain abi:Remuneration ;
    rdfs:range xsd:decimal ;
    skos:definition "Annual remuneration amount in the contract currency."@en .

abi:remuneration_currency a owl:DatatypeProperty ;
    rdfs:label "remuneration currency"@en ;
    rdfs:domain abi:Remuneration ;
    rdfs:range xsd:string .

abi:status_value a owl:DatatypeProperty ;
    rdfs:label "status value"@en ;
    rdfs:domain abi:EmploymentStatus ;
    rdfs:range xsd:string ;
    skos:definition "Value of an employment status, e.g. 'active', 'on-leave', 'notice-period', 'terminated'."@en .

abi:termination_date a owl:DatatypeProperty ;
    rdfs:label "termination date"@en ;
    rdfs:domain abi:EmploymentRecord ;
    rdfs:range xsd:date ;
    skos:definition "Date on which the employment relationship documented by this record ended. Absent while the relationship is active."@en .

