        owl:NamedIndividual ;
    rdfs:label "LinkedIn experience - Bob Martin" ;
    abi:isProfileDocumentOf <http://ontology.naas.ai/abi/Person/bob-martin> ;
    abi:source_url "https://demo.example/profiles/bob_martin" ;
    dcterms:created "2026-10-02T15:09:23.494904"^^xsd:dateTime ;
    dcterms:creator "DemoPersonnelGraphWorkflow" .

<http://ontology.naas.ai/people/ProfileDocument/frank-moreau-linkedin> a abi:ProfileDocument,
        owl:NamedIndividual ;
    rdfs:label "LinkedIn experience - Frank Moreau" ;
    abi:isProfileDocumentOf <http://ontology.naas.ai/abi/Person/frank-moreau> ;
    abi:source_url "https://demo.example/profiles/frank_moreau" ;
    dcterms:created "2026-10-02T15:09:23.610279"^^xsd:dateTime ;
