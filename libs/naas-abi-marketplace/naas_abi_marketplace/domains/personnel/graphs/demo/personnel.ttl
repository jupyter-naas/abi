abi:Certification a owl:Class ;
    rdfs:label "Certification"@en ;
    rdfs:comment "Covers both certifications and licences: the difference is who may withhold it and what it permits, not what kind of entity it is. Where that distinction matters, state it with abi:certification_status and the issuing organization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom abi:ActOfCertification ],
        [ a owl:Restriction ;
            owl:onProperty abi:isSourcedFrom ;
            owl:someValuesFrom abi:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom abi:ActOfCertification ],
        [ a owl:Restriction ;
            owl:onProperty abi:isSourcedFrom ;
            owl:someValuesFrom abi:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:isCertificationOf ;
            owl:someValuesFrom abi:Person ],
        abi:GenericallyDependentContinuant,
        cco:ont00002002 ;
    skos:definition "A certificate issued to a person by an organization to attest that they have demonstrated a competence, met a professional standard, or hold a licence to practise. Subclass of CCO Certificate, sibling of abi:AcademicDegree."@en ;
    skos:example "Certified Information Systems Auditor, issued by ISACA in 2019; Commissaire aux comptes."@en .

abi:LanguageCapability a owl:Class ;
    rdfs:label "Language Capability"@en ;
    rdfs:comment "Deliberately NOT equivalent to CCO Language Skill (cco:ont00000181). That class is an Agent Capability and therefore a BFO realizable entity, which is disjoint from quality; this domain already models abi:Skill as a quality, and asserting both would make the ontology inconsistent. The language itself is a CCO Language, reached through abi:ofLanguage. Like a skill, it is borne by the person and outlives any one act: abi:developsLanguageCapability links a planned act, of whatever kind, to the capabilities exercised and grown in it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isLanguageCapabilityOf ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:isLanguageCapabilityDevelopedIn ;
            owl:someValuesFrom cco:ont00000228 ],
        [ a owl:Restriction ;
            owl:onProperty abi:ofLanguage ;
            owl:someValuesFrom cco:ont00001175 ],
        abi:Quality ;
    skos:definition "A quality that inheres in a person and holds how well they can communicate in one language, developed and exercised in the acts the person carries out: working, studying, being certified."@en ;
    skos:example "Spanish at native or bilingual proficiency."@en .

<http://ontology.naas.ai/abi/Organization/demo> a abi:Organization,
        owl:NamedIndividual ;
    rdfs:label "Demo" ;
    abi:hasServiceLine <http://ontology.naas.ai/personnel/ServiceLine/demo-growth>,
        <http://ontology.naas.ai/personnel/ServiceLine/demo-operations>,
        <http://ontology.naas.ai/personnel/ServiceLine/demo-strategy>,
        <http://ontology.naas.ai/personnel/ServiceLine/demo-technology> ;
    dcterms:created "2026-10-02T15:09:23.476492"^^xsd:dateTime,
        "2026-10-02T15:09:23.673940"^^xsd:dateTime ;
    dcterms:creator "DemoPersonnelGraphWorkflow" .

abi:Mission a owl:Class ;
    rdfs:label "Mission"@en ;
    rdfs:comment "Deliberately a GDC and NOT a BFO function. A mission is stated, copied between systems and survives the person leaving the post, which a disposition inhering in the person could not. The WHY that inheres in the person is abi:OccupationRole; the mission is what that role concretizes. rdfs:label carries the opening sentence; abi:mission_content carries the full text."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom abi:OccupationRole ],
        [ a owl:Restriction ;
            owl:onProperty abi:isSourcedFrom ;
            owl:someValuesFrom abi:ProfileDocument ],
        [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:genericallyDependsOn ;
            owl:someValuesFrom abi:Person ],
        [ a owl:Restriction ;
            owl:onProperty abi:isConcretizedBy ;
            owl:someValuesFrom abi:OccupationRole ],
        [ a owl:Restriction ;
            owl:onProperty abi:isSourcedFrom ;
            owl:someValuesFrom abi:ProfileDocument ],
        abi:GenericallyDependentContinuant ;
    skos:definition "An information content entity that states what a person is charged with achieving in a working engagement: the remit, its objectives and its main activities. Generically dependent on the person, and concretized by the occupation role through which the person carries it out."@en ;
    skos:example "'Leading the development of an open Universal Data & AI Platform to help organizations create powerful ecosystems of AI Agents.'"@en .

