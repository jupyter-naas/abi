<http://ontology.naas.ai/people/ProfileDocument/hugo-girard-linkedin> a abi:ProfileDocument,
        owl:NamedIndividual ;
    rdfs:label "LinkedIn experience - Hugo Girard" ;
    abi:isProfileDocumentOf <http://ontology.naas.ai/abi/Person/hugo-girard> ;
