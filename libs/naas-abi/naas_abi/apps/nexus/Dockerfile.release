# Node 24 LTS, pinned by digest: bump the tag and the digest together.
FROM node:24.22.3-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web ./apps/web
COPY apps/api/public/logos ./apps/api/public/logos
COPY docker-entrypoint.sh ./docker-entrypoint.sh

WORKDIR /app/apps/web

# Deployments bake public client config into the Next bundle.
# NEXT_PUBLIC_* is inlined at build time; empty defaults keep upstream generic.
# Baking API URL / env avoids a client race where async chunks call getApiUrl()
# before /runtime-config.js runs and fall back to localhost:9879.
ARG NEXT_PUBLIC_MAPS_CUSTOM_DATASETS=
ARG NEXT_PUBLIC_API_URL=
ARG NEXT_PUBLIC_NEXUS_ENV=
ARG NEXT_PUBLIC_FRONTEND_URL=
ARG NEXT_PUBLIC_WS_PATH=/ws/socket.io
ENV NEXT_PUBLIC_MAPS_CUSTOM_DATASETS=$NEXT_PUBLIC_MAPS_CUSTOM_DATASETS
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_NEXUS_ENV=$NEXT_PUBLIC_NEXUS_ENV
ENV NEXT_PUBLIC_FRONTEND_URL=$NEXT_PUBLIC_FRONTEND_URL
ENV NEXT_PUBLIC_WS_PATH=$NEXT_PUBLIC_WS_PATH

RUN pnpm install --frozen-lockfile
RUN pnpm build
RUN chmod +x /app/docker-entrypoint.sh
# The server runs as `node`. It writes only the runtime config (the entrypoint)
# and Next's cache; the rest of the image stays root's.
RUN touch public/runtime-config.js \
    && mkdir -p .next/cache \
    && chown node:node public/runtime-config.js .next/cache
USER node

ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

ENTRYPOINT ["/app/docker-entrypoint.sh"]
# `next start` itself (the `start` script): pnpm is set up for root at build
# time, and the server needs nothing fetched at start.
CMD ["node_modules/.bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
