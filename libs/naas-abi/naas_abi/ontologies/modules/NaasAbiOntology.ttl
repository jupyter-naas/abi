abi:systemViewKind a owl:AnnotationProperty ;
    rdfs:label "system view kind"@en ;
    rdfs:comment "Marks a class as a system or subsystem in the process navigation view; not a BFO type."@en ;
    skos:definition "Marks a class as a system or subsystem in the process navigation view; not a BFO type."@en .

abi:systemViewParent a owl:AnnotationProperty ;
    rdfs:label "system view parent"@en ;
    rdfs:comment "Names the containing system for a subsystem navigation grouping; not an assertion about physical parthood."@en ;
    skos:definition "Names the containing system for a subsystem navigation grouping; not an assertion about physical parthood."@en .

abi:AINAgentsHost a owl:Class ;
    rdfs:label "AIN agents physical host"@en ;
    abi:modelingNote "Physical host inferred from software use; confirm deployment with ABI."@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "Physical computing equipment carrying 'AIN agents'. Proposed bearer mapping; no particular machine or deployment is asserted."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000101 ;
            owl:someValuesFrom abi:AINAgentsSoftware ],
        abi:ComputingSystem ;
    skos:definition "Physical computing equipment carrying 'AIN agents'. Proposed bearer mapping; no particular machine or deployment is asserted."@en .

