@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix dc11: <http://purl.org/dc/elements/1.1/> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix abi: <http://ontology.naas.ai/abi/> .

abi:GeospatialRegionOntology a owl:Ontology ;
  owl:imports <http://ontology.naas.ai/abi/Ontology> ;
  owl:imports <https://www.commoncoreontologies.org/GeospatialOntology> ;
  dc:title "Geospatial Region Ontology"@en ;
  dc:description "Geospatial regions from the street to the continent, nested by continuant part of."@en ;
  dc:license <https://creativecommons.org/licenses/by/4.0/> ;
  rdfs:comment "Where processes occur: a geospatial region and the regions that contain it (city, administrative regions, country, continent). Aligned with the Common Core Ontologies Geospatial Ontology."@en ;
  rdfs:seeAlso <https://raw.githubusercontent.com/jupyter-naas/abi/refs/heads/main/libs/naas-abi/naas_abi/ontologies/modules/GeospatialRegionOntology.ttl> ;
  abi:pythonPackage "naas_abi" ;
  abi:ontologyResource "ontologies/modules/GeospatialRegionOntology.ttl" ;
  abi:pythonResource "ontologies/modules/GeospatialRegionOntology.py" ;
  dc11:contributor "Florent Ravenel" ;
  dc11:date "2026-10-05"^^xsd:date .

#################################################################
# Object Properties
#################################################################

abi:continuantPartOf a owl:ObjectProperty ;
    owl:equivalentProperty bfo:BFO_0000176 ;
    owl:inverseOf abi:hasContinuantPart ;
    rdfs:label "continuant part of"@en ;
    skos:definition "b continuant part of c =Def b and c are continuants & there is some time t such that b and c exist at t & b continuant part of c at t"@en ;
    skos:example "The site of 45 avenue Kléber is a continuant part of Paris; Paris is a continuant part of Île-de-France; Île-de-France is a continuant part of France"@en .

abi:hasContinuantPart a owl:ObjectProperty ;
    owl:equivalentProperty bfo:BFO_0000178 ;
    owl:inverseOf abi:continuantPartOf ;
    rdfs:label "has continuant part"@en ;
    skos:definition "b has continuant part c =Def c continuant part of b"@en ;
    skos:example "France has continuant part Île-de-France"@en .

#################################################################
# Classes
#################################################################

# Geospatial sites (WHERE, from the street to the continent)
# Sites nest with continuant part of: a process occurs in the most precise
# site, and the containing city, region and country are reached by climbing
# abi:continuantPartOf (BFO does not declare it transitive, so queries use
# abi:occursIn/abi:continuantPartOf*). Existential restrictions are stated
# only where they hold by definition, as in CCO; the universal ones say what
# may contain each site (and type continuant_part_of in the generated Python).
abi:GeospatialRegion a owl:Class ;
    owl:equivalentClass cco:ont00000472 ;
    rdfs:label "geospatial region"@en ;
    skos:definition "A Site that is at or near the surface of the Earth."@en ;
    skos:example "Paris; Île-de-France; France; Europe; the site of an office building"@en ;
    rdfs:subClassOf abi:Site .

abi:GeospatialLocation a owl:Class ;
    owl:equivalentClass cco:ont00000487 ;
    rdfs:label "geospatial location"@en ;
    skos:definition "A Geospatial Region that is at which an Entity or Event is located."@en ;
    skos:example "The site of 45 avenue Kléber, Paris, at which an office building is located and an act of working occurs"@en ;
    skos:scopeNote "Usually a continuant part of a local administrative region, but not by definition (a ship at sea, a research station in Antarctica), so no restriction requires it."@en ;
    rdfs:subClassOf abi:GeospatialRegion ,
        [ a owl:Restriction ;
          owl:onProperty abi:continuantPartOf ;
          owl:allValuesFrom [ a owl:Class ; owl:unionOf ( abi:Site abi:MaterialEntity ) ]
        ] .

abi:Continent a owl:Class ;
    owl:equivalentClass cco:ont00000251 ;
    rdfs:label "continent"@en ;
    skos:definition "A Geospatial Region that is bounded by any of the Earth's main continuous expanses of land."@en ;
    skos:example "Europe; Africa; North America"@en ;
    skos:scopeNote "A country is not required to be part of a continent: some span two (Russia, Türkiye)."@en ;
    rdfs:subClassOf abi:GeospatialRegion ,
        [ a owl:Restriction ;
          owl:onProperty abi:continuantPartOf ;
          owl:allValuesFrom abi:GeospatialRegion
        ] .

abi:Country a owl:Class ;
    owl:equivalentClass cco:ont00000139 ;
    rdfs:label "country"@en ;
    skos:altLabel "domain of a country"@en ;
    skos:definition "A Government Domain that is associated with certain distinct political, ethnic, or cultural characteristics, and which delimits a Government that has legitimate authority over a Populace."@en ;
    skos:example "France; the United Kingdom; Japan"@en ;
    skos:scopeNote "The site a country's government has authority over, which is where things occur. Its land and waters (a material entity) and its government (an agent) are different entities."@en ;
    rdfs:subClassOf abi:GeospatialRegion ,
        [ a owl:Restriction ;
          owl:onProperty abi:continuantPartOf ;
          owl:allValuesFrom abi:GeospatialRegion
        ] .

abi:FirstOrderAdministrativeRegion a owl:Class ;
    owl:equivalentClass cco:ont00000126 ;
    rdfs:label "first-order administrative region"@en ;
    skos:altLabel "state"@en , "province"@en , "region"@en ;
    skos:definition "A Government Domain that is a primary administrative division of a Country."@en ;
    skos:example "Île-de-France; California; Ontario; Bavaria"@en ;
    rdfs:subClassOf abi:GeospatialRegion ,
        [ a owl:Restriction ;
          owl:onProperty abi:continuantPartOf ;
          owl:someValuesFrom abi:Country
        ] ,
        [ a owl:Restriction ;
          owl:onProperty abi:continuantPartOf ;
          owl:allValuesFrom abi:GeospatialRegion
        ] .

abi:SecondOrderAdministrativeRegion a owl:Class ;
    owl:equivalentClass cco:ont00000405 ;
    rdfs:label "second-order administrative region"@en ;
    skos:altLabel "county"@en , "department"@en , "district"@en ;
    skos:definition "A Government Domain that is a subdivision of a First-Order Administrative Region."@en ;
    skos:example "Hauts-de-Seine; Los Angeles County; Upper Bavaria"@en ;
    rdfs:subClassOf abi:GeospatialRegion ,
        [ a owl:Restriction ;
          owl:onProperty abi:continuantPartOf ;
          owl:someValuesFrom abi:FirstOrderAdministrativeRegion
        ] ,
        [ a owl:Restriction ;
          owl:onProperty abi:continuantPartOf ;
          owl:allValuesFrom abi:GeospatialRegion
        ] .

abi:LocalAdministrativeRegion a owl:Class ;
    owl:equivalentClass cco:ont00000460 ;
    rdfs:label "local administrative region"@en ;
    skos:altLabel "municipality"@en ;
    skos:definition "A Government Domain that delimits a local Government."@en ;
    skos:example "Paris; Boulogne-Billancourt; a rural commune"@en ;
    skos:scopeNote "Required to be part of a country only: not every municipality sits in a first-order region (Washington, D.C.)."@en ;
    rdfs:subClassOf abi:GeospatialRegion ,
        [ a owl:Restriction ;
          owl:onProperty abi:continuantPartOf ;
          owl:someValuesFrom abi:Country
        ] ,
        [ a owl:Restriction ;
          owl:onProperty abi:continuantPartOf ;
          owl:allValuesFrom abi:GeospatialRegion
        ] .

abi:City a owl:Class ;
    owl:equivalentClass cco:ont00000887 ;
    rdfs:label "city"@en ;
    skos:definition "A Local Administrative Region in which a relatively large human population permanently resides; is designated as a city based on a particular administrative, legal, or historical status; and which delimits a local Government that typically oversees the provision of systems for sanitation, utilities, land usage, housing, and transportation."@en ;
    skos:example "Paris; London; New York City"@en ;
    rdfs:subClassOf abi:LocalAdministrativeRegion .

abi:Town a owl:Class ;
    owl:equivalentClass cco:ont00000071 ;
    rdfs:label "town"@en ;
    skos:definition "A Local Administrative Region in which a human population permanently resides that is typically larger than the population of a Village but smaller than that of a City; is designated as a town based on a particular administrative, legal, or historical status; and which delimits a local Government that typically exercises less power than that of a City Government."@en ;
    skos:example "Fontainebleau; Windsor"@en ;
    rdfs:subClassOf abi:LocalAdministrativeRegion .

abi:Village a owl:Class ;
    owl:equivalentClass cco:ont00000718 ;
    rdfs:label "village"@en ;
    skos:definition "A Local Administrative Region in which a human population permanently resides that is typically larger than the population of a hamlet but smaller than that of a Town."@en ;
    skos:example "Giverny"@en ;
    rdfs:subClassOf abi:LocalAdministrativeRegion .

#################################################################
# Data Properties
#################################################################

abi:country_code a owl:DatatypeProperty ;
    rdfs:domain abi:Country ;
    rdfs:range xsd:string ;
    rdfs:label "country code"@en ;
    skos:definition "x country code y =Def x is a country & y is the ISO 3166-1 alpha-2 code of x"@en ;
    skos:example "US; FR; JP"@en .
