@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix abi: <http://ontology.naas.ai/abi/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

abi:S5P1Ontology a owl:Ontology ;
    rdfs:label "S5-P1 · Programme planning"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceSHA256 "0d2c2c1e42dc3dfcfb1a8661ddba31057e88de911af1bb8f21868ba3096c0763"@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    dct:title "S5-P1 · Programme planning"@en ;
    rdfs:comment "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    owl:imports abi:ABIProcessLedgerOntology .

abi:S5P1Condition1 a owl:Class ;
    rdfs:label "Programme planning timing condition"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceValue "Per programme cycle"@en ;
    rdfs:comment "Ledger trigger/cadence/target: Per programme cycle. No occurrence or achieved timing is asserted."@en ;
    rdfs:subClassOf abi:ExecutionCondition ;
    skos:definition "Ledger trigger/cadence/target: Per programme cycle. No occurrence or achieved timing is asserted."@en .

abi:S5P1ExecutionRole a owl:Class ;
    rdfs:label "Programme planning execution role"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "A proposed role realised in Programme planning and borne by a listed material participant. The accountable bearer must be confirmed with ABI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( abi:PlanningSystemHost abi:ProgrammeOwnerParticipant abi:S5PlannerParticipant ) ] ],
        abi:ExecutionRole ;
    skos:definition "A proposed role realised in Programme planning and borne by a listed material participant. The accountable bearer must be confirmed with ABI."@en .

abi:S5P1Interval a owl:Class ;
    rdfs:label "Programme planning execution interval"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "The temporal region occupied by an execution of Programme planning; actual dates are unspecified."@en ;
    rdfs:subClassOf abi:ExecutionInterval ;
    skos:definition "The temporal region occupied by an execution of Programme planning; actual dates are unspecified."@en .

abi:S5P1Objective1 a owl:Class ;
    rdfs:label "Programme planning objective"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceValue "Objectives translated into deliverable work"@en ;
    rdfs:comment "Intended outcome: Objectives translated into deliverable work. This is an objective specification, not a role or a guaranteed result."@en ;
    rdfs:subClassOf abi:ObjectiveSpecification ;
    skos:definition "Intended outcome: Objectives translated into deliverable work. This is an objective specification, not a role or a guaranteed result."@en .

abi:S5P1Specification a owl:Class ;
    rdfs:label "Programme planning specification"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "The simulated ledger specification for S5-P1. It describes a possible process, not an executed run."@en ;
    rdfs:subClassOf abi:ProcessSpecification ;
    skos:definition "The simulated ledger specification for S5-P1. It describes a possible process, not an executed run."@en .

abi:S5P1Step1 a owl:Class ;
    rdfs:label "Programme planning · Define objectives"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 1 ;
    rdfs:comment "Suggested step 1 of Programme planning: Define objectives. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S5P1 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 1 of Programme planning: Define objectives. Its ordering is a specification, not observed timing."@en .

abi:S5P1Step2 a owl:Class ;
    rdfs:label "Programme planning · Sequence"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 2 ;
    rdfs:comment "Suggested step 2 of Programme planning: Sequence. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S5P1 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 2 of Programme planning: Sequence. Its ordering is a specification, not observed timing."@en .

abi:S5P1Step3 a owl:Class ;
    rdfs:label "Programme planning · Baseline"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 3 ;
    rdfs:comment "Suggested step 3 of Programme planning: Baseline. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S5P1 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 3 of Programme planning: Baseline. Its ordering is a specification, not observed timing."@en .

abi:S5P1 a owl:Class ;
    rdfs:label "Programme planning"@en ;
    abi:ledgerCode "S5-P1"@en ;
    abi:ledgerHOWITIS "Plan maturity"@en ;
    abi:ledgerHOWWEKNOW "Decision log"@en,
        "Programme plan"@en ;
    abi:ledgerWHEN "Per programme cycle"@en ;
    abi:ledgerWHERE "Operations centre"@en ;
    abi:ledgerWHO "Planning system"@en,
        "Programme owner"@en,
        "S5 planner"@en ;
    abi:ledgerWHY "Objectives translated into deliverable work"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:qualityMappingStatus "Unresolved — source indicators retained as information; no quality bearer supplied"@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "A proposed ABI programme planning process. Suggested steps: Define objectives → Sequence → Baseline. Draft — simulated ledger hypothesis; not validated with ABI. HOW IT IS values are retained as indicator records; quality bearers remain unresolved."@en,
        "Unresolved — source indicators retained as information; no quality bearer supplied"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000059 ;
            owl:someValuesFrom abi:S5P1Specification ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom abi:OperationsCentreSite ],
        [ a owl:Restriction ;
            owl:onProperty abi:documentedBy ;
            owl:someValuesFrom abi:DecisionLogRecord ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S5P1Step3 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S5P1Step1 ],
        [ a owl:Restriction ;
            owl:onProperty abi:usesInformation ;
            owl:someValuesFrom abi:PlanningSystemSoftware ],
        [ a owl:Restriction ;
            owl:onProperty abi:pursuesObjective ;
            owl:someValuesFrom abi:S5P1Objective1 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasExecutionCondition ;
            owl:someValuesFrom abi:S5P1Condition1 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S5P1Step2 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000199 ;
            owl:someValuesFrom abi:S5P1Interval ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:ProgrammeOwnerParticipant ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:PlanningSystemHost ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasIndicatorRecord ;
            owl:someValuesFrom abi:PlanMaturityIndicator ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000055 ;
            owl:someValuesFrom abi:S5P1ExecutionRole ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:S5PlannerParticipant ],
        [ a owl:Restriction ;
            owl:onProperty abi:documentedBy ;
            owl:someValuesFrom abi:ProgrammePlanRecord ],
        abi:LedgerProcess,
        abi:S5Process,
        bfo:BFO_0000015 ;
    skos:altLabel "S5-P1"@en ;
    skos:definition "A proposed ABI programme planning process. Suggested steps: Define objectives → Sequence → Baseline. Draft — simulated ledger hypothesis; not validated with ABI. HOW IT IS values are retained as indicator records; quality bearers remain unresolved."@en .

