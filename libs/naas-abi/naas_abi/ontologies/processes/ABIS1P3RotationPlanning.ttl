@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix abi: <http://ontology.naas.ai/abi/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

abi:S1P3Ontology a owl:Ontology ;
    rdfs:label "S1-P3 · Rotation planning"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceSHA256 "0d2c2c1e42dc3dfcfb1a8661ddba31057e88de911af1bb8f21868ba3096c0763"@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    dct:title "S1-P3 · Rotation planning"@en ;
    rdfs:comment "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    owl:imports abi:ABIProcessLedgerOntology .

abi:S1P3Condition1 a owl:Class ;
    rdfs:label "Rotation planning timing condition"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceValue "Monthly cycle"@en ;
    rdfs:comment "Ledger trigger/cadence/target: Monthly cycle. No occurrence or achieved timing is asserted."@en ;
    rdfs:subClassOf abi:ExecutionCondition ;
    skos:definition "Ledger trigger/cadence/target: Monthly cycle. No occurrence or achieved timing is asserted."@en .

abi:S1P3ExecutionRole a owl:Class ;
    rdfs:label "Rotation planning execution role"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "A proposed role realised in Rotation planning and borne by a listed material participant. The accountable bearer must be confirmed with ABI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( abi:LineManagersParticipant abi:PlanningSystemHost abi:S1LeadParticipant ) ] ],
        abi:ExecutionRole ;
    skos:definition "A proposed role realised in Rotation planning and borne by a listed material participant. The accountable bearer must be confirmed with ABI."@en .

abi:S1P3Interval a owl:Class ;
    rdfs:label "Rotation planning execution interval"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "The temporal region occupied by an execution of Rotation planning; actual dates are unspecified."@en ;
    rdfs:subClassOf abi:ExecutionInterval ;
    skos:definition "The temporal region occupied by an execution of Rotation planning; actual dates are unspecified."@en .

abi:S1P3Objective1 a owl:Class ;
    rdfs:label "Rotation planning objective"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceValue "Continuity of cover for VIP operations"@en ;
    rdfs:comment "Intended outcome: Continuity of cover for VIP operations. This is an objective specification, not a role or a guaranteed result."@en ;
    rdfs:subClassOf abi:ObjectiveSpecification ;
    skos:definition "Intended outcome: Continuity of cover for VIP operations. This is an objective specification, not a role or a guaranteed result."@en .

abi:S1P3Specification a owl:Class ;
    rdfs:label "Rotation planning specification"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "The simulated ledger specification for S1-P3. It describes a possible process, not an executed run."@en ;
    rdfs:subClassOf abi:ProcessSpecification ;
    skos:definition "The simulated ledger specification for S1-P3. It describes a possible process, not an executed run."@en .

abi:S1P3Step1 a owl:Class ;
    rdfs:label "Rotation planning · Forecast needs"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 1 ;
    rdfs:comment "Suggested step 1 of Rotation planning: Forecast needs. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S1P3 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 1 of Rotation planning: Forecast needs. Its ordering is a specification, not observed timing."@en .

abi:S1P3Step2 a owl:Class ;
    rdfs:label "Rotation planning · Draft rota"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 2 ;
    rdfs:comment "Suggested step 2 of Rotation planning: Draft rota. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S1P3 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 2 of Rotation planning: Draft rota. Its ordering is a specification, not observed timing."@en .

abi:S1P3Step3 a owl:Class ;
    rdfs:label "Rotation planning · Publish"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 3 ;
    rdfs:comment "Suggested step 3 of Rotation planning: Publish. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S1P3 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 3 of Rotation planning: Publish. Its ordering is a specification, not observed timing."@en .

abi:S1P3 a owl:Class ;
    rdfs:label "Rotation planning"@en ;
    abi:ledgerCode "S1-P3"@en ;
    abi:ledgerHOWITIS "Coverage ratio"@en ;
    abi:ledgerHOWWEKNOW "Attendance record"@en,
        "Rotation plan"@en ;
    abi:ledgerWHEN "Monthly cycle"@en ;
    abi:ledgerWHERE "Operations centre"@en ;
    abi:ledgerWHO "Line managers"@en,
        "Planning system"@en,
        "S1 lead"@en ;
    abi:ledgerWHY "Continuity of cover for VIP operations"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:qualityMappingStatus "Unresolved — source indicators retained as information; no quality bearer supplied"@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "A proposed ABI rotation planning process. Suggested steps: Forecast needs → Draft rota → Publish. Draft — simulated ledger hypothesis; not validated with ABI. HOW IT IS values are retained as indicator records; quality bearers remain unresolved."@en,
        "Unresolved — source indicators retained as information; no quality bearer supplied"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S1P3Step1 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000055 ;
            owl:someValuesFrom abi:S1P3ExecutionRole ],
        [ a owl:Restriction ;
            owl:onProperty abi:documentedBy ;
            owl:someValuesFrom abi:AttendanceRecordRecord ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000199 ;
            owl:someValuesFrom abi:S1P3Interval ],
        [ a owl:Restriction ;
            owl:onProperty abi:documentedBy ;
            owl:someValuesFrom abi:RotationPlanRecord ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasExecutionCondition ;
            owl:someValuesFrom abi:S1P3Condition1 ],
        [ a owl:Restriction ;
            owl:onProperty abi:pursuesObjective ;
            owl:someValuesFrom abi:S1P3Objective1 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasIndicatorRecord ;
            owl:someValuesFrom abi:CoverageRatioIndicator ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:LineManagersParticipant ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:S1LeadParticipant ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom abi:OperationsCentreSite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:PlanningSystemHost ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S1P3Step3 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000059 ;
            owl:someValuesFrom abi:S1P3Specification ],
        [ a owl:Restriction ;
            owl:onProperty abi:usesInformation ;
            owl:someValuesFrom abi:PlanningSystemSoftware ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S1P3Step2 ],
        abi:LedgerProcess,
        abi:S1Process,
        bfo:BFO_0000015 ;
    skos:altLabel "S1-P3"@en ;
    skos:definition "A proposed ABI rotation planning process. Suggested steps: Forecast needs → Draft rota → Publish. Draft — simulated ledger hypothesis; not validated with ABI. HOW IT IS values are retained as indicator records; quality bearers remain unresolved."@en .

