@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix abi: <http://ontology.naas.ai/abi/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

abi:S6P2Ontology a owl:Ontology ;
    rdfs:label "S6-P2 · Cyber posture (blue/red team)"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceSHA256 "0d2c2c1e42dc3dfcfb1a8661ddba31057e88de911af1bb8f21868ba3096c0763"@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    dct:title "S6-P2 · Cyber posture (blue/red team)"@en ;
    rdfs:comment "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    owl:imports abi:ABIProcessLedgerOntology .

abi:S6P2Condition1 a owl:Class ;
    rdfs:label "Cyber posture (blue/red team) timing condition"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceValue "Continuous; per test cycle"@en ;
    rdfs:comment "Ledger trigger/cadence/target: Continuous; per test cycle. No occurrence or achieved timing is asserted."@en ;
    rdfs:subClassOf abi:ExecutionCondition ;
    skos:definition "Ledger trigger/cadence/target: Continuous; per test cycle. No occurrence or achieved timing is asserted."@en .

abi:S6P2ExecutionRole a owl:Class ;
    rdfs:label "Cyber posture (blue/red team) execution role"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "A proposed role realised in Cyber posture (blue/red team) and borne by a listed material participant. The accountable bearer must be confirmed with ABI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( abi:AINAgentsHost abi:CyberTeamParticipant abi:Infrastructure ) ] ],
        abi:ExecutionRole ;
    skos:definition "A proposed role realised in Cyber posture (blue/red team) and borne by a listed material participant. The accountable bearer must be confirmed with ABI."@en .

abi:S6P2Interval a owl:Class ;
    rdfs:label "Cyber posture (blue/red team) execution interval"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "The temporal region occupied by an execution of Cyber posture (blue/red team); actual dates are unspecified."@en ;
    rdfs:subClassOf abi:ExecutionInterval ;
    skos:definition "The temporal region occupied by an execution of Cyber posture (blue/red team); actual dates are unspecified."@en .

abi:S6P2Objective1 a owl:Class ;
    rdfs:label "Cyber posture (blue/red team) objective"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceValue "A defensible fortress"@en ;
    rdfs:comment "Intended outcome: A defensible fortress. This is an objective specification, not a role or a guaranteed result."@en ;
    rdfs:subClassOf abi:ObjectiveSpecification ;
    skos:definition "Intended outcome: A defensible fortress. This is an objective specification, not a role or a guaranteed result."@en .

abi:S6P2Specification a owl:Class ;
    rdfs:label "Cyber posture (blue/red team) specification"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "The simulated ledger specification for S6-P2. It describes a possible process, not an executed run."@en ;
    rdfs:subClassOf abi:ProcessSpecification ;
    skos:definition "The simulated ledger specification for S6-P2. It describes a possible process, not an executed run."@en .

abi:S6P2Step1 a owl:Class ;
    rdfs:label "Cyber posture (blue/red team) · Attack (red)"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 1 ;
    rdfs:comment "Suggested step 1 of Cyber posture (blue/red team): Attack (red). Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S6P2 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 1 of Cyber posture (blue/red team): Attack (red). Its ordering is a specification, not observed timing."@en .

abi:S6P2Step2 a owl:Class ;
    rdfs:label "Cyber posture (blue/red team) · Defend (blue)"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 2 ;
    rdfs:comment "Suggested step 2 of Cyber posture (blue/red team): Defend (blue). Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S6P2 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 2 of Cyber posture (blue/red team): Defend (blue). Its ordering is a specification, not observed timing."@en .

abi:S6P2Step3 a owl:Class ;
    rdfs:label "Cyber posture (blue/red team) · Remediate"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 3 ;
    rdfs:comment "Suggested step 3 of Cyber posture (blue/red team): Remediate. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S6P2 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 3 of Cyber posture (blue/red team): Remediate. Its ordering is a specification, not observed timing."@en .

abi:S6P2 a owl:Class ;
    rdfs:label "Cyber posture (blue/red team)"@en ;
    abi:ledgerCode "S6-P2"@en ;
    abi:ledgerHOWITIS "Air-gap compliance"@en,
        "Findings severity"@en ;
    abi:ledgerHOWWEKNOW "Penetration report"@en,
        "Remediation log"@en ;
    abi:ledgerWHEN "Continuous; per test cycle"@en ;
    abi:ledgerWHERE "Air-gapped zone"@en,
        "Secure network perimeter"@en ;
    abi:ledgerWHO "AIN agents"@en,
        "Cyber team"@en,
        "Infrastructure"@en ;
    abi:ledgerWHY "A defensible fortress"@en ;
    abi:modelingNote "WHERE 'Secure network perimeter' describes a deployment boundary, not an identified physical site. The occurrence site remains generic pending clarification."@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:qualityMappingStatus "Unresolved — source indicators retained as information; no quality bearer supplied"@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "A proposed ABI cyber posture (blue/red team) process. Suggested steps: Attack (red) → Defend (blue) → Remediate. Draft — simulated ledger hypothesis; not validated with ABI. HOW IT IS values are retained as indicator records; quality bearers remain unresolved."@en,
        "Unresolved — source indicators retained as information; no quality bearer supplied"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000199 ;
            owl:someValuesFrom abi:S6P2Interval ],
        [ a owl:Restriction ;
            owl:onProperty abi:usesInformation ;
            owl:someValuesFrom abi:AINAgentsSoftware ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S6P2Step1 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom abi:ExecutionSite ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:AINAgentsHost ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasExecutionCondition ;
            owl:someValuesFrom abi:S6P2Condition1 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:CyberTeamParticipant ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000055 ;
            owl:someValuesFrom abi:S6P2ExecutionRole ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S6P2Step2 ],
        [ a owl:Restriction ;
            owl:onProperty abi:pursuesObjective ;
            owl:someValuesFrom abi:S6P2Objective1 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasIndicatorRecord ;
            owl:someValuesFrom abi:AirGapComplianceIndicator ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000059 ;
            owl:someValuesFrom abi:S6P2Specification ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasIndicatorRecord ;
            owl:someValuesFrom abi:FindingsSeverityIndicator ],
        [ a owl:Restriction ;
            owl:onProperty abi:documentedBy ;
            owl:someValuesFrom abi:RemediationLogRecord ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S6P2Step3 ],
        [ a owl:Restriction ;
            owl:onProperty abi:documentedBy ;
            owl:someValuesFrom abi:PenetrationReportRecord ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:Infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom abi:AirGappedZoneSite ],
        abi:LedgerProcess,
        abi:S6Process,
        bfo:BFO_0000015 ;
    skos:altLabel "S6-P2"@en ;
    skos:definition "A proposed ABI cyber posture (blue/red team) process. Suggested steps: Attack (red) → Defend (blue) → Remediate. Draft — simulated ledger hypothesis; not validated with ABI. HOW IT IS values are retained as indicator records; quality bearers remain unresolved."@en .

