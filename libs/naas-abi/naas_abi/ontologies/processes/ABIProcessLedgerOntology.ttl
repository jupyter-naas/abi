    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "Recorded information associated with a ledger process, distinct from the physical medium carrying it."@en ;
    rdfs:subClassOf bfo:BFO_0000031 ;
    skos:definition "Recorded information associated with a ledger process, distinct from the physical medium carrying it."@en .

abi:LedgerProcess a owl:Class ;
    rdfs:label "ABI AI System"@en ;
    abi:systemViewKind "system"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "A process type proposed in the simulated ABI ledger. Select a child process to inspect its participants, steps, places, timing, roles and evidence. Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:subClassOf bfo:BFO_0000015 ;
    skos:definition "A process type proposed in the simulated ABI ledger. Select a child process to inspect its participants, steps, places, timing, roles and evidence. Draft — simulated ledger hypothesis; not validated with ABI."@en .

abi:PhysicalTeam a owl:Class ;
    rdfs:label "ABI physical team"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "The aggregate of people performing a team activity, distinct from an organisation's legal identity."@en ;
    rdfs:subClassOf abi:MaterialParticipant,
        bfo:BFO_0000027 ;
    skos:definition "The aggregate of people performing a team activity, distinct from an organisation's legal identity."@en .

abi:ComputingSystem a owl:Class ;
    rdfs:label "ABI physical computing system"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "Physical computing equipment carrying the software used in a ledger process. The ledger names software, not particular machines."@en ;
    rdfs:subClassOf abi:MaterialParticipant ;
    skos:definition "Physical computing equipment carrying the software used in a ledger process. The ledger names software, not particular machines."@en .

abi:Software a owl:Class ;
    rdfs:label "ABI software"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "Software content, distinct from the material computer on which it executes."@en ;
    rdfs:subClassOf abi:InformationArtifact ;
    skos:definition "Software content, distinct from the material computer on which it executes."@en .

abi:HumanParticipant a owl:Class ;
    rdfs:label "ABI human participant"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "A person participating in a proposed ABI process."@en ;
    rdfs:subClassOf abi:MaterialParticipant,
        cco:ont00001262 ;
    skos:definition "A person participating in a proposed ABI process."@en .

abi:EvidenceRecord a owl:Class ;
    rdfs:label "ABI evidence record"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "A kind of record listed in HOW WE KNOW; its existence, production direction and factual accuracy have not been validated."@en ;
    rdfs:subClassOf abi:InformationArtifact ;
    skos:definition "A kind of record listed in HOW WE KNOW; its existence, production direction and factual accuracy have not been validated."@en .

abi:IndicatorRecord a owl:Class ;
    rdfs:label "ABI indicator record"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "Recorded status, score or measure listed under HOW IT IS. This record is not itself a BFO quality."@en ;
    rdfs:subClassOf abi:InformationArtifact ;
    skos:definition "Recorded status, score or measure listed under HOW IT IS. This record is not itself a BFO quality."@en .

