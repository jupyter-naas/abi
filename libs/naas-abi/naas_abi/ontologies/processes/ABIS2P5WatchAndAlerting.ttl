@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix abi: <http://ontology.naas.ai/abi/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

abi:S2P5Ontology a owl:Ontology ;
    rdfs:label "S2-P5 · Watch and alerting"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceSHA256 "0d2c2c1e42dc3dfcfb1a8661ddba31057e88de911af1bb8f21868ba3096c0763"@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    dct:title "S2-P5 · Watch and alerting"@en ;
    rdfs:comment "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    owl:imports abi:ABIProcessLedgerOntology .

abi:S2P5Condition1 a owl:Class ;
    rdfs:label "Watch and alerting timing condition"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceValue "Continuous; < 2 min alert"@en ;
    rdfs:comment "Ledger trigger/cadence/target: Continuous; < 2 min alert. No occurrence or achieved timing is asserted."@en ;
    rdfs:subClassOf abi:ExecutionCondition ;
    skos:definition "Ledger trigger/cadence/target: Continuous; < 2 min alert. No occurrence or achieved timing is asserted."@en .

abi:S2P5ExecutionRole a owl:Class ;
    rdfs:label "Watch and alerting execution role"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "A proposed role realised in Watch and alerting and borne by a listed material participant. The accountable bearer must be confirmed with ABI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( abi:AINGapDetectionAgentHost abi:WatchOfficerParticipant ) ] ],
        abi:ExecutionRole ;
    skos:definition "A proposed role realised in Watch and alerting and borne by a listed material participant. The accountable bearer must be confirmed with ABI."@en .

abi:S2P5Interval a owl:Class ;
    rdfs:label "Watch and alerting execution interval"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "The temporal region occupied by an execution of Watch and alerting; actual dates are unspecified."@en ;
    rdfs:subClassOf abi:ExecutionInterval ;
    skos:definition "The temporal region occupied by an execution of Watch and alerting; actual dates are unspecified."@en .

abi:S2P5Objective1 a owl:Class ;
    rdfs:label "Watch and alerting objective"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceValue "Act inside the decision window"@en ;
    rdfs:comment "Intended outcome: Act inside the decision window. This is an objective specification, not a role or a guaranteed result."@en ;
    rdfs:subClassOf abi:ObjectiveSpecification ;
    skos:definition "Intended outcome: Act inside the decision window. This is an objective specification, not a role or a guaranteed result."@en .

abi:S2P5Specification a owl:Class ;
    rdfs:label "Watch and alerting specification"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "The simulated ledger specification for S2-P5. It describes a possible process, not an executed run."@en ;
    rdfs:subClassOf abi:ProcessSpecification ;
    skos:definition "The simulated ledger specification for S2-P5. It describes a possible process, not an executed run."@en .

abi:S2P5Step1 a owl:Class ;
    rdfs:label "Watch and alerting · Set thresholds"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 1 ;
    rdfs:comment "Suggested step 1 of Watch and alerting: Set thresholds. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S2P5 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 1 of Watch and alerting: Set thresholds. Its ordering is a specification, not observed timing."@en .

abi:S2P5Step2 a owl:Class ;
    rdfs:label "Watch and alerting · Monitor"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 2 ;
    rdfs:comment "Suggested step 2 of Watch and alerting: Monitor. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S2P5 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 2 of Watch and alerting: Monitor. Its ordering is a specification, not observed timing."@en .

abi:S2P5Step3 a owl:Class ;
    rdfs:label "Watch and alerting · Raise alert"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 3 ;
    rdfs:comment "Suggested step 3 of Watch and alerting: Raise alert. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S2P5 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 3 of Watch and alerting: Raise alert. Its ordering is a specification, not observed timing."@en .

abi:S2P5 a owl:Class ;
    rdfs:label "Watch and alerting"@en ;
    abi:ledgerCode "S2-P5"@en ;
    abi:ledgerHOWITIS "Alert latency"@en,
        "False-positive rate"@en ;
    abi:ledgerHOWWEKNOW "Alert feed"@en,
        "Reasoning chain"@en ;
    abi:ledgerWHEN "Continuous; < 2 min alert"@en ;
    abi:ledgerWHERE "Air-gapped zone"@en ;
    abi:ledgerWHO "AIN gap-detection agent"@en,
        "Watch officer"@en ;
    abi:ledgerWHY "Act inside the decision window"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:qualityMappingStatus "Unresolved — source indicators retained as information; no quality bearer supplied"@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "A proposed ABI watch and alerting process. Suggested steps: Set thresholds → Monitor → Raise alert. Draft — simulated ledger hypothesis; not validated with ABI. HOW IT IS values are retained as indicator records; quality bearers remain unresolved."@en,
        "Unresolved — source indicators retained as information; no quality bearer supplied"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty abi:usesInformation ;
            owl:someValuesFrom abi:AINGapDetectionAgentSoftware ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000199 ;
            owl:someValuesFrom abi:S2P5Interval ],
        [ a owl:Restriction ;
            owl:onProperty abi:pursuesObjective ;
            owl:someValuesFrom abi:S2P5Objective1 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000055 ;
            owl:someValuesFrom abi:S2P5ExecutionRole ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S2P5Step1 ],
        [ a owl:Restriction ;
            owl:onProperty abi:documentedBy ;
            owl:someValuesFrom abi:ReasoningChainRecord ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S2P5Step2 ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasIndicatorRecord ;
            owl:someValuesFrom abi:AlertLatencyIndicator ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:WatchOfficerParticipant ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom abi:AirGappedZoneSite ],
        [ a owl:Restriction ;
            owl:onProperty abi:documentedBy ;
            owl:someValuesFrom abi:AlertFeedRecord ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S2P5Step3 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:AINGapDetectionAgentHost ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasIndicatorRecord ;
            owl:someValuesFrom abi:FalsePositiveRateIndicator ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasExecutionCondition ;
            owl:someValuesFrom abi:S2P5Condition1 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000059 ;
            owl:someValuesFrom abi:S2P5Specification ],
        abi:LedgerProcess,
        abi:S2Process,
        bfo:BFO_0000015 ;
    skos:altLabel "S2-P5"@en ;
    skos:definition "A proposed ABI watch and alerting process. Suggested steps: Set thresholds → Monitor → Raise alert. Draft — simulated ledger hypothesis; not validated with ABI. HOW IT IS values are retained as indicator records; quality bearers remain unresolved."@en .

