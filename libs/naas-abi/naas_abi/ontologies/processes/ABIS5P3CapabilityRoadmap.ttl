@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix abi: <http://ontology.naas.ai/abi/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

abi:S5P3Ontology a owl:Ontology ;
    rdfs:label "S5-P3 · Capability roadmap"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceSHA256 "0d2c2c1e42dc3dfcfb1a8661ddba31057e88de911af1bb8f21868ba3096c0763"@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    dct:title "S5-P3 · Capability roadmap"@en ;
    rdfs:comment "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    owl:imports abi:ABIProcessLedgerOntology .

abi:S5P3Condition1 a owl:Class ;
    rdfs:label "Capability roadmap timing condition"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceValue "Annual; on review"@en ;
    rdfs:comment "Ledger trigger/cadence/target: Annual; on review. No occurrence or achieved timing is asserted."@en ;
    rdfs:subClassOf abi:ExecutionCondition ;
    skos:definition "Ledger trigger/cadence/target: Annual; on review. No occurrence or achieved timing is asserted."@en .

abi:S5P3ExecutionRole a owl:Class ;
    rdfs:label "Capability roadmap execution role"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "A proposed role realised in Capability roadmap and borne by a listed material participant. The accountable bearer must be confirmed with ABI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( abi:FunctionLeadsParticipant abi:S5LeadParticipant ) ] ],
        abi:ExecutionRole ;
    skos:definition "A proposed role realised in Capability roadmap and borne by a listed material participant. The accountable bearer must be confirmed with ABI."@en .

abi:S5P3Interval a owl:Class ;
    rdfs:label "Capability roadmap execution interval"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "The temporal region occupied by an execution of Capability roadmap; actual dates are unspecified."@en ;
    rdfs:subClassOf abi:ExecutionInterval ;
    skos:definition "The temporal region occupied by an execution of Capability roadmap; actual dates are unspecified."@en .

abi:S5P3Objective1 a owl:Class ;
    rdfs:label "Capability roadmap objective"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:sourceValue "Capabilities aligned to the North Stars"@en ;
    rdfs:comment "Intended outcome: Capabilities aligned to the North Stars. This is an objective specification, not a role or a guaranteed result."@en ;
    rdfs:subClassOf abi:ObjectiveSpecification ;
    skos:definition "Intended outcome: Capabilities aligned to the North Stars. This is an objective specification, not a role or a guaranteed result."@en .

abi:S5P3Specification a owl:Class ;
    rdfs:label "Capability roadmap specification"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    rdfs:comment "The simulated ledger specification for S5-P3. It describes a possible process, not an executed run."@en ;
    rdfs:subClassOf abi:ProcessSpecification ;
    skos:definition "The simulated ledger specification for S5-P3. It describes a possible process, not an executed run."@en .

abi:S5P3Step1 a owl:Class ;
    rdfs:label "Capability roadmap · Assess gaps"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 1 ;
    rdfs:comment "Suggested step 1 of Capability roadmap: Assess gaps. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S5P3 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 1 of Capability roadmap: Assess gaps. Its ordering is a specification, not observed timing."@en .

abi:S5P3Step2 a owl:Class ;
    rdfs:label "Capability roadmap · Prioritise"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 2 ;
    rdfs:comment "Suggested step 2 of Capability roadmap: Prioritise. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S5P3 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 2 of Capability roadmap: Prioritise. Its ordering is a specification, not observed timing."@en .

abi:S5P3Step3 a owl:Class ;
    rdfs:label "Capability roadmap · Roadmap"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:stepNumber 3 ;
    rdfs:comment "Suggested step 3 of Capability roadmap: Roadmap. Its ordering is a specification, not observed timing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000132 ;
            owl:someValuesFrom abi:S5P3 ],
        abi:ProcessStep,
        bfo:BFO_0000015 ;
    skos:definition "Suggested step 3 of Capability roadmap: Roadmap. Its ordering is a specification, not observed timing."@en .

abi:S5P3 a owl:Class ;
    rdfs:label "Capability roadmap"@en ;
    abi:ledgerCode "S5-P3"@en ;
    abi:ledgerHOWITIS "Gap coverage"@en ;
    abi:ledgerHOWWEKNOW "Gap register"@en,
        "Roadmap document"@en ;
    abi:ledgerWHEN "Annual; on review"@en ;
    abi:ledgerWHERE "Operations centre"@en ;
    abi:ledgerWHO "Function leads"@en,
        "S5 lead"@en ;
    abi:ledgerWHY "Capabilities aligned to the North Stars"@en ;
    abi:modelingStatus "Draft — simulated ledger hypothesis; not validated with ABI."@en ;
    abi:qualityMappingStatus "Unresolved — source indicators retained as information; no quality bearer supplied"@en ;
    dct:source "libs/naas-abi/naas_abi/ontologies/processes/source_ledger.json"@en ;
    rdfs:comment "A proposed ABI capability roadmap process. Suggested steps: Assess gaps → Prioritise → Roadmap. Draft — simulated ledger hypothesis; not validated with ABI. HOW IT IS values are retained as indicator records; quality bearers remain unresolved."@en,
        "Unresolved — source indicators retained as information; no quality bearer supplied"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000066 ;
            owl:someValuesFrom abi:OperationsCentreSite ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasExecutionCondition ;
            owl:someValuesFrom abi:S5P3Condition1 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000059 ;
            owl:someValuesFrom abi:S5P3Specification ],
        [ a owl:Restriction ;
            owl:onProperty abi:hasIndicatorRecord ;
            owl:someValuesFrom abi:GapCoverageIndicator ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000199 ;
            owl:someValuesFrom abi:S5P3Interval ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S5P3Step2 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S5P3Step3 ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000055 ;
            owl:someValuesFrom abi:S5P3ExecutionRole ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:S5LeadParticipant ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000057 ;
            owl:someValuesFrom abi:FunctionLeadsParticipant ],
        [ a owl:Restriction ;
            owl:onProperty abi:pursuesObjective ;
            owl:someValuesFrom abi:S5P3Objective1 ],
        [ a owl:Restriction ;
            owl:onProperty abi:documentedBy ;
            owl:someValuesFrom abi:GapRegisterRecord ],
        [ a owl:Restriction ;
            owl:onProperty bfo:BFO_0000117 ;
            owl:someValuesFrom abi:S5P3Step1 ],
        [ a owl:Restriction ;
            owl:onProperty abi:documentedBy ;
            owl:someValuesFrom abi:RoadmapDocumentRecord ],
        abi:LedgerProcess,
        abi:S5Process,
        bfo:BFO_0000015 ;
    skos:altLabel "S5-P3"@en ;
    skos:definition "A proposed ABI capability roadmap process. Suggested steps: Assess gaps → Prioritise → Roadmap. Draft — simulated ledger hypothesis; not validated with ABI. HOW IT IS values are retained as indicator records; quality bearers remain unresolved."@en .

