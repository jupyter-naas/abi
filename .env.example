# Safe placeholders for secrets still referenced by root config.yaml.
# Copy to `.env` if first boot did not seed them (`.env` is gitignored).
# Real keys are only needed for deploy / cloud providers / opt-in modules.

NAAS_API_KEY=placeholder
ABI_API_KEY=placeholder
NEXUS_API_URL=http://127.0.0.1:9879

# There is no admin password: `admin@example.com` (config `users:`) signs in at the
# built-in identity provider with the code it emails (`abi dev code` prints it).

# NATS (the `nats:` block of config.yaml and config.local.yaml). Generated into
# .env by `abi dev up` and `abi stack start` on first run; set them yourself
# only to run the engine against a broker you started by other means.
# NATS_ENGINE_PASSWORD=       the engine's broker user (`engine`), at least 16 characters
# NATS_AUTH_PASSWORD=         the engine's auth callout responder (`auth`)
# NATS_AUTH_CALLOUT_SEED=     the account seed the callout signs admitted modules with
# NATS_AUTH_CALLOUT_ISSUER=   its public key, which nats.conf trusts
# Modules log in with their own service key (`abi iam module approve`), not a broker password.

# Legacy RabbitMQ bus (`abi stack start --legacy`), generated when missing.
# RABBITMQ_USER=abi
# RABBITMQ_PASSWORD=

# Optional: override Ollama endpoint (auto-detected by default).
# ABI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_HOST=127.0.0.1:11434

# Cloud / integration modules are commented out in config.yaml. When you
# uncomment one, add its key here and replace SECRET_REF in config with
# {{ secret.NAME }} (never leave {{ secret.X }} inside YAML comments).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_ACCESS_TOKEN=
# X_BEARER_TOKEN=
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# TFL_APP_KEY=
# OPENWEBCAMDB_API_KEY=
